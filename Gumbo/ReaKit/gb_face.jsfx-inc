// Copyright (c) 2026 EON Studios (Quaz). All rights reserved. Free to use: see Gumbo_LICENSE.md.
// gb_face.jsfx-inc -- Gumbo's face: the full layout of the approved mockup (.docs/specs/mockups/Gumbo_SFZ_Player_mockup.html)
// and the mixer-strip face, on the ReaKit library the way the free effects are (Saturation_ReaKit.jsfx is the model):
// knobs_kbsg (ssl_knob_interact + rk_knob_draw in the theme's knob style), rk_piano (the keyboard; every held note lit
// over it), rk_theme (colours, the THEME cluster, NATIVE, NAME BAR), rk_srf (one face in the track panel AND the
// mixer), meters_kbsg (the peaks the display's OUT meter reads).
//   * top bar: GUMBO, the instrument with its family and arrows to step through the family, voices, memory, THEME
//   * left: the browser -- family tiles with the EON track icons, the family's instruments (the library index
//     Data/EON_Gumbo/starter.txt + pack1..9.txt from the sound packages + Data/EON_Gumbo/library.txt, the user's),
//     click to load
//   * the display (an Ember screen in every theme, like hardware): the instrument, the last note's waveform, the keys
//     that have recordings, the loudness layers of the last note, the output
//   * seven knobs: TONE DRIVE ATTACK RELEASE GLIDE WIDTH VOLUME (GLIDE dimmed until built; PUNCH folded into ATTACK
//     and SPACE hidden until the new reverb, the owner 2026-10-30); then the keyboard (play it with the mouse),
//     recorded keys dotted above it
// Not drawn until built (the owner, 2026-10-30: "Hidden until built"): Layer B, the effects chain, the sequencer, tabs.
// Reads the loader and voices (gb_job, gb_js, gb_nsmp, gb_nreg, gb_ready, GB_NTA, gb_cc0, gb_last_*); writes gb_kb_note.

@init
GBF_KS = 16; GBF_NK = 9;             // knob memory; TONE DRIVE PUNCH ATTACK RELEASE GLIDE SPACE WIDTH VOLUME
GBF_NKV = 8;                         // SOUND page knobs (gb_face_p2): PAN took PUNCH's slot, SPACE's stays unused
GBF_KM_BASE = 1720000;               // 9 x 16 cells, clear of gb_sfz's tables (GB_FN = 1700000 .. 1700872)
gbf_km = GBF_KM_BASE;
memset(gbf_km, 0, GBF_KS * GBF_NK);
GBF_IDX_BASE = 1764000; GBF_IS = 6; GBF_IMAX = 512;   // the index: family, MB, name ptr, name len, path ptr, path len
GBF_ICH_BASE = 1770000; GBF_ICH_CAP = 220000;          // the index's characters (ends 1990000, under GB_AUD)
GBF_NFAM = 12;
GBF_ICON_SLOT = 40;                  // gfx image slots 40..51 hold the family icons
GBF_REC = 1740000;                   // 128: does a recording have its root on this key (rebuilt per load)
GBF_LAY = 1740200;                   // 16: the last note's loudness bands (lo, hi pairs)
GBF_FAV = 1742000;                   // 512: is index entry i a favourite (Data/EON_Gumbo/favourites.txt, per index load)
GBF_MATCH = 1742600;                 // 512: does entry i match the search (rebuilt when the search or the index changes)
gbf_q_gen = 0; gbf_q_built = -1; gbf_favonly = 0; #gbf_q = "";
GBF_KST = 1740300;                   // 128: each key's fixed state for rk_piano_draw_ex (playable, keyswitch; per load)
GBF_KSF = 1740500;                   // 128: the same plus held / active keyswitch, rebuilt every frame
gbf_rec_gen = -1;                    // (gb_last_* belong to gb_voice, which sets them up)
gbf_lo = 36; gbf_hi = 96; gbf_range_gen = -1;
gbf_cat = -1; gbf_scroll = 0; gbf_idx_n = 0; gbf_idx_loaded = 0; gbf_icons_loaded = 0; gbf_win_t = 0;
gbf_cur = -1; gbf_cur_for = -1;    // the index entry that is loaded (cached per load)

function gbf_fam_name(i) (
  i == 0 ? "Drums" : i == 1 ? "808s" : i == 2 ? "Bass" : i == 3 ? "Keys" : i == 4 ? "E-Piano" : i == 5 ? "Pads"
  : i == 6 ? "Leads" : i == 7 ? "Strings" : i == 8 ? "Brass" : i == 9 ? "Winds" : i == 10 ? "Plucks" : i == 11 ? "Vox"
  : "Other";   // 12: what the list's family guess could not place -- under ALL INSTRUMENTS only, no tile
);
// the free EON track icons (all in the ReaKit FX icon set)
function gbf_fam_icon(i) (
  i == 0 ? "drum_kit" : i == 1 ? "kick" : i == 2 ? "bass" : i == 3 ? "piano" : i == 4 ? "electric_piano" : i == 5 ? "synth_pad"
  : i == 6 ? "synth_lead" : i == 7 ? "strings" : i == 8 ? "brass" : i == 9 ? "saxophone" : i == 10 ? "guitar" : "choir";
);
function gbf_fam_col(i) (   // a family colour, as in the mockup's tiles
  i <= 2 ? ( gbf_fc_r = 1.00; gbf_fc_g = 0.48; gbf_fc_b = 0.24; ) : i <= 4 ? ( gbf_fc_r = 0.30; gbf_fc_g = 0.50; gbf_fc_b = 0.91; )
  : i == 5 ? ( gbf_fc_r = 0.48; gbf_fc_g = 0.42; gbf_fc_b = 0.88; ) : i == 6 ? ( gbf_fc_r = 0.76; gbf_fc_g = 0.36; gbf_fc_b = 0.88; )
  : i == 7 ? ( gbf_fc_r = 0.88; gbf_fc_g = 0.69; gbf_fc_b = 0.19; ) : i == 8 ? ( gbf_fc_r = 0.88; gbf_fc_g = 0.40; gbf_fc_b = 0.23; )
  : i == 9 ? ( gbf_fc_r = 0.25; gbf_fc_g = 0.75; gbf_fc_b = 0.38; ) : i == 10 ? ( gbf_fc_r = 0.18; gbf_fc_g = 0.72; gbf_fc_b = 0.79; )
  : i == 11 ? ( gbf_fc_r = 0.91; gbf_fc_g = 0.28; gbf_fc_b = 0.60; )
  : ( gbf_fc_r = 0.80; gbf_fc_g = 0.76; gbf_fc_b = 0.70; );   // 12 Other (a GM bank): a plain key colour, not Vox's pink
);

// the family icons: Gumbo's own copies (EON_Gumbo/gumbo_icons, in the Gumbo package itself since 2026-11-04, when the
// VSCO sounds moved to their own repository), else the copies the 1.0 starter sound package installed
// (EON_Gumbo/icons), else the EON track icons (the ReaKit FX track icons package), else none
function gbf_icons_load() local(i) (
  i = 0;
  loop(GBF_NFAM,
    sprintf(#gbf_tmp, "EON_Gumbo/gumbo_icons/%s.png", gbf_fam_icon(i));
    gfx_loadimg(GBF_ICON_SLOT + i, #gbf_tmp) < 0 ? (
      sprintf(#gbf_tmp, "EON_Gumbo/icons/%s.png", gbf_fam_icon(i));
      gfx_loadimg(GBF_ICON_SLOT + i, #gbf_tmp) < 0 ? (
        sprintf(#gbf_tmp, "track_icons/EON/%s.png", gbf_fam_icon(i)); gfx_loadimg(GBF_ICON_SLOT + i, #gbf_tmp); );
    );
    i += 1;
  );
  gbf_icons_loaded = 1;
);

// ── the library index: one line per instrument, "family|name|MB|regions|path" ──
function gbf_idx_field(a, b) local(i) ( #gbf_fld = ""; i = a; loop(b - a, sprintf(#gbf_ch, "%c", str_getchar(#gbf_ln, i)); strcat(#gbf_fld, #gbf_ch); i += 1; ); );
function gbf_idx_line() local(n, i, c, cuts, p0, p1, p2, p3, e, f, k, top) (
  n = strlen(#gbf_ln);
  n > 0 && str_getchar(#gbf_ln, n - 1) == 10 ? n -= 1;
  n > 0 && str_getchar(#gbf_ln, n - 1) == 13 ? n -= 1;
  cuts = 0; i = 0;
  while (i < n && cuts < 4) ( str_getchar(#gbf_ln, i) == '|' ? ( cuts == 0 ? p0 = i : cuts == 1 ? p1 = i : cuts == 2 ? p2 = i : p3 = i; cuts += 1; ); i += 1; );
  cuts == 4 && gbf_idx_n < GBF_IMAX && gbf_ich_top + n < GBF_ICH_CAP ? (
    gbf_idx_field(0, p0); f = -1; k = 0;
    loop(GBF_NFAM + 1, f < 0 && stricmp(#gbf_fld, gbf_fam_name(k)) == 0 ? f = k; k += 1; );   // the tiles + Other
    f >= 0 ? (
      e = GBF_IDX_BASE + gbf_idx_n * GBF_IS;
      e[0] = f;
      gbf_idx_field(p1 + 1, p2); e[1] = 0; match("%f", #gbf_fld, e[1]);
      top = GBF_ICH_BASE + gbf_ich_top;
      e[2] = gbf_ich_top; e[3] = p1 - p0 - 1;
      i = 0; loop(e[3], top[i] = str_getchar(#gbf_ln, p0 + 1 + i); i += 1; );
      gbf_ich_top += e[3]; top = GBF_ICH_BASE + gbf_ich_top;
      e[4] = gbf_ich_top; e[5] = n - p3 - 1;
      i = 0; loop(e[5], top[i] = str_getchar(#gbf_ln, p3 + 1 + i); i += 1; );
      gbf_ich_top += e[5];
      gbf_idx_n += 1;
    );
  );
);
function gbf_idx_read(path) local(h, k) (
  h = file_open(path);
  h >= 0 ? (
    file_text(h) ? ( k = 0; while (file_avail(h) > 0 && k < 4096) ( file_string(h, #gbf_ln); gbf_idx_line(); k += 1; ); );
    file_close(h);
  );
);
// the lists, all under REAPER's Data folder: the sound packages' own (starter.txt = the free starter that comes with
// Gumbo; pack1.txt .. pack9.txt = the extra downloads, one slot each, assigned in gumbo_index.lua's header -- each
// written only by its package, so installing or updating one never touches another or the user's imports), then the
// user's (library.txt -- the helper, Add a library, the dev builder). Paths may be relative to Data (the packages'
// are: they work anywhere). A list that is not there is skipped.
// a before b? family (tile order, Other last), then the name with case ignored, then the path -- the order
// gumbo_index.lua's X.build gives one list, so the lists read together sort as one
function gbf_idx_cmp_str(pa, na, pb, nb) local(i, ca, cb, d) (
  d = 0; i = 0;
  while (d == 0 && i < min(na, nb)) (
    ca = pa[i]; cb = pb[i]; ca >= 65 && ca <= 90 ? ca += 32; cb >= 65 && cb <= 90 ? cb += 32;
    d = ca - cb; i += 1;
  );
  d == 0 ? na - nb : d;
);
function gbf_idx_less(a, b) local(d) (
  d = a[0] - b[0];
  d == 0 ? d = gbf_idx_cmp_str(GBF_ICH_BASE + a[2], a[3], GBF_ICH_BASE + b[2], b[3]);
  d == 0 ? d = gbf_idx_cmp_str(GBF_ICH_BASE + a[4], a[5], GBF_ICH_BASE + b[4], b[5]);
  d < 0;
);
// insertion sort of the entries in place (at most GBF_IMAX; run once per load of the lists)
function gbf_idx_sort() local(i, j, k, t, a) (
  t = GBF_IDX_BASE + GBF_IMAX * GBF_IS;            // one spare record past the table
  i = 1;
  while (i < gbf_idx_n) (
    a = GBF_IDX_BASE + i * GBF_IS; k = 0; loop(GBF_IS, t[k] = a[k]; k += 1; );
    j = i - 1;
    while (j >= 0 && gbf_idx_less(t, GBF_IDX_BASE + j * GBF_IS)) (
      k = 0; loop(GBF_IS, (GBF_IDX_BASE + (j + 1) * GBF_IS)[k] = (GBF_IDX_BASE + j * GBF_IS)[k]; k += 1; );
      j -= 1;
    );
    a = GBF_IDX_BASE + (j + 1) * GBF_IS; k = 0; loop(GBF_IS, a[k] = t[k]; k += 1; );
    i += 1;
  );
);
// is entry e's path the line in #gbf_ln (n bytes), any case
function gbf_fav_same(e, n) local(p, k, a, b, ok) (
  ok = e[5] == n; p = GBF_ICH_BASE + e[4]; k = 0;
  while (ok && k < n) (
    a = p[k]; b = str_getchar(#gbf_ln, k, 'cu');
    a >= 65 && a <= 90 ? a += 32; b >= 65 && b <= 90 ? b += 32;
    a != b ? ok = 0; k += 1;
  );
  ok;
);
// the favourites: one instrument path a line, as the browser lists write it (the Gumbo helper keeps the file)
function gbf_fav_load() local(h, k, n, i) (
  memset(GBF_FAV, 0, GBF_IMAX);
  h = file_open("EON_Gumbo/favourites.txt");
  h >= 0 ? (
    file_text(h) ? (
      k = 0;
      while (file_avail(h) > 0 && k < 4096) (
        file_string(h, #gbf_ln); n = strlen(#gbf_ln);
        while (n > 0 && (str_getchar(#gbf_ln, n - 1) == 10 || str_getchar(#gbf_ln, n - 1) == 13)) ( n -= 1; str_setlen(#gbf_ln, n); );
        // (the path compared byte by byte, any case: gbf_idx_str is defined further down)
        n > 0 ? ( i = 0; loop(gbf_idx_n, gbf_fav_same(GBF_IDX_BASE + i * GBF_IS, n) ? GBF_FAV[i] = 1; i += 1; ); );
        k += 1;
      );
    );
    file_close(h);
  );
);
function gbf_idx_load() local(k) (
  gbf_idx_n = 0; gbf_ich_top = 0;
  gbf_idx_read("EON_Gumbo/starter.txt");
  k = 1; loop(9, sprintf(#gbf_lp, "EON_Gumbo/pack%d.txt", k); gbf_idx_read(#gbf_lp); k += 1; );
  gbf_idx_read("EON_Gumbo/library.txt");
  gbf_idx_sort();
  gbf_cur_for = -1;                                 // the entries moved: find the loaded one again
  gbf_fav_load(); gbf_q_gen += 1;                   // the stars and the search follow the new entries
  gbf_idx_loaded = 1;
);
function gbf_idx_str(e, which) local(p, n, i) (   // which 0 = name, 1 = path -> #gbf_es
  p = GBF_ICH_BASE + e[which ? 4 : 2]; n = e[which ? 5 : 3]; #gbf_es = "";
  i = 0; loop(n, sprintf(#gbf_ch, "%c", p[i]); strcat(#gbf_es, #gbf_ch); i += 1; );
);
// the index entry whose path is the loaded instrument, or -1
function gbf_idx_current() local(i, e, r) (
  r = -1; i = 0;
  while (r < 0 && i < gbf_idx_n) ( e = GBF_IDX_BASE + i * GBF_IS; gbf_idx_str(e, 1); stricmp(#gbf_es, #gb_want) == 0 ? r = i; i += 1; );
  r;
);
function gbf_idx_current_cached() (
  gbf_cur_for != gb_load_gen + strlen(#gb_want) * 1000 ? ( gbf_cur = gbf_idx_current(); gbf_cur_for = gb_load_gen + strlen(#gb_want) * 1000; );
  gbf_cur;
);
// (the loader is shared with @serialize on another thread: a click while it is busy there is ignored)
function gbf_load_entry(i) local(e) (
  i >= 0 && i < gbf_idx_n && gb_lock_try() ? (
    gbh_err = 0;
    e = GBF_IDX_BASE + i * GBF_IS; gbf_idx_str(e, 1); strcpy(#gb_want, #gbf_es); gb_job_start(#gb_want); gbf_cur = i; gbf_cur_for = -1;
    gb_unlock();
  );
);

// colours: the suite theme when live for this instance, else Gumbo's own; the display is always the Ember screen
function gbf_colours() (
  gbf_th = rkth_active();
  gbf_th ? (
    gbf_bg_r = gmem[GS_THEME_BASE];      gbf_bg_g = gmem[GS_THEME_BASE + 1];  gbf_bg_b = gmem[GS_THEME_BASE + 2];
    gbf_pn_r = gmem[GS_THEME_BASE + 3];  gbf_pn_g = gmem[GS_THEME_BASE + 4];  gbf_pn_b = gmem[GS_THEME_BASE + 5];
    gbf_tx_r = gmem[GS_THEME_BASE + 6];  gbf_tx_g = gmem[GS_THEME_BASE + 7];  gbf_tx_b = gmem[GS_THEME_BASE + 8];
    gbf_td_r = gmem[GS_THEME_BASE + 9];  gbf_td_g = gmem[GS_THEME_BASE + 10]; gbf_td_b = gmem[GS_THEME_BASE + 11];
    gbf_ac_r = gmem[GS_THEME_BASE + 12]; gbf_ac_g = gmem[GS_THEME_BASE + 13]; gbf_ac_b = gmem[GS_THEME_BASE + 14];
    gbf_bd_r = gmem[GS_THEME_BASE + 21]; gbf_bd_g = gmem[GS_THEME_BASE + 22]; gbf_bd_b = gmem[GS_THEME_BASE + 23];
  ) : (
    gbf_bg_r = 0.13; gbf_bg_g = 0.15; gbf_bg_b = 0.17;
    gbf_pn_r = 0.16; gbf_pn_g = 0.18; gbf_pn_b = 0.21;
    gbf_tx_r = 0.91; gbf_tx_g = 0.92; gbf_tx_b = 0.94;
    gbf_td_r = 0.55; gbf_td_g = 0.58; gbf_td_b = 0.62;
    gbf_ac_r = 1.00; gbf_ac_g = 0.48; gbf_ac_b = 0.24;
    gbf_bd_r = 0.07; gbf_bd_g = 0.07; gbf_bd_b = 0.09;
  );
  gbf_kp = (gbf_th && gmem[GS_THEME_KNOB_P] > 0) ? (gmem[GS_THEME_KNOB_P] | 0) : 1;
);
// the voices sounding now (gb_vhi is only the highest slot in use, which overstates it after stealing)
function gbf_voices() local(i, c) ( c = 0; i = 0; loop(GB_MAXV, GB_VOI[i * GB_VS + GBV_ON] ? c += 1; i += 1; ); c; );
// text in the face's TYPEFACE and TEXT SIZE (slider86 / slider87, the OPTIONS sheet; rk_textopts), slot 1 as before
function gbf_font(sz, fl) ( gfx_setfont(1, rk_font_fname(slider86), max(7, floor(sz * gbf_tk)), fl); );
// gbf_font at sz, smaller until txt fits maxw (never under 7 px); leaves gbf_tw / gbf_th_ measured
function gbf_fit(txt, maxw, sz, fl) local(z) (
  z = max(7, floor(sz * gbf_tk));
  gfx_setfont(1, rk_font_fname(slider86), z, fl); gfx_measurestr(txt, gbf_tw, gbf_th_);
  while (gbf_tw > maxw && z > 7) ( z -= 1; gfx_setfont(1, rk_font_fname(slider86), z, fl); gfx_measurestr(txt, gbf_tw, gbf_th_); );
);
// a colour on the screen, through its look (slider88: Ember as drawn, LCD, Theme; rk_scr_look is set each pass)
function gbf_scr(r, g, b, a) ( rk_scr_set(r, g, b, a); );
function gbf_box(x, y, w, h) ( gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1); gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h); );
function gbf_hit(x, y, w, h) ( mx >= x && mx < x + w && my >= y && my < y + h; );

// ── the face follows the instrument channel 1 plays (2026-11-05): a bank's program, else the whole file. gbf_pgk
// changes with each load and each program change (gbf_prog_sync); the keyboard's range, the lit keys, the
// recorded-notes dots, the key names and the pads are rebuilt from that program's regions when it does. They used to be
// built once per load from every region in the file: a GM set's Standard kit showed 84 pads, 23 of them other kits'
// keys -- silent (the owner, 2026-11-05).
gbf_pgk = -1;
function gbf_in_prog(r) ( r[GBR_PSEC] == 0 || (r[GBR_PSEC] == gbf_pg_sec && gbf_pg_p >= r[GBR_PLO] && gbf_pg_p <= r[GBR_PHI]); );
// the keyboard: the playing instrument's lowest to highest playable key, whole octaves, two at least
function gbf_range() local(i, r, lo, hi) (
  gb_ready && gbf_range_gen != gbf_pgk ? (
    gbf_range_gen = gbf_pgk; lo = 127; hi = 0; i = 0;
    loop(gb_nreg,
      r = GB_REG + i * GB_RS;
      gbf_in_prog(r) ? (
        r[GBR_TRIG] == GB_TR_ATTACK && r[GBR_HIKEY] >= r[GBR_LOKEY] ? ( lo = min(lo, r[GBR_LOKEY]); hi = max(hi, r[GBR_HIKEY]); );
        r[GBR_SWLO] >= 0 && r[GBR_SWHI] >= r[GBR_SWLO] ? ( lo = min(lo, r[GBR_SWLO]); hi = max(hi, r[GBR_SWHI]); );   // the keyswitches show
      );
      i += 1;
    );
    hi < lo ? ( lo = 36; hi = 96; );
    // a drum kit with named keys (an ordinary kit, or a bank's kit playing): just its keys (ends on white keys), so
    // each key is wide enough for its name; anything else: whole octaves
    gbf_nkn > 0 && (gb_nprg == 0 || gbf_pg_kit) ? ( lo = max(0, lo - rk_piano_is_black(lo)); hi = min(127, hi + rk_piano_is_black(hi)); )
                : ( lo = max(21, floor(lo / 12) * 12); hi = min(108, floor(hi / 12) * 12 + 11); );
    hi - lo < 23 ? hi = min(127, lo + 23);
    gbf_lo = lo; gbf_hi = hi;
  );
);

// the x centre of note n on a keyboard drawn over [x, x+w) for [lo, hi]
function gbf_key_x(x, w, lo, hi, n) local(wsz) (
  wsz = w / rk_piano_white_count(lo, hi);
  rk_piano_is_black(n) ? x + rk_piano_whites_before(lo, n) * wsz : x + (rk_piano_whites_before(lo, n) + 0.5) * wsz;
);
// the instrument's name: the browser list's friendly one when the loaded file is in it ("Upright Piano"), else
// the file's own name without its ending
function gbf_name() local(i, n) (
  gbf_idx_loaded && (i = gbf_idx_current_cached()) >= 0 ? (
    gbf_idx_str(GBF_IDX_BASE + i * GBF_IS, 0); strcpy(#gbf_name, #gbf_es);
  ) : (
  n = strlen(#gb_want); i = n;
  while (i > 0 && str_getchar(#gb_want, i - 1) != '/' && str_getchar(#gb_want, i - 1) != 92) ( i -= 1; );
  strcpy_substr(#gbf_name, #gb_want, i);
  n = strlen(#gbf_name);
  n > 10 && stricmp(strcpy_substr(#gbf_tmp, #gbf_name, n - 10), ".gumbo.txt") == 0 ? strncpy(#gbf_name, #gbf_name, n - 10)
  : n > 4 && stricmp(strcpy_substr(#gbf_tmp, #gbf_name, n - 4), ".txt") == 0 ? strncpy(#gbf_name, #gbf_name, n - 4);
  );
);
function gbf_status() (
  gbf_warn = 0; gbf_st_size = 0;
  // the Gumbo helper first: an import on its way, or why a dropped .sfz did not open
  gbh_state != GBH_ST_IDLE ? strcpy(#gbf_st, gbh_kind == GBH_KIND_FAV ? "Saving your favourites..." : "Importing... (the Gumbo helper converts it)")
  : gbh_err ? (
    gbf_warn = 1;
    gbh_err == 1 ? strcpy(#gbf_st, "To open a .sfz or a SoundFont, start the Gumbo helper (Actions: Gumbo helper)")
    : gbh_err == 2 ? strcpy(#gbf_st, "The Gumbo helper stopped before the import was done")
    : gbh_err == 3 ? strcpy(#gbf_st, "That file's path is too long to send to the helper")
    : gbh_err == 7 ? strcpy(#gbf_st, "To dock Gumbo with a double-click, start the Gumbo helper")
    : gbh_err == 5 ? strcpy(#gbf_st, "Starred for now. To keep favourites, start the Gumbo helper")
    : gbh_err == 6 ? strcpy(#gbf_st, "The Gumbo helper could not save your favourites")
    : gbh_err == 8 ? strcpy(#gbf_st, "Pad look set for now. To keep pad looks, start the Gumbo helper")
    : gbh_err == 9 ? strcpy(#gbf_st, "The Gumbo helper could not save the pad look")
    : gbh_err == 4 ? strcpy(#gbf_st, "Pad look set for now: this instrument is not in the library list, so it cannot be kept")
    : gbh_err == 15 ? strcpy(#gbf_st, "To keep a default look for new Gumbos, start the Gumbo helper")
    : gbh_err == 16 ? strcpy(#gbf_st, "The Gumbo helper could not keep the default look")
    : gbh_err == 31 ? strcpy(#gbf_st, "Could not import: its sound files are missing")
    : gbh_err == 32 ? strcpy(#gbf_st, "Could not import: the file (or one it includes) could not be read")
    : gbh_err == 33 ? strcpy(#gbf_st, "Could not import: nothing in it Gumbo can play")
    : gbh_err == 34 ? strcpy(#gbf_st, "Could not import: its sound files are not WAV / FLAC or are damaged")
    : gbh_err == 13 ? strcpy(#gbf_st, "The Gumbo helper could not convert that file")
    : gbh_err == 14 ? strcpy(#gbf_st, "Converted, but Gumbo's browser list could not be written")
    : strcpy(#gbf_st, "The Gumbo helper refused that file");
  )
  : gb_job == GB_J_PARSE ? sprintf(#gbf_st, "Reading the instrument... %d regions", gb_nreg)
  : gb_job == GB_J_SAMPLES ? sprintf(#gbf_st, "Loading sounds... %d of %d", gb_js, gb_nsmp)
  : gb_job == GB_J_FAILED ? (
    gbf_warn = 1;
    gb_err == GB_E_OPEN ? strcpy(#gbf_st, "Can't open that file")
    : gb_err == GB_E_NOTTEXT ? strcpy(#gbf_st, "That file isn't a Gumbo instrument")
    : gb_err == GB_E_FORMAT ? strcpy(#gbf_st, "Not a Gumbo instrument file")
    : strcpy(#gbf_st, "No playable sounds in that file");
  )
  : gb_ready ? ( gbf_st_size = 1;
                 sprintf(#gbf_st, gb_pack ? "%d regions  -  %d sounds  -  %.0f MB (packed)" : "%d regions  -  %d sounds  -  %.0f MB",
                         gb_nreg, gb_nsmp, gb_loaded_cells * 8 / 1048576); )
  : strlen(#gb_want) ? strcpy(#gbf_st, "Not loaded")
  : gbf_idx_loaded && gbf_idx_n == 0 ? strcpy(#gbf_st, "No sounds installed - get 'Gumbo GM sounds' in ReaPack")
  : strcpy(#gbf_st, "Pick an instrument, or drop a .gumbo.txt");
);

// the size line (gbf_st_size) made to fit mw in the font set now: tighter, then without the regions, then the size
// alone (the owner's pictures, 2026-11-06: "821" cut, its "MB" lost, in a wide typeface)
function gbf_st_fit(mw) local(mb) (
  gbf_st_size ? (
    mb = gb_loaded_cells * 8 / 1048576;
    gfx_measurestr(#gbf_st, gbf_tw, gbf_th_);
    gbf_tw > mw ? ( sprintf(#gbf_st, gb_pack ? "%d regions - %d sounds - %.0f MB packed" : "%d regions - %d sounds - %.0f MB",
                            gb_nreg, gb_nsmp, mb); gfx_measurestr(#gbf_st, gbf_tw, gbf_th_); );
    gbf_tw > mw ? ( sprintf(#gbf_st, gb_pack ? "%d sounds - %.0f MB packed" : "%d sounds - %.0f MB", gb_nsmp, mb);
                    gfx_measurestr(#gbf_st, gbf_tw, gbf_th_); );
    gbf_tw > mw ? sprintf(#gbf_st, gb_pack ? "%.0f MB packed" : "%.0f MB", mb);
  );
);

// one knob in colour cr, cg, cb (the EQ's band knobs wear their node's colour); dim = drawn faded with "soon", no input
// a knob in the colour already in sk_kbr/g/b (gbf_knob: the theme's role colour; gbf_knob_c: its own colour)
function gbf_knob_raw(k, cx, cy, r, val, vmin, vmax, vdef, ndet, label, valtxt, dim) local(m, nv, lh) (
  m = gbf_km + k * GBF_KS;
  nv = (gbf_kb_drag || dim || gbf_menu_block) ? val : ssl_knob_interact(m, cx, cy, r, val, vmin, vmax, vdef, ndet);
  rk_knob_draw(gbf_kp, cx, cy, r, nv, vmin, vmax, vmin < 0 && vmax > 0, dim ? 0 : m[0], sk_kbr, sk_kbg, sk_kbb, 11, gbf_bg_r, gbf_bg_g, gbf_bg_b);
  dim ? ( gfx_set(gbf_bg_r, gbf_bg_g, gbf_bg_b, 0.62); gfx_circle(cx, cy, r * 1.45, 1); );
  gbf_fit(label, r * 3.1, gbf_lf, 'b'); dim ? gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 1) : gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, 1);
  lh = gbf_th_; gfx_x = cx - gbf_tw / 2; gfx_y = cy + r * 1.45; gfx_drawstr(label);
  gbf_fit(dim ? "soon" : valtxt, r * 3.1, gbf_vf, 0); gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 1);
  gfx_x = cx - gbf_tw / 2; gfx_y = cy + r * 1.45 + lh + 1 * gbf_s;
  gfx_drawstr(dim ? "soon" : valtxt);
  nv;
);
// a knob in its OWN colour (the EQ bands', matching their nodes), whatever theme is on: an EON theme's knob colour
// (rk_role_col) would paint every band knob the same (the owner, 2026-11-01: "the eq knobs dont match the colors")
function gbf_knob_c(k, cx, cy, r, val, vmin, vmax, vdef, ndet, label, valtxt, dim, cr, cg, cb) (
  sk_kbr = cr; sk_kbg = cg; sk_kbb = cb;
  gbf_knob_raw(k, cx, cy, r, val, vmin, vmax, vdef, ndet, label, valtxt, dim);
);
// one knob in the theme's knob colour (else the accent)
function gbf_knob(k, cx, cy, r, val, vmin, vmax, vdef, ndet, label, valtxt, dim) (
  rk_role_col(0, 1, gbf_ac_r, gbf_ac_g, gbf_ac_b);
  gbf_knob_raw(k, cx, cy, r, val, vmin, vmax, vdef, ndet, label, valtxt, dim);
);

// ── the Ember display ──
// a bank (format 3): the program channel 1 plays now (GB_CHSC + GB_CHPG, written by the audio thread; read only
// here) -> gbf_pg_i = its entry in GB_PRG (-1 = not in this bank), gbf_pg_p = its program number, gbf_pg_kit = a
// drum kit, gbf_pg_sec = its section
function gbf_prog_cur() local(i, q) (
  gbf_pg_sec = GB_CHSC[0]; gbf_pg_p = GB_CHPG[0];
  gbf_pg_kit = gbf_pg_sec == gb_drum_sec && gb_drum_sec > 0;
  gbf_pg_i = -1; i = 0;
  loop(gb_nprg, q = GB_PRG + i * 5; gbf_pg_i < 0 && q[0] == gbf_pg_sec && gbf_pg_p >= q[1] && gbf_pg_p <= q[2] ? gbf_pg_i = i; i += 1; );
);
// entry i's MIDI bank (a variation's; 0 for the main programs and the kits, and for a section no "// bank" line names)
function gbf_pg_bank(i) local(s) (
  s = (GB_PRG + i * 5)[0];
  s == gb_drum_sec && gb_drum_sec > 0 ? 0 : s > 0 && s < GB_SECB_N && GB_SECB[s] > 0 ? GB_SECB[s] : 0;
);
// a bank's programs by GM group (the menu's groups, the side list's labels): 0..15 by program number, 16 the kits
function gbf_gm_fam(g) (
  g == 0 ? "Piano" : g == 1 ? "Chromatic Percussion" : g == 2 ? "Organ" : g == 3 ? "Guitar" : g == 4 ? "Bass"
  : g == 5 ? "Strings" : g == 6 ? "Ensemble" : g == 7 ? "Brass" : g == 8 ? "Reed" : g == 9 ? "Pipe"
  : g == 10 ? "Synth Lead" : g == 11 ? "Synth Pad" : g == 12 ? "Synth Effects" : g == 13 ? "Ethnic"
  : g == 14 ? "Percussive" : g == 15 ? "Sound Effects" : "Drum kits";
);
function gbf_pg_drum(i) ( gb_drum_sec > 0 && (GB_PRG + i * 5)[0] == gb_drum_sec; );
function gbf_pg_group(i) ( gbf_pg_drum(i) ? 16 : ((GB_PRG + i * 5)[1] / 8) | 0; );
// the family tile a bank's program files under (the owner, 2026-11-05: "the side panel browser don't have the
// categories for the GM library"): by its GM group, a few by number; the kits under Drums, a kit with "808" in its name
// under 808s; the sound effects under Other (12: ALL INSTRUMENTS only). A bank that is not GM gets these too -- Gumbo
// is a GM player, its banks are GM SoundFonts.
function gbf_pg_tile(i) local(p, g) (
  gbf_pg_drum(i) ? ( gb_prog_name(i); matchi("*808*", #gb_ls) ? 1 : 0; )
  : (
    p = (GB_PRG + i * 5)[1]; g = (p / 8) | 0;
    g == 0 ? ( p == 4 || p == 5 || p == 7 ? 4 : 3 )            // pianos; the electric pianos and the clavinet
    : g <= 2 ? ( p == 22 ? 9 : 3 )                               // mallets and organs; the harmonica
    : g == 3 ? 10 : g == 4 ? 2                                   // guitars; basses
    : g == 5 ? ( p == 46 ? 10 : p == 47 ? 0 : 7 )                // strings; the harp; the timpani
    : g == 6 ? ( p >= 52 && p <= 54 ? 11 : 7 )                   // ensembles; the choirs
    : g == 7 ? 8 : g <= 9 ? 9 : g == 10 ? 6 : g <= 12 ? 5        // brass; reeds and pipes; leads; pads and effects
    : g == 13 ? ( p == 109 || p == 111 ? 9 : p == 110 ? 7 : 10 ) // ethnic: the bagpipe and shanai, the fiddle, the plucked
    : g == 14 ? 0 : 12;                                          // percussive; sound effects
  );
);
GBF_PGFAM = 1755000;                 // 512 -> 1755512: entry i's tile (rebuilt with GBF_PGORD, once per finished load; after GBF_KNM's 1754556)
GBF_PGMATCH = 1756000;               // 512 -> 1756512: does entry i's name match the search (rebuilt when the search or the load changes)
gbf_pgm_q = -1; gbf_pgm_gen = -1; gbf_pg_followed = -1; gbf_pg_at = -1;
function gbf_pg_match_build() local(i) (
  gb_ready && (gbf_pgm_q != gbf_q_gen || gbf_pgm_gen != gb_load_gen) ? (
    gbf_pgm_q = gbf_q_gen; gbf_pgm_gen = gb_load_gen; i = 0;
    loop(gb_nprg, gb_prog_name(i); GBF_PGMATCH[i] = strlen(#gbf_qp) <= 2 || matchi(#gbf_qp, #gb_ls); i += 1; );
  );
);
// is entry i in the side list now: the search's matches, else the picked tile's programs, else all
function gbf_pg_shown(i) ( strlen(#gbf_q) > 0 ? GBF_PGMATCH[i] : gbf_cat < 0 || GBF_PGFAM[i] == gbf_cat; );
// the bank's programs in menu order (2026-11-05, the owner: a variation sits beside its main program): by program
// number, the kits last, each number's entries in file order (the main bank, then the variations by bank). The menus,
// the < > steps and the browser rows walk it. Rebuilt once per finished load: GBF_PGORD[k] = an entry of GB_PRG.
GBF_PGORD = 1753000;                 // 512 -> 1753512 (after gb_sfz's GB_PRG, in the gap before GBF_IDX_BASE)
gbf_pgord_gen = -1;
function gbf_pg_order() local(k, key, i, q) (
  gb_ready && (gbf_pgord_gen != gb_load_gen || gbf_pgord_n != gb_nprg) ? (
    gbf_pgord_gen = gb_load_gen; gbf_pgord_n = gb_nprg; k = 0; key = 0;
    loop(256,
      i = 0;
      loop(gb_nprg,
        q = GB_PRG + i * 5;
        (q[0] == gb_drum_sec && gb_drum_sec > 0 ? 128 : 0) + q[1] == key ? ( GBF_PGORD[k] = i; k += 1; );
        i += 1;
      );
      key += 1;
    );
    i = 0; loop(gb_nprg, GBF_PGFAM[i] = gbf_pg_tile(i); i += 1; );   // and each entry's tile, for the side list
  );
);
// play entry i of GB_PRG: slider 89 + its bank in slider 90 (every channel takes it, gb_prog_apply). The display's box
// and list, the browser rows
function gbf_prog_pick(i) local(q) (
  i >= 0 && i < gb_nprg ? (
    q = GB_PRG + i * 5;
    slider89 = (q[0] == gb_drum_sec && gb_drum_sec > 0 ? 128 : 0) + q[1]; slider_automate(slider89);
    slider90 = gbf_pg_bank(i); slider_automate(slider90);
    gb_prog_req += 1;                 // even the same pick again: MIDI may have moved the channels since
  );
);
// the display's < > (and the wheel over it): the bank's next / previous entry, round the ends (not in the bank: > the first)
function gbf_prog_step(d) local(k, p) (
  gb_nprg > 0 ? (
    gbf_pg_order();
    p = -1; k = 0; loop(gb_nprg, GBF_PGORD[k] == gbf_pg_i ? p = k; k += 1; );
    gbf_prog_pick(GBF_PGORD[p < 0 ? (d > 0 ? 0 : gb_nprg - 1) : (p + d + gb_nprg) % gb_nprg]);
  );
);
// a bank's program box: < PROGRAM n  Name ▾ > at (x0, y0), up to wmax wide; its place stays in gbf_pg_x/y/w/h
// (gbf_pg_a = each arrow's width; the clicks: gb_face_p2 gbf_prog_click). Drawn by the display and by its folded bar.
function gbf_prog_box(x0, y0, wmax) local(s, k, bx, bw, c, v, bh) (
  s = gbf_s;
  gbf_prog_cur();
  gbf_pg_x = x0; gbf_pg_y = y0;
  gbf_pg_h = max(24 * s, 13 * s * gbf_tk + 10 * s); gbf_pg_w = max(gbf_pg_h * 4, min(380 * s, wmax));
  gbf_pg_a = gbf_pg_h;
  gbf_scr(0.04, 0.03, 0.03, 1); gfx_rect(gbf_pg_x, gbf_pg_y, gbf_pg_w, gbf_pg_h);
  gbf_scr(0.55, 0.36, 0.21, 1); gbf_box(gbf_pg_x, gbf_pg_y, gbf_pg_w, gbf_pg_h);
  // the two arrow cells, lit under the mouse
  k = 0;
  loop(2,
    bx = k == 0 ? gbf_pg_x : gbf_pg_x + gbf_pg_w - gbf_pg_a;
    gbf_hit(bx, gbf_pg_y, gbf_pg_a, gbf_pg_h) && !gbf_menu_block ? gbf_scr(0.36, 0.24, 0.15, 1) : gbf_scr(0.20, 0.14, 0.10, 1);
    gfx_rect(bx + 1, gbf_pg_y + 1, gbf_pg_a - 2, gbf_pg_h - 2);
    gbf_scr(1, 0.69, 0.40, 1); c = bx + gbf_pg_a * 0.5; v = gbf_pg_y + gbf_pg_h * 0.5; bw = gbf_pg_h * 0.16;
    k == 0 ? gfx_triangle(c - bw, v, c + bw * 0.8, v - bw * 1.3, c + bw * 0.8, v + bw * 1.3)
           : gfx_triangle(c + bw, v, c - bw * 0.8, v - bw * 1.3, c - bw * 0.8, v + bw * 1.3);
    k += 1;
  );
  // the name cell: PROGRAM 46 (small), the name (large), a small ▾ for the list
  bx = gbf_pg_x + gbf_pg_a; bw = gbf_pg_w - 2 * gbf_pg_a;
  gbf_hit(bx, gbf_pg_y, bw, gbf_pg_h) && !gbf_menu_block ? ( gbf_scr(0.16, 0.11, 0.08, 1); gfx_rect(bx, gbf_pg_y + 1, bw, gbf_pg_h - 2); );
  gbf_font(max(7, floor(9 * s)), 'b'); gbf_scr(0.79, 0.54, 0.35, 1);
  c = gbf_pg_i >= 0 ? gbf_pg_bank(gbf_pg_i) : 0;   // a variation names its bank
  c > 0 ? sprintf(#gbf_tmp, "PROGRAM %d  BANK %d", gbf_pg_p + 1, c)
        : sprintf(#gbf_tmp, "%s %d", gbf_pg_kit ? "KIT" : "PROGRAM", gbf_pg_p + 1);
  gfx_measurestr(#gbf_tmp, gbf_tw, gbf_th_);
  gfx_x = bx + 8 * s; gfx_y = gbf_pg_y + (gbf_pg_h - gbf_th_) * 0.5; gfx_drawstr(#gbf_tmp);
  c = gfx_x + 8 * s;
  gbf_pg_i >= 0 ? gb_prog_name(gbf_pg_i) : strcpy(#gb_ls, "(not in this set)");
  gbf_font(max(9, floor(13 * s)), 'b'); gbf_scr(1, 0.69, 0.40, 1);
  gfx_measurestr(#gb_ls, gbf_tw, gbf_th_);
  gfx_x = c; gfx_y = gbf_pg_y + (gbf_pg_h - gbf_th_) * 0.5;
  gfx_drawstr(#gb_ls, 0, bx + bw - 16 * s, gbf_pg_y + gbf_pg_h);
  c = bx + bw - 9 * s; v = gbf_pg_y + gbf_pg_h * 0.5; bh = 3.5 * s;
  gbf_scr(0.79, 0.54, 0.35, 1); gfx_triangle(c - bh, v - bh * 0.6, c + bh, v - bh * 0.6, c, v + bh * 0.8);
);
// the display folded to a bar (the owner, 2026-11-05: "can we make the lcd collapsable?"): the name, a bank's program
// box, else the status line; the page below takes the room. slider93 holds the state; gbf_display_fold_btn is the
// chevron at the display's top right that flips it, drawn over either form.
function gbf_display_bar(x, y, w, h) local(s, fs, bx, bh) (
  s = gbf_s;
  gbf_scr(0.08, 0.07, 0.06, 1); gfx_rect(x, y, w, h);
  gbf_scr(0.23, 0.16, 0.12, 1); gbf_box(x, y, w, h);
  gbf_name(); gbf_status();
  fs = max(10, floor(14 * s));
  gbf_font(fs, 'b'); gbf_scr(1, 0.69, 0.40, 1);
  gfx_x = x + 12 * s; gfx_y = y + (h - fs) * 0.5;
  strlen(#gb_want) ? gfx_drawstr(#gbf_name, 0, x + w * 0.3, y + h) : gfx_drawstr("GUMBO");
  bx = max(gfx_x + 14 * s, x + w * 0.3);
  gbf_pg_h = 0; gbf_chip_y = -1000;
  gb_ready && gb_nprg > 0 ? (
    bh = max(24 * s, 13 * s * gbf_tk + 10 * s);
    gbf_prog_box(bx, y + (h - bh) * 0.5, w * 0.42);
  ) : (
    gbf_font(max(9, floor(11 * s)), 0); gbf_warn ? gbf_scr(1, 0.55, 0.3, 1) : gbf_scr(0.79, 0.54, 0.35, 1);
    gfx_x = bx; gfx_y = y + (h - 11 * s) * 0.5; gbf_st_fit(x + w - 40 * s - bx); gfx_drawstr(#gbf_st, 0, x + w - 40 * s, y + h);
  );
);
function gbf_display_fold_btn(x, y, w) local(s, bx, by, bs, hot, cx, cy) (
  s = gbf_s; bs = 16 * s; bx = x + w - bs - 6 * s; by = y + 6 * s;
  hot = !gbf_menu_block && gbf_hit(bx, by, bs, bs);
  gbf_scr(hot ? 0.36 : 0.20, hot ? 0.24 : 0.14, hot ? 0.15 : 0.10, 1); gfx_rect(bx, by, bs, bs);
  gbf_scr(1, 0.69, 0.40, 1); cx = bx + bs * 0.5; cy = by + bs * 0.5;
  slider93 >= 0.5 ? gfx_triangle(cx - 4 * s, cy + 2 * s, cx + 4 * s, cy + 2 * s, cx, cy - 2 * s)
                  : gfx_triangle(cx - 4 * s, cy - 2 * s, cx + 4 * s, cy - 2 * s, cx, cy + 2 * s);
  lmb_down && hot ? ( lmb_down = 0; slider93 = slider93 >= 0.5 ? 0 : 1; slider_automate(slider93); );
);
function gbf_display(x, y, w, h) local(d, s, fs, wx, ww, wy, wh, r, sm, ptr, nch, fr, step, c, i, j, a, b, v, kx, kw, n, lo, hi, nb, bl, bh, cnt, k, bx, bw, seg, db, pk, gn, lm, ls, le, tl, ft, q, gq)
(
  s = gbf_s;
  d = (gbf_tk - 1) * 9 * s;            // what a section label grows by at this TEXT SIZE
  gbf_scr(0.08, 0.07, 0.06, 1); gfx_rect(x, y, w, h);
  gbf_scr(0.16, 0.12, 0.09, 1); gfx_rect(x + 2 * s, y + 2 * s, w - 4 * s, h * 0.45);
  gbf_scr(0.23, 0.16, 0.12, 1); gbf_box(x, y, w, h);
  gbf_name(); gbf_status();
  // the name and the line under it
  fs = max(12, floor(min(26 * s, h * 0.15)));
  gbf_font(fs, 'b'); gbf_scr(1, 0.69, 0.40, 1);
  gfx_x = x + 16 * s; gfx_y = y + 12 * s;
  strlen(#gb_want) ? gfx_drawstr(#gbf_name, 0, x + w * 0.5, y + h) : gfx_drawstr("GUMBO");
  gbf_font(max(9, floor(11 * s)), 0);
  gbf_warn ? gbf_scr(1, 0.55, 0.3, 1) : gbf_scr(0.79, 0.54, 0.35, 1);
  gfx_x = x + 16 * s; gfx_y = y + 12 * s + fs * gbf_tk + 4 * s; gbf_st_fit(w * 0.5 - 16 * s); gfx_drawstr(#gbf_st, 0, x + w * 0.5, y + h);
  // a bank: the program playing, in a box of its own (the owner, 2026-11-03, of the old one-line caption: "i barley
  // noticed where to change it"): < > step through the bank, a click on the name opens the list (gb_face_p2,
  // gbf_prog_click). Its place and size stay in gbf_pg_x/y/w/h (gbf_pg_a = each arrow's width).
  gbf_pg_h = 0;
  gbf_chip_y = y + 12 * s + fs * gbf_tk + 22 * s;   // the playing-style chips (gb_face_p2): under the box when there is one
  gb_ready && gb_nprg > 0 ? (
    gbf_prog_box(x + 16 * s, gfx_y + 16 * s, w * 0.5 - 16 * s);
    gbf_chip_y = gbf_pg_y + gbf_pg_h + 6 * s;
    gbf_font(max(9, floor(11 * s)), 0);
    gfx_y = gbf_pg_y + gbf_pg_h - 10 * s;   // a "sounds left out" line comes 14 below this: just under the box
  );
  gb_ready && (gb_smp_missing + gb_smp_badfmt + gb_smp_noroom) > 0 ? (
    gbf_scr(1, 0.55, 0.3, 1); gfx_x = x + 16 * s; gfx_y += 14 * s;
    // too big (the owner, 2026-11-01: tell users the limit). Packed (2026-11-04) the limit is about 3 GB of sound as
    // the browser counts it (8 bytes a point); unpacked only a file without the converter's size line can run out
    // every sound left out: say it plays nothing (outside audit, 2026-11-05: it read as a working instrument)
    gb_nsmp > 0 && gb_smp_missing + gb_smp_badfmt + gb_smp_noroom >= gb_nsmp
      ? sprintf(#gbf_tmp, "None of its %d sounds could be loaded: it plays nothing", gb_nsmp)
    : gb_smp_noroom > 0 ? sprintf(#gbf_tmp, gb_pack ? "%d sounds left out: Gumbo holds up to about 3 GB of sound"
                                                  : "%d sounds left out: Gumbo holds up to about 1 GB of sound", gb_smp_missing + gb_smp_badfmt + gb_smp_noroom)
                      : sprintf(#gbf_tmp, "%d sounds left out", gb_smp_missing + gb_smp_badfmt + gb_smp_noroom);
    gfx_drawstr(#gbf_tmp, 0, x + w * 0.5, y + h);
  );
  // the load bar
  (gb_job == GB_J_PARSE || gb_job == GB_J_SAMPLES) && gb_nsmp > 0 ? (
    gbf_scr(0.23, 0.16, 0.12, 1); gfx_rect(x + 16 * s, y + h - 14 * s, w * 0.45 - 16 * s, 4 * s);
    gbf_scr(1, 0.48, 0.24, 1); gfx_rect(x + 16 * s, y + h - 14 * s, (w * 0.45 - 16 * s) * gb_js / gb_nsmp, 4 * s);
  );
  // the last note's waveform (min/max per column over the WHOLE sound; it used to stop at 1.5 s, so a sustained sound
  // ended in a vertical wall -- the owner, 2026-11-09: "the waveform still gets cut off"). Its place: the left column under the name, at
  // 42 % of a design-height display (230 s) and 40 % tall; a taller display (a tall window's spare height, gbf_window
  // 2026-11-09) keeps the header where it is and the waveform grows down to 41 s above the bottom (its note line sits
  // under it); from 310 s up it moves under the right column too and takes the whole width
  wx = x + 16 * s; ww = w * 0.45 - 16 * s; wy = y + min(h * 0.42, 97 * s); wh = max(h * 0.40, y + h - wy - 41 * s);
  h >= 310 * s + 2 * d ? ( ww = w - 32 * s; wy = y + 170 * s + 2 * d; wh = y + h - wy - 41 * s; );
  // the playing-style chips sit under the name (gb_face_p2): the waveform starts below them
  // (and below a bank's program box)
  gb_ready && gbf_pg_h > 0 ? ( wy = max(wy, gbf_pg_y + gbf_pg_h + 8 * s); wh = min(wh, y + h - wy - 16 * s); );
  gb_ready && gb_nswl > 0 ? ( wy = max(wy, gbf_chip_y + 24 * s); wh = min(wh, y + h - wy - 16 * s); );
  gb_ready && gb_last_reg >= 0 && gb_last_reg < gb_nreg && wh > 10 * s ? (
    r = GB_REG + gb_last_reg * GB_RS; sm = r[GBR_SMP];
    sm >= 0 && GB_SMP[sm * GB_SS + GBS_STAT] == GB_SS_OK ? (
      ptr = GB_SMP[sm * GB_SS + GBS_PTR]; nch = GB_SMP[sm * GB_SS + GBS_NCH];
      fr = GB_SMP[sm * GB_SS + GBS_FRAMES];
      // a looped sound (a sustain loop: the recording ends at playing level, so its picture ended in a wall -- the
      // owner, 2026-11-09: "the waveform still gets cut off"): the picture runs on past the recording's end through
      // the loop with the region's release fading it (gb_coef_sfz's law, -78 dB at the release time; 0.1 .. 4 s), as
      // the sound does when the key is let go there
      lm = r[GBR_LMODE]; ls = r[GBR_LSTART]; le = min(r[GBR_LEND], fr - 1);
      tl = (lm == GB_LM_CONT || lm == GB_LM_SUST) && le > ls ? (min(4, max(0.1, r[GBR_REL])) * GB_SMP[sm * GB_SS + GBS_SR]) | 0 : 0;
      ft = fr + tl;
      step = max(1, (ft / max(1, ww)) | 0);
      // drawn to fill its space: the loudest point of what is shown reaches the top (quiet recordings, like the
      // orchestra's, otherwise drew a flat line), at most x32 so a near-silent tail stays near-silent
      pk = 0; c = 0;
      loop(max(1, min(ww, ft) | 0),
        j = (c * step) | 0; i = 0;
        loop(min(24, step),
          q = j + ((i * step / min(24, step)) | 0);
          q >= fr ? ( gq = exp(-9 * (q - fr) / tl); q = ls + ((q - ls) % (le - ls + 1)); ) : gq = 1;
          v = abs(gb_pack ? gb_pk(ptr, q * nch) : ptr[q * nch]) * gq; v > pk ? pk = v; i += 1;
        );
        c += 1;
      );
      gn = pk > 0 ? min(32, 0.95 / pk) : 1;
      gbf_scr(1, 0.48, 0.24, 1);
      c = 0;
      loop(max(1, min(ww, ft) | 0),    // a sound shorter than the strip is wide: stop at its end
        a = 0; b = 0; j = (c * step) | 0; i = 0;
        loop(min(24, step),
          q = j + ((i * step / min(24, step)) | 0);
          q >= fr ? ( gq = exp(-9 * (q - fr) / tl); q = ls + ((q - ls) % (le - ls + 1)); ) : gq = 1;
          v = (gb_pack ? gb_pk(ptr, q * nch) : ptr[q * nch]) * gq; v < a ? a = v; v > b ? b = v; i += 1;
        );
        a *= gn; b *= gn;
        gfx_line(wx + c, wy + wh * 0.5 - b * wh * 0.5, wx + c, wy + wh * 0.5 - a * wh * 0.5);
        c += 1;
      );
      sprintf(#gbf_tmp, "NOTE %d  -  vel %d", gb_last_note, gb_last_vel);
      gbf_scr(0.54, 0.35, 0.23, 1); gbf_font(max(8, floor(9 * s)), 0); gfx_x = wx; gfx_y = wy + wh + 2 * s; gfx_drawstr(#gbf_tmp);
    );
  );
  // the right half: recorded notes, loudness layers, output
  kx = x + w * 0.52; kw = w * 0.45; lo = gbf_lo; hi = gbf_hi;
  gbf_font(max(8, floor(9 * s)), 'b'); gbf_scr(0.79, 0.54, 0.35, 1);
  gfx_x = kx; gfx_y = y + 12 * s; gfx_drawstr("RECORDED NOTES");
  n = lo; nb = hi - lo + 1; bw = kw / nb;
  loop(nb,
    bl = rk_piano_is_black(n);
    gbf_scr(bl ? 0.16 : 0.35, bl ? 0.12 : 0.25, bl ? 0.09 : 0.19, 1);
    gfx_rect(kx + (n - lo) * bw, y + 26 * s + d, max(1, bw - 1), bl ? 12 * s : 18 * s);
    gb_ready && gbf_rec_gen == gbf_pgk ? ( GBF_REC[n] ? ( gbf_scr(1, 0.69, 0.40, 1); gfx_circle(kx + (n - lo + 0.5) * bw, y + 50 * s + d, max(1.5, 2 * s), 1); ); );
    gb_ready && n == gb_last_note ? ( gbf_scr(1, 0.48, 0.24, 1); gfx_rect(kx + (n - lo) * bw, y + 56 * s + d, max(1, bw - 1), 6 * s); );
    n += 1;
  );
  // loudness layers of the last note: the distinct velocity bands of the attack regions on it
  gbf_scr(0.79, 0.54, 0.35, 1); gfx_x = kx; gfx_y = y + 72 * s + d; gfx_drawstr("LOUDNESS LAYERS");
  cnt = 0;
  gb_ready && gb_last_note >= 0 ? (
    i = 0;
    while (i < gb_nreg && cnt < 8) (
      r = GB_REG + i * GB_RS;
      r[GBR_TRIG] == GB_TR_ATTACK && gb_last_note >= r[GBR_LOKEY] && gb_last_note <= r[GBR_HIKEY] ? (
        k = 0; j = 0; while (k < cnt && !j) ( GBF_LAY[k * 2] == r[GBR_LOVEL] && GBF_LAY[k * 2 + 1] == r[GBR_HIVEL] ? j = 1; k += 1; );
        !j ? ( GBF_LAY[cnt * 2] = r[GBR_LOVEL]; GBF_LAY[cnt * 2 + 1] = r[GBR_HIVEL]; cnt += 1; );
      );
      i += 1;
    );
  );
  cnt == 0 ? ( GBF_LAY[0] = 1; GBF_LAY[1] = 127; cnt = 1; );
  // sort by low velocity (a handful: insertion sort)
  i = 1; loop(cnt - 1, j = i; while (j > 0 && GBF_LAY[(j - 1) * 2] > GBF_LAY[j * 2]) ( a = GBF_LAY[j * 2]; b = GBF_LAY[j * 2 + 1];
    GBF_LAY[j * 2] = GBF_LAY[(j - 1) * 2]; GBF_LAY[j * 2 + 1] = GBF_LAY[(j - 1) * 2 + 1]; GBF_LAY[(j - 1) * 2] = a; GBF_LAY[(j - 1) * 2 + 1] = b; j -= 1; ); i += 1; );
  bx = kx; bw = (kw - (cnt - 1) * 4 * s) / cnt; bh = 16 * s;
  k = 0;
  loop(cnt,
    j = gb_last_vel >= GBF_LAY[k * 2] && gb_last_vel <= GBF_LAY[k * 2 + 1] && gb_ready;
    j ? gbf_scr(1, 0.48, 0.24, 1) : gbf_scr(0.29, 0.20, 0.15, 1);
    gfx_rect(bx, y + 86 * s + 2 * d, bw, bh);
    j ? gbf_scr(0.10, 0.05, 0.02, 1) : gbf_scr(0.79, 0.54, 0.35, 1);
    cnt == 4 ? strcpy(#gbf_tmp, k == 0 ? "soft" : k == 1 ? "medium" : k == 2 ? "hard" : "very hard")
    : cnt == 3 ? strcpy(#gbf_tmp, k == 0 ? "soft" : k == 1 ? "medium" : "hard")
    : cnt == 2 ? strcpy(#gbf_tmp, k == 0 ? "soft" : "hard")
    : cnt == 1 ? strcpy(#gbf_tmp, "one layer") : sprintf(#gbf_tmp, "%d", k + 1);
    gfx_measurestr(#gbf_tmp, gbf_tw, gbf_th_);
    gbf_tw < bw - 4 * s ? ( gfx_x = bx + 5 * s; gfx_y = y + 86 * s + 2 * d + (bh - gbf_th_) * 0.5; gfx_drawstr(#gbf_tmp); );
    bx += bw + 4 * s; k += 1;
  );
  // the output, from the meter's peaks
  gbf_scr(0.79, 0.54, 0.35, 1); gfx_x = kx; gfx_y = y + 116 * s + 2 * d; gfx_drawstr("OUT");
  mtr_update_db();                     // the meter's own draw does this; the display reads its peaks without drawing it
  db = max(mtr_peak_l, mtr_peak_r);
  seg = 0;
  loop(30,
    a = -60 + seg * 2;
    gbf_scr(db > a ? (seg >= 27 ? 1 : seg >= 22 ? 1 : 1) : 0.23, db > a ? (seg >= 27 ? 0.30 : seg >= 22 ? 0.83 : 0.48) : 0.16, db > a ? (seg >= 27 ? 0.25 : seg >= 22 ? 0.42 : 0.24) : 0.12, 1);
    gfx_rect(kx + 30 * s + seg * (kw - 30 * s) / 30, y + 116 * s + 2 * d, max(1, (kw - 30 * s) / 30 - 2 * s), 10 * s);
    seg += 1;
  );
);

// recorded-notes dots and each key's fixed state, from the playing instrument's regions (rebuilt when it changes):
// recorded = an attack region has its root on the key; playable = some attack region spans it; keyswitch = inside a
// keyswitch range
function gbf_rec_build() local(n, i, r) (
  gb_ready && gbf_rec_gen != gbf_pgk ? (
    memset(GBF_REC, 0, 128); memset(GBF_KST, 0, 128);
    i = 0;
    loop(gb_nreg,
      r = GB_REG + i * GB_RS;
      gbf_in_prog(r) ? (
        r[GBR_TRIG] == GB_TR_ATTACK && r[GBR_SMP] != GB_SILENCE ? (
          n = max(0, min(127, r[GBR_KEYC] | 0)); r[GBR_SMP] >= 0 ? GBF_REC[n] = 1;
          n = max(0, r[GBR_LOKEY] | 0); loop(max(0, min(127, r[GBR_HIKEY] | 0) - n + 1), GBF_KST[n] |= RKP_RANGE; n += 1; );
        );
        r[GBR_SWLO] >= 0 && r[GBR_SWHI] >= r[GBR_SWLO] ? (
          n = r[GBR_SWLO] | 0; loop(min(127, r[GBR_SWHI] | 0) - n + 1, GBF_KST[n] = RKP_KS; n += 1; );
        );
      );
      i += 1;
    );
    gbf_rec_gen = gbf_pgk;
  );
);
// the playing instrument's key names: a bank's kit from its own "// key_name" entries (GB_KN); else the file's
// "// label_key" names -- all of them for an ordinary kit, only the keys this program plays for an older bank file.
// GBF_KNM[n * 2] = the name's offset in GB_LCH, [n * 2 + 1] its length (0 = none); gbf_nkn = how many keys are named
GBF_KNM = 1754300;                   // 128 x 2 -> 1754556 (the gap before GBF_IDX_BASE)
gbf_nkn = 0; gbf_knm_gen = -1;
function gbf_names_build() local(n, i, e) (
  gb_ready && gbf_knm_gen != gbf_pgk ? (
    gbf_knm_gen = gbf_pgk; memset(GBF_KNM, 0, 256); gbf_nkn = 0;
    gb_nprg > 0 && gbf_pg_kit ? (
      i = 0;
      loop(gb_nkn,
        e = GB_KN + i * 5;
        e[0] == gbf_pg_sec && e[1] == gbf_pg_p && GBF_KNM[e[2] * 2 + 1] == 0 ? (
          GBF_KNM[e[2] * 2] = e[3]; GBF_KNM[e[2] * 2 + 1] = e[4]; gbf_nkn += 1;
        );
        i += 1;
      );
    );
    gbf_nkn == 0 && gb_nkey > 0 && (gb_nprg == 0 || gbf_pg_kit) ? (
      n = 0;
      loop(128,
        GB_KLB[n * 2 + 1] > 0 && (gb_nprg == 0 || (GBF_KST[n] & RKP_RANGE)) ? (
          GBF_KNM[n * 2] = GB_KLB[n * 2]; GBF_KNM[n * 2 + 1] = GB_KLB[n * 2 + 1]; gbf_nkn += 1;
        );
        n += 1;
      );
    );
  );
);
// key n's name (the playing instrument's) into #gb_ls; returns its length
function gbf_key_name(n) local(p, k) (
  #gb_ls = "";
  n >= 0 && n <= 127 && GBF_KNM[n * 2 + 1] > 0 ? (
    p = GB_LCH + GBF_KNM[n * 2];
    k = 0; loop(GBF_KNM[n * 2 + 1], sprintf(#gb_lsc, "%c", p[k]); strcat(#gb_ls, #gb_lsc); k += 1; );
  );
  strlen(#gb_ls);
);
// once a frame, before anything that draws the instrument: which program plays, and the tables built from it
function gbf_prog_sync() (
  gb_ready ? ( gbf_prog_cur(); gbf_pgk = gb_load_gen * 65536 + gbf_pg_sec * 128 + gbf_pg_p; ) : gbf_pgk = -1;
  gbf_rec_build(); gbf_names_build(); gbf_range();
);
// the keyboard's colours and this frame's key states: the family colour tints the playable keys (the owner's
// choice, 2026-10-30), keyswitches pink with the active one bright, held keys lit whole in the accent
function gbf_keys_prep(lo, hi) local(n, e) (
  e = gbf_idx_loaded ? gbf_idx_current_cached() : -1;
  e >= 0 ? ( gbf_fam_col((GBF_IDX_BASE + e * GBF_IS)[0]); rk_piano_colours(gbf_fc_r, gbf_fc_g, gbf_fc_b, 0.91, 0.28, 0.60); )
         : rk_piano_colours(gbf_ac_r, gbf_ac_g, gbf_ac_b, 0.91, 0.28, 0.60);
  n = lo;
  loop(hi - lo + 1,
    GBF_KSF[n] = (gb_ready && gbf_rec_gen == gbf_pgk ? GBF_KST[n] : 0) | (GB_NTA[n] ? RKP_HELD : 0)
                 | (gb_ready && n == gb_sw_cur && (GBF_KST[n] & RKP_KS) ? RKP_KSON : 0);
    n += 1;
  );
);

// ── the browser ──
// one line of the "no sounds" text at ry + k lines, drawn only while it fits above yb (the footer)
function gbf_hint_line(txt, k, x, w, ry, yb) (
  ry + gbf_th_ * (k + 1) <= yb ? ( gfx_x = x + 12 * gbf_s; gfx_y = ry + gbf_th_ * k; gfx_drawstr(txt, 0, x + w - 6 * gbf_s, gfx_y + gbf_th_); );
);
// a five-pointed star at (cx, cy), r its outer radius: filled, or its outline
function gbf_star(cx, cy, r, filled) local(i, a, x0, y0, x1, y1, xi, yi) (
  i = 0;
  loop(5,
    a = -$pi * 0.5 + i * $pi * 0.4;
    x0 = cx + r * cos(a); y0 = cy + r * sin(a);
    xi = cx + r * 0.42 * cos(a + $pi * 0.2); yi = cy + r * 0.42 * sin(a + $pi * 0.2);
    x1 = cx + r * cos(a + $pi * 0.4); y1 = cy + r * sin(a + $pi * 0.4);
    filled ? ( gfx_triangle(cx, cy, x0, y0, xi, yi); gfx_triangle(cx, cy, xi, yi, x1, y1); )
           : ( gfx_line(x0, y0, xi, yi, 1); gfx_line(xi, yi, x1, y1, 1); );
    i += 1;
  );
);
// the search, as a pattern for matchi (the typed text, wildcards and format marks taken out) -> GBF_MATCH per entry:
// its name or its family's name holds the text, any case
// ── a drum pad's family and icon from its name (the owner, 2026-11-05: "can we allow the pads to add icons the way
// swing does. maybe even colors?" -> "Family colors. And yes change the icon and color"). Seven families, each a
// colour: 0 kicks, 1 snares (rims, claps, sticks), 2 hats, 3 toms, 4 cymbals, 5 hand percussion, 6 the rest (clicks,
// scratches, effects). The words are looked for in the pad's name in this order, the first found wins ("hat open"
// before "hat", "ride" before "bell", "metronome" before "bell"); no word = family 6, the percussion icon. The icons
// are the free EON track icons, Gumbo's own copies (gumbo_icons; the release script ships every name
// gbf_pad_icon_name lists, so keep that list and the icon files together).
GBF_PAD_NICON = 22;
GBF_PICON_SLOT = 54;                 // gfx image slots 54..75 (52, 53 are the key-name images)
gbf_picons_loaded = 0;
function gbf_pad_icon_name(i) (
  i == 0 ? "kick" : i == 1 ? "snare" : i == 2 ? "rimshot" : i == 3 ? "clap" : i == 4 ? "hihat" : i == 5 ? "open_hat"
  : i == 6 ? "closed_hat" : i == 7 ? "tom" : i == 8 ? "floor_tom" : i == 9 ? "rack_tom" : i == 10 ? "crash" : i == 11 ? "ride"
  : i == 12 ? "cymbal" : i == 13 ? "conga" : i == 14 ? "bongo" : i == 15 ? "shaker" : i == 16 ? "tambourine" : i == 17 ? "clave"
  : i == 18 ? "woodblock" : i == 19 ? "triangle" : i == 20 ? "cowbell" : "percussion";
);
function gbf_pad_icons_load() local(i) (
  i = 0;
  loop(GBF_PAD_NICON,
    sprintf(#gbf_tmp, "EON_Gumbo/gumbo_icons/%s.png", gbf_pad_icon_name(i));
    gfx_loadimg(GBF_PICON_SLOT + i, #gbf_tmp) < 0 ? (
      sprintf(#gbf_tmp, "track_icons/EON/%s.png", gbf_pad_icon_name(i)); gfx_loadimg(GBF_PICON_SLOT + i, #gbf_tmp); );
    i += 1;
  );
  gbf_picons_loaded = 1;
);
GBF_PAD_NWORD = 54;
function gbf_pad_word(k) (
  k == 0 ? "kick" : k == 1 ? "bass drum" : k == 2 ? "snr" : k == 3 ? "snare" : k == 4 ? "rim" : k == 5 ? "clap" : k == 6 ? "stick"
  : k == 7 ? "hat open" : k == 8 ? "hat closed" : k == 9 ? "hat foot" : k == 10 ? "hat half" : k == 11 ? "open hat" : k == 12 ? "closed hat"
  : k == 13 ? "hihat" : k == 14 ? "hi hat" : k == 15 ? "hat" : k == 16 ? "flr" : k == 17 ? "floor" : k == 18 ? "rack" : k == 19 ? "tom"
  : k == 20 ? "studio" : k == 21 ? "crsh" : k == 22 ? "crash" : k == 23 ? "ride" : k == 24 ? "china" : k == 25 ? "splash" : k == 26 ? "cym"
  : k == 27 ? "reverse" : k == 28 ? "conga" : k == 29 ? "tumba" : k == 30 ? "quinto" : k == 31 ? "bongo" : k == 32 ? "cabasa"
  : k == 33 ? "maracas" : k == 34 ? "shake" : k == 35 ? "sleigh" : k == 36 ? "tamb" : k == 37 ? "clave" : k == 38 ? "wood" : k == 39 ? "block"
  : k == 40 ? "triangle" : k == 41 ? "cow" : k == 42 ? "agogo" : k == 43 ? "metronome" : k == 44 ? "bell" : k == 45 ? "guiro"
  : k == 46 ? "quica" : k == 47 ? "cuica" : k == 48 ? "whistle" : k == 49 ? "castanet" : k == 50 ? "taiko" : k == 51 ? "timbale"
  : k == 52 ? "scratch" : "perc";
);
function gbf_pad_wfam(k) ( k <= 1 ? 0 : k <= 6 ? 1 : k <= 15 ? 2 : k <= 20 ? 3 : k <= 27 ? 4 : k <= 42 ? 5 : k == 43 ? 6 : k <= 51 ? 5 : k == 52 ? 6 : 5; );
function gbf_pad_wicon(k) (
  k <= 1 ? 0 : k <= 3 ? 1 : k == 4 ? 2 : k == 5 ? 3 : k == 6 ? 2
  : k == 7 || k == 10 || k == 11 ? 5 : k == 8 || k == 9 || k == 12 ? 6 : k <= 15 ? 4
  : k == 16 || k == 17 ? 8 : k == 18 ? 9 : k <= 20 ? 7
  : k <= 22 ? 10 : k == 23 ? 11 : k <= 27 ? 12
  : k <= 30 ? 13 : k == 31 ? 14 : k <= 35 ? 15 : k == 36 ? 16 : k == 37 ? 17 : k <= 39 ? 18 : k == 40 ? 19 : k <= 42 ? 20
  : k == 43 ? 21 : k == 44 ? 20 : 21;
);
// a family's colour -> gbf_pc_r/g/b (its own outputs: gbf_fc_* belong to the instrument families)
function gbf_pad_fcol(f) (
  f == 0 ? ( gbf_pc_r = 0.90; gbf_pc_g = 0.20; gbf_pc_b = 0.18; )      // kicks: red (the owner, 2026-11-05: "make the red color for the drum pads red")
  : f == 1 ? ( gbf_pc_r = 0.96; gbf_pc_g = 0.80; gbf_pc_b = 0.24; )    // snares, rims, claps: yellow
  : f == 2 ? ( gbf_pc_r = 0.25; gbf_pc_g = 0.80; gbf_pc_b = 0.88; )    // hats: cyan
  : f == 3 ? ( gbf_pc_r = 0.38; gbf_pc_g = 0.56; gbf_pc_b = 0.95; )    // toms: blue
  : f == 4 ? ( gbf_pc_r = 0.88; gbf_pc_g = 0.78; gbf_pc_b = 0.50; )    // cymbals: pale gold
  : f == 5 ? ( gbf_pc_r = 0.38; gbf_pc_g = 0.80; gbf_pc_b = 0.44; )    // hand percussion: green
  : ( gbf_pc_r = 0.68; gbf_pc_g = 0.56; gbf_pc_b = 0.88; );            // the rest: violet
);
GBF_PFAM = 1761000;                  // 128: a pad note's family (the playing kit's; rebuilt with the pads)
GBF_PICON = 1761200;                 // 128: its icon (an index into gbf_pad_icon_name)
GBF_PLOOK = 1761400;                 // 128 x 3: its hand-picked icon (-1 = automatic), family (-1 = automatic), own colour (r * 65536 + g * 256 + b, -1 = none) -> 1761784
GBF_KCOL = 1762200;                  // 128 x 3: the keys' colours for rk_piano_key_colours (r < 0 = none) -> 1762584
GBF_PCOL = 1762600;                  // 128 x 3: each pad's colour as drawn (its own, else its family's) -> 1762984
gbf_pick_note = -1;                  // the pad whose look picker is open, or -1
gbf_pick_for = -1; gbf_pick_h = 0; gbf_pick_s = 0; gbf_pick_v = 1; gbf_pick_drag = 0;   // the picker's wheel: the pad it holds, hue / saturation / brightness, a drag (1 ring, 2 square)
// colours: h 0..360, s and v 0..1 -> gbf_cw_r/g/b; and back -> gbf_cw_h/s/v (the picker's wheel, the owner 2026-11-05)
function gbf_hsv_rgb(h, s, v) local(i, f, p, q, t) (
  h = h - floor(h / 360) * 360; i = floor(h / 60); f = h / 60 - i;
  p = v * (1 - s); q = v * (1 - s * f); t = v * (1 - s * (1 - f));
  i == 0 ? ( gbf_cw_r = v; gbf_cw_g = t; gbf_cw_b = p; ) : i == 1 ? ( gbf_cw_r = q; gbf_cw_g = v; gbf_cw_b = p; )
  : i == 2 ? ( gbf_cw_r = p; gbf_cw_g = v; gbf_cw_b = t; ) : i == 3 ? ( gbf_cw_r = p; gbf_cw_g = q; gbf_cw_b = v; )
  : i == 4 ? ( gbf_cw_r = t; gbf_cw_g = p; gbf_cw_b = v; ) : ( gbf_cw_r = v; gbf_cw_g = p; gbf_cw_b = q; );
);
function gbf_rgb_hsv(r, g, b) local(mx, mn, d) (
  mx = max(r, max(g, b)); mn = min(r, min(g, b)); d = mx - mn;
  gbf_cw_v = mx; gbf_cw_s = mx > 0 ? d / mx : 0;
  gbf_cw_h = d <= 0 ? 0 : mx == r ? 60 * ((g - b) / d) : mx == g ? 60 * (2 + (b - r) / d) : 60 * (4 + (r - g) / d);
  gbf_cw_h < 0 ? gbf_cw_h += 360;
);
function gbf_rgb_pack(r, g, b) ( (max(0, min(255, r * 255 + 0.5)) | 0) * 65536 + (max(0, min(255, g * 255 + 0.5)) | 0) * 256 + (max(0, min(255, b * 255 + 0.5)) | 0); );
function gbf_rgb_unpack(c) ( gbf_cw_r = floor(c / 65536) / 255; gbf_cw_g = (floor(c / 256) % 256) / 255; gbf_cw_b = (c % 256) / 255; );
// "rrggbb" in #gbf_fld -> a packed colour, or -1
function gbf_hex_col() local(i, c, v, k) (
  v = 0; k = 1; i = 0;
  strlen(#gbf_fld) == 6 ? (
    loop(6,
      c = str_getchar(#gbf_fld, i);
      c >= '0' && c <= '9' ? c -= '0' : c >= 'a' && c <= 'f' ? c = c - 'a' + 10 : c >= 'A' && c <= 'F' ? c = c - 'A' + 10 : k = 0;
      v = v * 16 + c; i += 1;
    );
  ) : k = 0;
  k ? v : -1;
);
// pad note n's family and icon from its name (gbf_key_name -> #gb_ls)
function gbf_pad_class(n) local(k, f, ic) (
  gbf_key_name(n); f = 6; ic = GBF_PAD_NICON - 1; k = 0;
  while (k < GBF_PAD_NWORD) (
    sprintf(#gbf_tmp, "*%s*", gbf_pad_word(k));
    matchi(#gbf_tmp, #gb_ls) ? ( f = gbf_pad_wfam(k); ic = gbf_pad_wicon(k); k = GBF_PAD_NWORD; ) : k += 1;
  );
  GBF_PFAM[n] = f; GBF_PICON[n] = ic;
);
// the line's path (its first p0 characters) is index entry e's, any case
function gbf_look_same(e, p0) local(p, k, a, b, ok) (
  ok = e[5] == p0; p = GBF_ICH_BASE + e[4]; k = 0;
  while (ok && k < p0) (
    a = p[k]; b = str_getchar(#gbf_ln, k, 'cu');
    a >= 65 && a <= 90 ? a += 32; b >= 65 && b <= 90 ? b += 32;
    a != b ? ok = 0; k += 1;
  );
  ok;
);
// EON_Gumbo/pad_looks.txt (the Gumbo helper keeps it): "path|section|program|note|icon|family" a line -- the path as
// the browser lists write it, icon a name from gbf_pad_icon_name ("" = automatic), family 0..6 (-1 = automatic). The
// playing kit's lines -> GBF_PLOOK; an instrument that is not in the library list has none.
function gbf_looks_load() local(h, k, n, cur, e, i, c, cuts, p0, p1, p2, p3, p4, p5, sec, prog, note, fam, ic, col) (
  n = 0; loop(128, GBF_PLOOK[n * 3] = -1; GBF_PLOOK[n * 3 + 1] = -1; GBF_PLOOK[n * 3 + 2] = -1; n += 1; );
  cur = gbf_idx_current_cached();
  cur >= 0 ? (
    e = GBF_IDX_BASE + cur * GBF_IS;
    h = file_open("EON_Gumbo/pad_looks.txt");
    h >= 0 ? (
      file_text(h) ? (
        k = 0;
        while (file_avail(h) > 0 && k < 4096) (
          file_string(h, #gbf_ln); n = strlen(#gbf_ln);
          while (n > 0 && (str_getchar(#gbf_ln, n - 1) == 10 || str_getchar(#gbf_ln, n - 1) == 13)) ( n -= 1; str_setlen(#gbf_ln, n); );
          cuts = 0; i = 0; p5 = -1;    // six fields, a seventh (an own colour, "rrggbb") since the wheel
          while (i < n && cuts < 6) ( str_getchar(#gbf_ln, i) == '|' ? ( cuts == 0 ? p0 = i : cuts == 1 ? p1 = i : cuts == 2 ? p2 = i : cuts == 3 ? p3 = i : cuts == 4 ? p4 = i : p5 = i; cuts += 1; ); i += 1; );
          cuts >= 5 && gbf_look_same(e, p0) ? (
            gbf_idx_field(p0 + 1, p1); sec = 0; match("%d", #gbf_fld, sec);
            gbf_idx_field(p1 + 1, p2); prog = 0; match("%d", #gbf_fld, prog);
            gbf_idx_field(p2 + 1, p3); note = -1; match("%d", #gbf_fld, note);
            sec == gbf_pg_sec && prog == gbf_pg_p && note >= 0 && note <= 127 ? (
              gbf_idx_field(p3 + 1, p4); ic = -1; c = 0;
              strlen(#gbf_fld) > 0 ? loop(GBF_PAD_NICON, ic < 0 && stricmp(#gbf_fld, gbf_pad_icon_name(c)) == 0 ? ic = c; c += 1; );
              gbf_idx_field(p4 + 1, p5 >= 0 ? p5 : n); fam = -1; match("%d", #gbf_fld, fam);
              col = -1; p5 >= 0 ? ( gbf_idx_field(p5 + 1, n); col = gbf_hex_col(); );
              GBF_PLOOK[note * 3] = ic; GBF_PLOOK[note * 3 + 1] = fam >= 0 && fam <= 6 ? fam : -1; GBF_PLOOK[note * 3 + 2] = col;
            );
          );
          k += 1;
        );
      );
      file_close(h);
    );
  );
);
// the pad's look to the helper, for pad_looks.txt (4 = not in the library list: nowhere to keep it)
function gbf_look_send(n) local(cur, e, c) (
  cur = gbf_idx_current_cached();
  cur >= 0 ? (
    e = GBF_IDX_BASE + cur * GBF_IS; gbf_idx_str(e, 1);
    c = GBF_PLOOK[n * 3 + 2];
    c >= 0 ? sprintf(#gbf_tmp, "%s|%d|%d|%d|%s|%d|%02x%02x%02x", #gbf_es, gbf_pg_sec, gbf_pg_p, n,
                     GBF_PLOOK[n * 3] >= 0 ? gbf_pad_icon_name(GBF_PLOOK[n * 3]) : "", GBF_PLOOK[n * 3 + 1],
                     floor(c / 65536), floor(c / 256) % 256, c % 256)
           : sprintf(#gbf_tmp, "%s|%d|%d|%d|%s|%d", #gbf_es, gbf_pg_sec, gbf_pg_p, n,
                     GBF_PLOOK[n * 3] >= 0 ? gbf_pad_icon_name(GBF_PLOOK[n * 3]) : "", GBF_PLOOK[n * 3 + 1]);
    gbh_request_look(#gbf_tmp);
  ) : gbh_err = 4;
);
// the pad's colour as drawn (GBF_PCOL, and the key's GBF_KCOL): its own colour when it has one, else its family's
function gbf_pad_colour(n) (
  GBF_PLOOK[n * 3 + 2] >= 0 ? ( gbf_rgb_unpack(GBF_PLOOK[n * 3 + 2]); gbf_pc_r = gbf_cw_r; gbf_pc_g = gbf_cw_g; gbf_pc_b = gbf_cw_b; )
                            : gbf_pad_fcol(GBF_PFAM[n]);
  GBF_PCOL[n * 3] = gbf_pc_r; GBF_PCOL[n * 3 + 1] = gbf_pc_g; GBF_PCOL[n * 3 + 2] = gbf_pc_b;
  GBF_KCOL[n * 3] = gbf_pc_r; GBF_KCOL[n * 3 + 1] = gbf_pc_g; GBF_KCOL[n * 3 + 2] = gbf_pc_b;
);
// a pick in the pad's look picker: icon ic (-1 = automatic), family f (-1 = automatic), an own colour col (packed,
// -1 = none); applied now, sent to the helper when `send` (a drag on the wheel sends once, on release)
function gbf_look_set(n, ic, f, col, send) (
  GBF_PLOOK[n * 3] = ic; GBF_PLOOK[n * 3 + 1] = f; GBF_PLOOK[n * 3 + 2] = col;
  gbf_pad_class(n);
  ic >= 0 ? GBF_PICON[n] = ic; f >= 0 ? GBF_PFAM[n] = f;
  gbf_pad_colour(n);
  send ? gbf_look_send(n);
);

function gbf_match_build() local(i, k, c, e) (
  gbf_q_built != gbf_q_gen ? (
    gbf_q_built = gbf_q_gen;
    #gbf_qp = "*"; k = 0;
    loop(strlen(#gbf_q), c = str_getchar(#gbf_q, k); c != '*' && c != '?' && c != '%' ? ( sprintf(#gbf_ch, "%c", c); strcat(#gbf_qp, #gbf_ch); ); k += 1; );
    strcat(#gbf_qp, "*");
    i = 0;
    loop(gbf_idx_n,
      e = GBF_IDX_BASE + i * GBF_IS; gbf_idx_str(e, 0);
      GBF_MATCH[i] = strlen(#gbf_qp) <= 2 || matchi(#gbf_qp, #gbf_es) || matchi(#gbf_qp, gbf_fam_name(e[0]));
      i += 1;
    );
  );
);
// is entry i in the list now: searching = every match (any family); else its family (or all), favourites only when on
function gbf_listed(i) local(e) (
  e = GBF_IDX_BASE + i * GBF_IS;
  (!gbf_favonly || GBF_FAV[i]) && (strlen(#gbf_q) > 0 ? GBF_MATCH[i] : (gbf_cat < 0 || e[0] == gbf_cat));
);
// one of the loaded bank's programs as a row under the bank's own row (the owner, 2026-11-03: programs picked the way
// instruments are): indented on a guide line, the one playing lit; a click plays it
function gbf_prog_row(j, x, cy, w, rh) local(s, q, on, hot, kit, nx) (
  s = gbf_s; q = GB_PRG + j * 5; on = j == gbf_pg_i; kit = q[0] == gb_drum_sec && gb_drum_sec > 0;
  hot = !gbf_menu_block && gbf_hit(x + 20 * s, cy, w - 26 * s, rh - 2 * s);
  gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 0.45); gfx_rect(x + 13 * s, cy, max(1, s), rh);
  on ? ( gfx_set(gbf_ac_r, gbf_ac_g, gbf_ac_b, 0.14); gfx_rect(x + 20 * s, cy, w - 26 * s, rh - 2 * s);
         gfx_set(gbf_ac_r, gbf_ac_g, gbf_ac_b, 1); gfx_rect(x + 20 * s, cy + 3 * s, 2 * s, rh - 8 * s); )
  : hot ? ( gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, 0.06); gfx_rect(x + 20 * s, cy, w - 26 * s, rh - 2 * s); );
  sprintf(#gbf_tmp, kit ? "KIT %d" : "%d", q[1] + 1);
  gbf_font(max(7, floor(9 * s)), 'b'); on ? gfx_set(gbf_ac_r, gbf_ac_g, gbf_ac_b, 1) : gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 1);
  gfx_measurestr(#gbf_tmp, gbf_tw, gbf_th_);
  gfx_x = x + 28 * s; gfx_y = cy + (rh - 2 * s - gbf_th_) * 0.5; gfx_drawstr(#gbf_tmp);
  nx = x + 28 * s + max(gbf_tw, 20 * s) + 6 * s;
  gb_prog_name(j);
  gbf_font(max(8, floor(10 * s)), on ? 'b' : 0); gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, on ? 1 : 0.85);
  gfx_measurestr(#gb_ls, gbf_tw, gbf_th_);
  gfx_x = nx; gfx_y = cy + (rh - 2 * s - gbf_th_) * 0.5; gfx_drawstr(#gb_ls, 0, x + w - 10 * s, cy + rh);
  // (a variation's bank number used to follow its name, small and dim; dropped on the owner's word, 2026-11-05: "does
  // it help anything?" -- the display's box still says PROGRAM n  BANK b for the one playing)
  lmb_down && hot ? ( lmb_down = 0; gbf_prog_pick(j); );
);
// a GM group's header between a bank's programs in the side list (the owner, 2026-11-05: the categories in the side
// panel; "i thought the categories would be collapsible"): a chevron, the name, how many programs the tile or search
// keeps; a click folds or unfolds it (gbf_pg_open, a bit a group; the playing program's group opens by itself)
GBF_GCNT = 1762100;                  // 17: programs listed under each group now
gbf_pg_og = -1; gbf_hdr_at = -1;     // the one open group (one at a time, so the headers fit the panel), its header's row
function gbf_group_row(g, x, cy, w, rh, open, cnt) local(s, hot, cx, cy2) (
  s = gbf_s;
  hot = !gbf_menu_block && gbf_hit(x + 6 * s, cy, w - 12 * s, rh - 2 * s);
  hot ? ( gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, 0.06); gfx_rect(x + 6 * s, cy, w - 12 * s, rh - 2 * s); );
  gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 0.45); gfx_rect(x + 13 * s, cy, max(1, s), rh);
  // the chevron: down when open, right when closed
  cx = x + 22 * s; cy2 = cy + (rh - 2 * s) * 0.5;
  gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, hot ? 1 : 0.8);
  open ? gfx_triangle(cx - 3 * s, cy2 - 2 * s, cx + 3 * s, cy2 - 2 * s, cx, cy2 + 2 * s)
       : gfx_triangle(cx - 2 * s, cy2 - 3 * s, cx + 2 * s, cy2, cx - 2 * s, cy2 + 3 * s);
  sprintf(#gbf_tmp, "%s  (%d)", gbf_gm_fam(g), cnt);
  gbf_font(max(7, floor(8 * s)), 'b'); gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, hot ? 1 : 0.9);
  gfx_measurestr(#gbf_tmp, gbf_tw, gbf_th_);
  gfx_x = x + 30 * s; gfx_y = cy + (rh - 2 * s - gbf_th_) * 0.5; gfx_drawstr(#gbf_tmp, 0, x + w - 10 * s, cy + rh);
  lmb_down && hot ? ( lmb_down = 0; gbf_pg_og = open ? -1 : g; );
);
function gbf_browser(x, y, w, h) local(s, tw, th, i, j, cx, cy, e, n, ry, rh, hrh, vis, cur, f, ic, iw, ih, yb, sh, sx, sw, pg, pgn, pgr, k, g, lg, qall, hdrs) (
  s = gbf_s;
  gfx_set(gbf_pn_r * 0.92, gbf_pn_g * 0.92, gbf_pn_b * 0.92, 1); gfx_rect(x, y, w, h);
  gfx_set(gbf_bd_r, gbf_bd_g, gbf_bd_b, 1); gfx_rect(x + w - 1, y, 1, h);
  // family tiles: 4 x 3
  tw = (w - 16 * s - 3 * 4 * s) / 4; th = max(30 * s, min(46 * s, tw * 0.9));
  i = 0;
  loop(GBF_NFAM,
    cx = x + 8 * s + (i % 4) * (tw + 4 * s); cy = y + 8 * s + ((i / 4) | 0) * (th + 4 * s);
    gbf_fam_col(i);
    gfx_set(i == gbf_cat ? gbf_fc_r * 0.35 + gbf_pn_r * 0.65 : gbf_pn_r * 1.25, i == gbf_cat ? gbf_fc_g * 0.35 + gbf_pn_g * 0.65 : gbf_pn_g * 1.25,
            i == gbf_cat ? gbf_fc_b * 0.35 + gbf_pn_b * 0.65 : gbf_pn_b * 1.25, 1);
    gfx_rect(cx, cy, tw, th);
    gfx_set(gbf_fc_r, gbf_fc_g, gbf_fc_b, 1); gfx_rect(cx, cy + th - 2 * s, tw, 2 * s);
    i == gbf_cat ? ( gfx_set(gbf_fc_r, gbf_fc_g, gbf_fc_b, 1); gbf_box(cx, cy, tw, th); );
    // the icon (the EON track icons), else nothing
    gfx_getimgdim(GBF_ICON_SLOT + i, iw, ih);
    iw > 0 ? ( ic = min(th * 0.48, 22 * s); gfx_x = cx + (tw - ic) * 0.5; gfx_y = cy + 4 * s; gfx_a = 0.9;
               gfx_blit(GBF_ICON_SLOT + i, ic / iw, 0); gfx_a = 1; );
    gbf_font(max(7, floor(9 * s)), 'b'); gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, i == gbf_cat ? 1 : 0.85);
    gfx_measurestr(gbf_fam_name(i), gbf_tw, gbf_th_); gfx_x = cx + (tw - gbf_tw) * 0.5; gfx_y = cy + th - gbf_th_ - 4 * s;
    gfx_drawstr(gbf_fam_name(i));
    lmb_down && !gbf_menu_block && gbf_hit(cx, cy, tw, th) ? ( gbf_cat = gbf_cat == i ? -1 : i; gbf_scroll = 0; );
    i += 1;
  );
  // the search box and the favourites switch (the owner's plan: Swing's filter box, rk_textin; a star per row)
  ry = y + 8 * s + 3 * (th + 4 * s) + 6 * s;
  sh = max(20 * s, 10 * s * gbf_tk + 8 * s); sx = x + 8 * s; sw = w - 16 * s - sh - 4 * s;
  lmb_down && !gbf_menu_block ? (
    rk_textin_click(sx, ry, sw, sh, is_embedded);
    gbf_hit(sx + sw + 4 * s, ry, sh, sh) ? ( gbf_favonly = !gbf_favonly; gbf_scroll = 0; );
  );
  rk_ti_focus && !rkm_on ? ( rk_textin_keys(#gbf_q, gfx_getchar()) ? ( gbf_q_gen += 1; gbf_scroll = 0; ); );
  gbf_font(max(8, floor(10 * s)), 0);
  rk_textin_draw(#gbf_q, sx, ry, sw, sh, is_embedded ? "Search" : "Search all instruments", s, gbf_tx_r, gbf_tx_g, gbf_tx_b,
                 gbf_pn_r * 0.6, gbf_pn_g * 0.6, gbf_pn_b * 0.6, gbf_ac_r, gbf_ac_g, gbf_ac_b);
  gfx_set(gbf_favonly ? gbf_ac_r : gbf_pn_r * 1.3, gbf_favonly ? gbf_ac_g : gbf_pn_g * 1.3, gbf_favonly ? gbf_ac_b : gbf_pn_b * 1.3, 1);
  gfx_rect(sx + sw + 4 * s, ry, sh, sh);
  gbf_favonly ? gfx_set(gbf_bg_r, gbf_bg_g, gbf_bg_b, 1) : gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, 0.8);
  gbf_star(sx + sw + 4 * s + sh * 0.5, ry + sh * 0.52, sh * 0.32, 1);
  gbf_match_build();
  ry += sh + 6 * s;
  // the list: the family's instruments (all of them when no family is picked; every match while searching)
  gbf_font(max(8, floor(10 * s)), 'b'); gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 1);
  gfx_x = x + 10 * s; gfx_y = ry;
  gfx_drawstr(strlen(#gbf_q) > 0 ? "SEARCH" : gbf_favonly && gbf_cat < 0 ? "FAVOURITES" : gbf_cat >= 0 ? gbf_fam_name(gbf_cat) : "ALL INSTRUMENTS");
  ry += 6 * s + 10 * s * gbf_tk; rh = max(24 * s, 11 * s * gbf_tk + 10 * s); vis = max(1, ((y + h - ry - 22 * s) / rh) | 0);
  cur = gbf_idx_current_cached();
  // a loaded bank's programs list under its row (gbf_prog_row): those the picked tile files (GBF_PGFAM) or the search
  // matches, every one with no tile; a GM group's label where the group changes (not while searching). The bank's own
  // row shows whenever one of them does (the owner, 2026-11-05: the categories for the GM library)
  pg = cur >= 0 && gb_ready && gb_nprg > 1 && (!gbf_favonly || GBF_FAV[cur]) ? gb_nprg : 0;
  pgn = 0; pgr = 0;                  // programs the filter keeps; the rows they take (group headers; only the open group's programs)
  hrh = floor(rh * 0.72);            // a group header's row, shorter than an instrument's: the 17 headers fit a window
  // a search that hits the bank's own name ("gm" -> Gumbo GM) lists it whole, groups and all, as with no search (the
  // owner, 2026-11-05: "what happened to all the categories?"); one that does not lists the programs it hits, flat
  qall = pg > 0 && strlen(#gbf_q) > 0 && GBF_MATCH[cur];
  hdrs = strlen(#gbf_q) == 0 || qall;
  pg > 0 ? (
    gbf_prog_cur(); gbf_pg_order(); gbf_pg_match_build();
    g = 0; loop(17, GBF_GCNT[g] = 0; g += 1; );
    j = 0; loop(pg, k = GBF_PGORD[j]; qall || gbf_pg_shown(k) ? ( pgn += 1; GBF_GCNT[gbf_pg_group(k)] += 1; ); j += 1; );
    !hdrs ? pgr = pgn                // a search of program names: every match, no headers
    : ( g = 0; loop(17, GBF_GCNT[g] > 0 ? ( pgr += 1; g == gbf_pg_og ? pgr += GBF_GCNT[g]; ); g += 1; ); );
  );
  n = pgr; i = 0; loop(gbf_idx_n, gbf_listed(i) || (i == cur && pgn > 0) ? n += 1; i += 1; );
  gbf_hit(x, ry, w, h - (ry - y)) && frame_wheel != 0 ? gbf_scroll -= frame_wheel;
  gbf_scroll = max(0, min(gbf_scroll, n - vis));   // the wheel stops at the end of the list (vis counts full rows)
  n = 0; i = 0; gbf_pg_at = -1; gbf_hdr_at = -1; cy = ry; yb = y + h - 22 * s;   // rows stack from ry down to yb
  loop(gbf_idx_n,
    e = GBF_IDX_BASE + i * GBF_IS;
    gbf_listed(i) || (i == cur && pgn > 0) ? (
      n >= gbf_scroll && cy + rh <= yb ? (
        i == cur ? ( gfx_set(gbf_ac_r, gbf_ac_g, gbf_ac_b, 0.22); gfx_rect(x + 6 * s, cy, w - 12 * s, rh - 2 * s);
                     gfx_set(gbf_ac_r, gbf_ac_g, gbf_ac_b, 1); gfx_rect(x + 6 * s, cy, 3 * s, rh - 2 * s); )
        : gbf_hit(x + 6 * s, cy, w - 12 * s, rh - 2 * s) ? ( gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, 0.06); gfx_rect(x + 6 * s, cy, w - 12 * s, rh - 2 * s); );
        gbf_idx_str(e, 0);
        gbf_font(max(8, floor(11 * s)), 0); gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, 1);
        gfx_x = x + 14 * s; gfx_y = cy + (rh - 2 * s - 11 * s) * 0.5; gfx_drawstr(#gbf_es, 0, x + w - 60 * s, cy + rh);
        sprintf(#gbf_tmp, "%.0f MB", e[1]);
        gbf_font(max(7, floor(9 * s)), 0); gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 1);
        gfx_measurestr(#gbf_tmp, gbf_tw, gbf_th_); gfx_x = x + w - 30 * s - gbf_tw; gfx_y = cy + (rh - 2 * s - gbf_th_) * 0.5; gfx_drawstr(#gbf_tmp);
        // its star: lit for a favourite, a faint outline on the row under the mouse; a click on it stars / unstars
        f = gbf_hit(x + w - 26 * s, cy, 20 * s, rh - 2 * s);
        GBF_FAV[i] ? gfx_set(gbf_ac_r, gbf_ac_g, gbf_ac_b, 1) : gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, f ? 0.7 : gbf_hit(x + 6 * s, cy, w - 12 * s, rh - 2 * s) ? 0.25 : 0);
        gbf_star(x + w - 16 * s, cy + (rh - 2 * s) * 0.52, 5.5 * s, GBF_FAV[i]);
        lmb_down && !gbf_menu_block && f ? (
          // shown only when the helper's mailbox takes it (busy with another request: the star stays as it was)
          lmb_down = 0; gbf_idx_str(e, 1); gbh_request_fav(#gbf_es) ? ( GBF_FAV[i] = !GBF_FAV[i]; gbf_q_gen += 1; );
        );
        // a click on the instrument already loaded (or loading) does nothing; after a failed load it tries again
        lmb_down && !gbf_menu_block && gbf_hit(x + 6 * s, cy, w - 12 * s, rh - 2 * s) && (i != cur || gb_job == GB_J_FAILED) ? gbf_load_entry(i);
        cy += rh;
      );
      n += 1;
      i == cur && pgn > 0 ? (
        j = 0; lg = -1;                // in menu order: each variation beside its main program
        loop(pg,
          k = GBF_PGORD[j];
          qall || gbf_pg_shown(k) ? (
            g = gbf_pg_group(k);
            hdrs && g != lg ? (
              g == gbf_pg_og ? gbf_hdr_at = n;   // the open group's header row (a pick scrolls to it)
              n >= gbf_scroll && cy + hrh <= yb ? ( gbf_group_row(g, x, cy, w, hrh, g == gbf_pg_og, GBF_GCNT[g]); cy += hrh; );
              n += 1; lg = g;
            );
            !hdrs || g == gbf_pg_og ? (   // one group open at a time; the others keep their programs folded
              k == gbf_pg_i ? gbf_pg_at = n;   // where the playing program sits (the list follows a pick, below)
              n >= gbf_scroll && cy + rh <= yb ? ( gbf_prog_row(k, x, cy, w, rh); cy += rh; );
              n += 1;
            );
          );
          j += 1;
        );
      );
    );
    i += 1;
  );
  // the list follows a program picked elsewhere (the menu, the < > steps, MIDI): once per pick, its group opened
  // (next pass: its rows are placed), then, when the program is out of view, scrolled so its group's header leads
  // and the program shows (the owner, 2026-11-05: "it doesn't go to the actual instrument I select")
  gbf_pg_i != gbf_pg_followed && gbf_pg_i >= 0 && pg > 0 ? (
    g = gbf_pg_group(gbf_pg_i);
    gbf_pg_og != g && hdrs ? gbf_pg_og = g
    : (
      gbf_pg_followed = gbf_pg_i;
      gbf_pg_at >= 0 && (gbf_pg_at < gbf_scroll || gbf_pg_at >= gbf_scroll + vis) ?
        gbf_scroll = max(0, max(gbf_hdr_at >= 0 ? gbf_hdr_at : 0, gbf_pg_at - vis + 2));
    );
  );
  // no list at all = no sound package installed (ReaPack has no dependencies, so Gumbo says where the sounds are)
  gbf_idx_n == 0 ? ( gbf_font(max(8, floor(10 * s)), 0); gfx_set(gbf_tx_r, gbf_tx_g, gbf_tx_b, 1);
                     gfx_measurestr("A", gbf_tw, gbf_th_); yb = y + h - 20 * s;
                     gbf_hint_line("No sounds installed yet.", 0, x, w, ry, yb);
                     gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 1);
                     gbf_hint_line("Get them free in ReaPack:", 1.6, x, w, ry, yb);
                     gbf_hint_line("Extensions > ReaPack >", 2.7, x, w, ry, yb);
                     gbf_hint_line("Browse packages >", 3.8, x, w, ry, yb);
                     gbf_hint_line("'Gumbo GM sounds'", 4.9, x, w, ry, yb); );
  strcpy(#gbf_tmp, gbh_running ? "OR DROP AN .SFZ, .SF2, .SF3 OR .GUMBO.TXT HERE" : "OR DROP A .GUMBO.TXT  (.SFZ, .SF2, .SF3: START THE GUMBO HELPER)");
  gbf_fit(#gbf_tmp, w - 16 * s, max(7, floor(9 * s)), 'b');
  gbf_tw > w - 16 * s ? ( strcpy(#gbf_tmp, gbh_running ? "OR DROP AN .SFZ OR A SOUNDFONT HERE" : "OR DROP A .GUMBO.TXT HERE"); gbf_fit(#gbf_tmp, w - 16 * s, max(7, floor(9 * s)), 'b'); );
  gfx_set(gbf_td_r, gbf_td_g, gbf_td_b, 1);
  gfx_x = x + 10 * s; gfx_y = y + h - 6 * s - gbf_th_;
  gfx_drawstr(#gbf_tmp, 0, x + w - 6 * s, y + h);
);
// step through the family of the loaded instrument (or the list) by d
function gbf_step(d) local(cur, fam, i, k, e) (
  cur = gbf_idx_current_cached(); fam = cur >= 0 ? (GBF_IDX_BASE + cur * GBF_IS)[0] : gbf_cat;
  i = cur >= 0 ? cur : d > 0 ? -1 : 0;   // nothing loaded: > starts at the first, < at the last
  k = 0;
  while (k < gbf_idx_n) (
    i = (i + d + gbf_idx_n) % gbf_idx_n; e = GBF_IDX_BASE + i * GBF_IS;
    i != cur && (fam < 0 || e[0] == fam) ? ( gbf_load_entry(i); k = gbf_idx_n; );   // alone in its family: no reload
    k += 1;
  );
);

// (the window, the strip face and the @gfx pass live in gb_face_p2.jsfx-inc, after the pages they call)
