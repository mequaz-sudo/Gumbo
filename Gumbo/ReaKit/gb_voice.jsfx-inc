// gb_voice.jsfx-inc -- Gumbo: MIDI in, voices out. Runs on the audio thread only: gb_midi_block() and
// gb_voices_block() from @block, gb_render() from @sample. Reads the region / sample tables gb_sfz + gb_load fill,
// and only while gb_ready is 1 AND this load (gb_load_gen) was adopted by @block (gb_on_ready cleared the voices).
// Rules: .docs/refs/SFZ_As_Gumbo_Reads_It_2026-10-30.md. Modelled on Swing's voices (launch, 4-point interpolation
// Swing_ReaKit.jsfx:7253-7293, steal-to-fade slots rk_swing_core_p4:43-83), written fresh: no Swing code shared.
//   * a note-on scans every region (key, velocity, random, CC gates, keyswitch, round robin) and starts a voice for
//     each match; group/off_by chokes; polyphony and note_polyphony limits; *silence regions only choke
//   * envelope: delay, attack (linear), hold, decay and release (exponential to -60 dB in the given time), sustain
//   * loops: loop_continuous loops through the release, loop_sustain until note-off; one_shot ignores note-off
//   * sustain pedal (CC64): held voices wait for the pedal; trigger=release regions fire on note-off or pedal-up at the
//     note-on's velocity, quieter by rt_decay dB per second held; release_key ignores the pedal
//   * pitch bend +-2 semitones; CC7 / CC11 scale the part; CC120 cuts, CC123 releases the part (CHANNELS below)
// Timing: note-ons, note-offs and pedal-ups land on their own sample (midirecv's offset); other CCs at the start of
// their block; CC gates are checked at note-on.
// CHANNELS (2026-11-05, outside audit of 1.1.0): a bank (gb_nprg > 0) keeps each MIDI channel apart -- its own held
// notes, controllers (sustain pedal, volume, expression, the mod wheel...), pitch bend, glide and all-notes-off -- in
// "part" s = the channel (gb_part_of). An ordinary instrument plays every channel as one part (part 0, omni, as
// sfizz does), so a pedal or a knob on another channel than the keys still works. Each voice keeps its part
// (GBV_PART); gb_part / gb_cc / gb_ptab point at the part a MIDI event is for (gb_part_sel), audio thread only.

@init
GB_VOI = 1600000; GB_VS = 124;         // 68 slots x 124 = 8432 cells -> 1608432, under GB_NTP (124 since 2026-11-05: the pitch envelope at 107..115)
GB_MAXV = 64;                        // playing voices
GB_FADES = 4;                        // extra slots a stolen voice fades out in
// (1620000 .. 1686000 was free: gb_sfz's note)
GB_NTP = 1620000; GB_NTS = 640;      // 16 parts x 640: per note +0 held, +128 velocity, +256 note-on time,
                                     // +384 waiting for pedal-up, +512 its channel -> 1630240
GB_NTA = 1631000;                    // 128: how many parts hold each note (the face's lit keys and pads)
GB_CCP = 1632000;                    // 16 parts x 128 controller values -> 1634048
gb_cc0 = GB_CCP;                     // part 0's, fixed: the face reads this one (gb_cc moves on the audio thread)
gb_cc = GB_CCP; gb_ptab = GB_NTP; gb_part = 0;   // (gb_ptab, not gb_nt: EEL2 names ignore case, GB_NT)
GB_BND = 1634100;                    // 16: each part's pitch bend in semitones
GB_HELD = 1634120;                   // 16: each part's held notes (keyswitch keys not counted)
GB_GLAST = 1634140;                  // 16: each part's last note, for glide (-1 = none)
GB_CHG = 1634160;                    // 16: each part's volume x expression gain (CC7, CC11)
GB_CV7 = 1634180; GB_CV11 = 1634200; // 16 each: the part's last CC7 / CC11 from MIDI (127 at each load, as before:
                                     // a file's set_cc7 never set the level)
// the bend range (2026-11-05, formats round 2 item C): GB_BNDR = each part's raw bend -1..1; GB_BRNG = the range RPN 0
// set on the part (cents; -1 = none received: the SETTINGS knob rules; 0 = the file asked for NO bend); GB_RPNM /
// GB_RPNL = the RPN selected by CC101 / CC100 (127 = none). A region's own bend_up / bend_down (GBR_BUP / BDN) win
GB_BNDR = 1634220; GB_BRNG = 1634240; GB_RPNM = 1634260; GB_RPNL = 1634280;   // 16 each -> 1634296
// each MIDI channel's program (2026-11-05, variation banks): the section it plays (GB_CHSC) beside its program
// (gb_sfz's GB_CHPG, 0..127), and the raw MIDI that picked it -- CC0 (bank select, GS: CC32 ignored), the last
// program change, and whether one came while a load ran (applied once the new instrument is adopted)
GB_CHSC = 1656800; GB_CHB0 = 1656820; GB_CHMP = 1656840; GB_CHLD = 1656860;   // 16 each -> 1656876
memset(GB_CHB0, 0, 16); memset(GB_CHMP, 0, 16); memset(GB_CHLD, 0, 16);
GBV_PART = 105; GBV_CG = 106;        // a voice's part, and its part gain now (glides to GB_CHG)
GBV_ON = 0; GBV_REG = 1; GBV_NOTE = 2; GBV_POS = 3; GBV_SEMI = 4; GBV_RATIO = 5; GBV_INC = 6; GBV_GL = 7; GBV_GR = 8;
GBV_ST = 9; GBV_ENV = 10; GBV_CNT = 11; GBV_AINC = 12; GBV_DCOEF = 13; GBV_SUSL = 14; GBV_RCOEF = 15; GBV_FCOEF = 16;
GBV_RELD = 17; GBV_PEDAL = 18; GBV_PTR = 19; GBV_NCH = 20; GBV_LAST = 21; GBV_LMODE = 22; GBV_LS = 23; GBV_LE = 24;
GBV_AGE = 25; GBV_DLY = 26; GBV_GROUP = 27; GBV_OFFBY = 28; GBV_HOLDN = 29; GBV_OFFMODE = 30; GBV_TRIG = 31;
GBV_RELIN = 32;                      // > 0: release this many samples (+1) into the block (a note-off with an offset)
// format 2, live controllers: the voice's level before them, its region pan, the left/right gains they aim at (the
// render glides GL/GR there, so a moving controller never clicks), their pitch in cents, and how many it has
GBV_BLIN = 33; GBV_BPAN = 34; GBV_TGL = 35; GBV_TGR = 36; GBV_MCENT = 37; GBV_MODS = 38;
GBV_GLS = 39;                        // glide: semitones still to slide (0 = at pitch)
// the tone filter, its envelope and the LFOs (2026-11-03; the region's GBR_FTYPE ..): set at launch (gb_shape_launch),
// moved per block by the controllers (gb_shape_block), run per sample (gb_shape_tick)
GBV_SHP = 40;                        // 1 = the region has a filter / filter envelope / LFO
GBV_FT = 41; GBV_FK = 42;            // filter type (GBR_FTYPE), k = 1 / Q
GBV_FC = 43; GBV_FCB = 44;           // cutoff in absolute cents (8.176 Hz = 0): the note's own, + its controller (per block)
GBV_S1L = 45; GBV_S2L = 46; GBV_S1R = 47; GBV_S2R = 48;   // filter state, first stage
GBV_T1L = 49; GBV_T2L = 50; GBV_T1R = 51; GBV_T2R = 52;   // second stage (4-pole)
GBV_EGD = 53; GBV_EGE = 54; GBV_EGST = 55; GBV_EGCNT = 56; // filter envelope: depth cents, value, stage, counter
GBV_EGAI = 57; GBV_EGDC = 58; GBV_EGSL = 59; GBV_EGRC = 60; GBV_EGHN = 61;   // attack step, decay / release coefs, sustain, hold
GBV_LFO = 62; GBV_LFS = 5;           // 3 LFOs x 5: phase, step, delay left (samples), fade gain, fade step
GBV_PLD = 77; GBV_ALD = 78; GBV_FLD = 79;   // LFO depths now (pitch cents, amp dB, filter cents; per block)
// a packed instrument (gb_load, 2026-11-04): the voice's cache of GBV_PKN cells unpacked from cell GBV_PKQ on
// (-1 = empty; emptied at every launch, so a voice never reads another sample's or another load's points)
GBV_PKQ = 80; GBV_PKC = 81; GBV_PKN = 8;    // 81 .. 104: 8 cells x 3 points
// the pitch envelope (2026-11-05, formats round 2 item A): nine cells in the filter envelope's order (depth, value,
// stage, counter, attack step, decay coef, sustain, release coef, hold samples), so gb_eg_launch / gb_eg_tick run
// either from its first cell. Depth in cents; the voice's rate takes 2^(value x depth / 1200) (gb_ratio)
GBV_PEGD = 107; GBV_PEGE = 108; GBV_PEGST = 109; GBV_PEGCNT = 110; GBV_PEGAI = 111; GBV_PEGDC = 112; GBV_PEGSL = 113; GBV_PEGRC = 114; GBV_PEGHN = 115;
GBV_BUP = 116; GBV_BDN = 117;        // the region's bend range in cents (up, down; both 0 = the part's RPN range, else the knob)
GBV_VEL = 118;                       // the note's velocity (the release re-read at the let-go needs it, gb_release_time)
// the per-sample lookups (no exp / tan / pow in @sample): the filter's g = tan(pi f / srate) by cent, a pitch ratio
// by cent, a gain by tenth of a dB. Built in @init (it runs again when the sample rate changes).
GB_LKG = 200000; GB_LKG_C0 = -3700; GB_LKG_ST = 2; GB_LKG_N = 8651;   // -3700 .. 13600 cents (about 1 Hz .. 21 kHz)
GB_LKR = 210000; GB_LKR_C0 = -2400; GB_LKR_N = 4801;                 // -2400 .. 2400 cents, 1 a cell
GB_LKA = 216000; GB_LKA_D0 = -100; GB_LKA_N = 1241;                  // -100 .. +24 dB, 0.1 a cell
function gb_tables_build() local(i, f) (
  i = 0;
  loop(GB_LKG_N,
    f = min(min(20000, 0.49 * srate), 8.175799 * 2 ^ ((GB_LKG_C0 + i * GB_LKG_ST) / 1200));
    GB_LKG[i] = tan($pi * f / srate); i += 1;
  );
  i = 0; loop(GB_LKR_N, GB_LKR[i] = 2 ^ ((GB_LKR_C0 + i) / 1200); i += 1; );
  i = 0; loop(GB_LKA_N, GB_LKA[i] = 10 ^ ((GB_LKA_D0 + i * 0.1) / 20); i += 1; );
  i = 0; loop(GB_OCT_N, GB_OCT[i] = 2 ^ (i - 12); i += 1; );
);
// whole octaves for gb_ratio (a pitch envelope may ask +-12000 cents, past GB_LKR's +-2400), and the two envelopes'
// region cells by name: GB_EGF = the filter envelope's (gb_sfz GBR_EGD.., scattered), GB_EGP = the pitch envelope's
// (GBR_PEGD.., in a row), eleven each in the order depth, delay, attack, hold, decay, sustain, release, vel2depth,
// vel2attack, vel2decay, vel2release (2026-11-05)
GB_OCT = 215000; GB_OCT_N = 25;      // 2^-12 .. 2^12 -> 215025
GB_EGF = 215100; GB_EGP = 215120;    // 11 each -> 215131 (under GB_LKA 216000)
GB_EMS = 215140;                     // 6: a note's controller-driven envelope offsets (gb_env_mods; @block only) -> 215146
GB_EGF[0] = GBR_EGD; GB_EGF[1] = GBR_EGDLY; GB_EGF[2] = GBR_EGATT; GB_EGF[3] = GBR_EGHOLD; GB_EGF[4] = GBR_EGDEC; GB_EGF[5] = GBR_EGSUS;
GB_EGF[6] = GBR_EGREL; GB_EGF[7] = GBR_EGVD; GB_EGF[8] = GBR_EGVA; GB_EGF[9] = GBR_EGVDC; GB_EGF[10] = GBR_EGVR;
GB_EGP[0] = GBR_PEGD; GB_EGP[1] = GBR_PEGDLY; GB_EGP[2] = GBR_PEGATT; GB_EGP[3] = GBR_PEGHOLD; GB_EGP[4] = GBR_PEGDEC; GB_EGP[5] = GBR_PEGSUS;
GB_EGP[6] = GBR_PEGREL; GB_EGP[7] = GBR_PEGVD; GB_EGP[8] = GBR_PEGVA; GB_EGP[9] = GBR_PEGVDC; GB_EGP[10] = GBR_PEGVR;
gb_tables_build(); gb_tab_sr = srate;
GB_MOD_GLIDE = 0.004;                // per sample: about 5 ms at 48 kHz
GB_ST_ATT = 1; GB_ST_HOLD = 2; GB_ST_DEC = 3; GB_ST_SUS = 4; GB_ST_REL = 5; GB_ST_FADE = 6;
GB_QUIET_T = 0.0001;                 // envelope level a releasing voice ends at (-80 dB)
gb_vhi = 0; gb_age = 0; gb_t = 0; gb_gen_seen = -1;
// gb_bend = part 0's bend (the face's wheel shows it); gb_bend_dirty: a part's bend moved (voices re-pitched per block)
gb_bend = 0; gb_bend_dirty = 0; gb_tune_last = 0;
// the SETTINGS page and the SOUND page's GLIDE / PAN, set by the host each @block from its sliders: voices at most,
// pitch-bend range in semitones, glide time in seconds (0 = off), mono (one note at a time), the output pan -100..100
gb_vmax = GB_MAXV; gb_bend_rng = 2; gb_glide = 0; gb_mono = 0; gb_pan = 0;
gb_launch_gl = 0; gb_pl = gb_pr = gb_pl_s = gb_pr_s = 1;
// the face's CONTROLS page turning a knob: controller gb_ui_cc_n to gb_ui_cc_v, applied once per gb_ui_cc_seq
gb_ui_cc_seq = gb_ui_cc_done = 0; gb_ui_cc_n = 1; gb_ui_cc_v = 0;
// the face's pitch-bend wheel: gb_ui_bend_v (0..16383, 8192 centre), applied once per gb_ui_bend_seq (value first, the
// counter last), as a MIDI bend would be (gb_bend_in)
gb_ui_bend_seq = gb_ui_bend_done = 0; gb_ui_bend_v = 8192;
gb_gs = 1;
// the face's controls, set by the host each @block from its sliders (never through @slider: wiki 00-rules, a face
// change must reach the sound by itself): TUNE in semitones, RELEASE as a factor, VELOCITY 0..1
gb_tune_st = 0; gb_relx = 1; gb_vsens = 1;
// TONE -1..1 (0 = flat; a tilt in gb_eq), DRIVE 0..1, ATTACK seconds added, WIDTH 0..2 (1 = as recorded); gb_fx_block turns them into
// per-block coefficients (no transcendentals in @sample)
gb_tone = 0; gb_drive = 0; gb_att_add = 0; gb_width = 1; gb_drv_post = 0; gbx_pos_s = 0;
gbx_drv_s = 0; gbx_w_s = 1;
// the face's display reads these (written only by gb_launch, cleared by each new load in gb_on_ready)
gb_last_reg = -1; gb_last_note = -1; gb_last_vel = 0; gb_last_gen = 0;
gb_kb_note = -1; gb_kb_cur = -1;     // the face's keyboard: the note the mouse holds, and the one the audio plays
gb_kb_vel = 100;                     // its velocity (the keyboard 100; a drum pad by where it is struck)

function gb_coef60(sec) ( exp(-6.907755 / (max(sec, 0.0005) * srate)) );   // reach -60 dB in sec seconds
// decay, release and off_time as sfizz runs them (ADSREnvelope.cpp secondsToExpRate, 1.2.3): 9 time constants
// (-78 dB) over the given time, measured equal against sfizz_render (.dev_tests/gumbo_vs_sfizz.py)
function gb_coef_sfz(sec) ( exp(-9 / (max(sec, 0.0005) * srate)) );

// ── the tone filter, its envelope and the LFOs (2026-11-03; the region side: gb_sfz GBR_FTYPE ..) ──
// sfizz's rules (Research .docs/research/Gumbo_Tone_Filter_Research_2026-11-03.md): cutoff x keytrack x veltrack x
// random x a controller, + the filter envelope (linear attack, decay / release as the amp envelope's) + the filter LFO;
// Q = 10^(resonance / 20). The filter is Cytomic's trapezoidal state-variable filter (Andrew Simper's public paper):
// for 2-pole low / high / band / notch it has the response of the RBJ biquads sfizz and FluidSynth use, and it stays
// clean when the cutoff moves every sample. 1-pole = the trapezoidal one-pole; 4-pole = two 2-pole stages.
// the lookups (x between cells: a straight line)
function gb_lkg(c) local(x, i) (
  x = max(0, min(GB_LKG_N - 1.001, (c - GB_LKG_C0) / GB_LKG_ST)); i = x | 0;
  GB_LKG[i] + (GB_LKG[i + 1] - GB_LKG[i]) * (x - i);
);
function gb_lkr(c) local(x, i) ( x = max(0, min(GB_LKR_N - 1.001, c - GB_LKR_C0)); i = x | 0; GB_LKR[i] + (GB_LKR[i + 1] - GB_LKR[i]) * (x - i); );
// 2^(c / 1200) for any c within +-12 octaves: whole octaves from GB_OCT, the rest from gb_lkr (no pow per sample)
function gb_ratio(c) local(o) (
  c = max(-14400, min(14400, c)); o = floor(c / 1200);
  GB_OCT[o + 12] * gb_lkr(c - o * 1200);
);
// one envelope (the filter's or the pitch's) at launch: o = its nine voice cells, t = its eleven region cells by
// index (GB_EGF / GB_EGP), vv = velocity / 127, hs / ds = the key scaling of the hold and the decay (1 = none; the
// mod envelope's keynum generators, gb_shape_launch). The times with their vel2 parts (sfizz: seconds x velocity / 127
// added; below 0 = instant). Depth 0 (after vel2depth) = no envelope: the cells stay as memset left them
function gb_eg_launch(o, r, t, vv, hs, ds) local(at, dc) (
  o[0] = r[t[0]] + r[t[7]] * vv;
  o[0] != 0 ? (
    o[1] = 0; o[3] = (r[t[1]] * srate) | 0; o[2] = o[3] > 0 ? 0 : 1;
    at = r[t[2]] + r[t[8]] * vv; dc = min(101, (r[t[4]] + r[t[9]] * vv) * ds);
    o[4] = at > 0 ? 1 / (at * srate) : 1;
    o[8] = (min(18, r[t[3]] * hs) * srate) | 0; o[6] = r[t[5]];
    o[5] = dc > 0 ? gb_coef_sfz(dc) : 0;
    o[7] = gb_coef_sfz(max(r[t[6]] + r[t[10]] * vv, 0.001));
  );
);
// one sample of an envelope: delay (0), attack (1), hold (2), decay (3), sustain (4); released (5) with the voice,
// from where it is. o[1] = its value 0..1
function gb_eg_tick(o, rel) local(st, e) (
  st = o[2]; e = o[1];
  rel && st < 5 ? st = 5;
  st == 0 ? ( o[3] -= 1; o[3] <= 0 ? st = 1; )
  : st == 1 ? ( e += o[4]; e >= 1 ? ( e = 1; o[8] > 0 ? ( st = 2; o[3] = o[8]; ) : st = 3; ); )
  : st == 2 ? ( o[3] -= 1; o[3] <= 0 ? st = 3; )
  : st == 3 ? ( e *= o[5]; e <= o[6] + 0.001 ? ( e = o[6]; st = 4; ); )
  : st == 5 ? e *= o[7];
  o[1] = e; o[2] = st;
);
function gb_lka(db) local(x, i) ( x = max(0, min(GB_LKA_N - 1.001, (db - GB_LKA_D0) * 10)); i = x | 0; GB_LKA[i] + (GB_LKA[i + 1] - GB_LKA[i]) * (x - i); );
// one 2-pole stage on x; s = its two state cells; mode 0 low, 1 high, 2 band (0 dB peak), 3 notch
function gb_svf(x, s, mode, kk, a1, a2, a3) local(v1, v2, v3) (
  v3 = x - s[1]; v1 = a1 * s[0] + a2 * v3; v2 = s[1] + a2 * s[0] + a3 * v3;
  s[0] = 2 * v1 - s[0]; s[1] = 2 * v2 - s[1];
  mode == 0 ? v2 : mode == 1 ? x - kk * v1 - v2 : mode == 2 ? kk * v1 : x - kk * v1;
);
// the controllers' part, once per block (and at launch): the cutoff's controller, the LFO depths with the mod wheel
function gb_shape_block(v) local(r, l) (
  gb_cc = GB_CCP + v[GBV_PART] * 128;   // its own part's controllers
  r = GB_REG + v[GBV_REG] * GB_RS;
  v[GBV_FCB] = v[GBV_FC] + (r[GBR_FCC] >= 0 ? gb_cc[r[GBR_FCC]] / 127 * r[GBR_FCCD] : 0);
  l = r + GBR_LFO;                 v[GBV_PLD] = l[GBL_DEPTH] + gb_cc[1] / 127 * l[GBL_CCD];
  l = r + GBR_LFO + GBR_LFOS;      v[GBV_ALD] = l[GBL_DEPTH] + gb_cc[1] / 127 * l[GBL_CCD];
  l = r + GBR_LFO + 2 * GBR_LFOS;  v[GBV_FLD] = l[GBL_DEPTH] + gb_cc[1] / 127 * l[GBL_CCD];
  // 1 = something to run per sample, 2 = idle for now (a SoundFont voice: its mod wheel vibrato at 0 costs nothing)
  v[GBV_SHP] = v[GBV_FT] > 0 || v[GBV_EGD] != 0 || v[GBV_PEGD] != 0 || ((r + GBR_LFO)[GBL_ON] && v[GBV_PLD] != 0)
               || ((r + GBR_LFO + GBR_LFOS)[GBL_ON] && v[GBV_ALD] != 0) ? 1 : 2;
);
// a new voice of region r (note n, velocity vel)
function gb_shape_launch(v, r, n, vel) local(k, l, o, vv, ks, hs, ds) (
  v[GBV_SHP] = 1; vv = vel / 127;
  v[GBV_FT] = r[GBR_FTYPE]; v[GBV_FK] = 10 ^ (-r[GBR_FRES] / 20);
  v[GBV_FC] = 1200 * log(r[GBR_FCUT] / 8.175799) / log(2) + r[GBR_FKT] * (n - r[GBR_FKC]) + r[GBR_FVT] * vv
              + (r[GBR_FRND] > 0 ? rand(r[GBR_FRND]) : 0);
  // the mod envelope's key scaling (a SoundFont's keynumToModEnvHold / Decay): both envelopes are that one envelope
  ks = 60 - n;
  hs = r[GBR_KFH] != 0 ? 2 ^ (r[GBR_KFH] * ks / 1200) : 1; ds = r[GBR_KFD] != 0 ? 2 ^ (r[GBR_KFD] * ks / 1200) : 1;
  gb_eg_launch(v + GBV_EGD, r, GB_EGF, vv, hs, ds);    // the filter envelope
  gb_eg_launch(v + GBV_PEGD, r, GB_EGP, vv, hs, ds);   // the pitch envelope
  k = 0;
  loop(3,
    l = r + GBR_LFO + k * GBR_LFOS; o = v + GBV_LFO + k * GBV_LFS;
    l[GBL_ON] ? (
      o[0] = 0; o[1] = l[GBL_FREQ] / srate; o[2] = (l[GBL_DELAY] * srate) | 0;
      l[GBL_FADE] > 0 ? ( o[3] = 0; o[4] = 1 / (l[GBL_FADE] * srate); ) : ( o[3] = 1; o[4] = 0; );
    );
    k += 1;
  );
  gb_shape_block(v);
);
// one sample of a shaped voice: the LFOs and the two envelopes move, gb_yl / gb_yr go through the filter and the
// amp LFO; returns the pitch rate factor of the pitch LFO and the pitch envelope together (1 = none)
function gb_shape_tick(v) local(r, k, l, o, x, y, lv0, lv1, lv2, ft, c, g, kk, a1, a2, a3, md, pm, pc)
(
  r = GB_REG + v[GBV_REG] * GB_RS;
  lv0 = lv1 = lv2 = 0; k = 0;
  loop(3,
    l = r + GBR_LFO + k * GBR_LFOS;
    l[GBL_ON] ? (
      o = v + GBV_LFO + k * GBV_LFS;
      o[2] > 0 ? o[2] -= 1 : (
        x = o[0];
        // sine: sfizz's parabolic one; triangle: the SoundFont's. Both start at 0, rising.
        y = l[GBL_WAVE] ? ( x < 0.25 ? 4 * x : x < 0.75 ? 2 - 4 * x : 4 * x - 4 )
                        : ( x < 0.5 ? 16 * x * (0.5 - x) : -16 * (x - 0.5) * (1 - x) );
        y *= o[3]; o[3] < 1 ? o[3] = min(1, o[3] + o[4]);
        k == 0 ? lv0 = y : k == 1 ? lv1 = y : lv2 = y;
        x += o[1]; x >= 1 ? x -= 1; o[0] = x;
      );
    );
    k += 1;
  );
  // the filter envelope and the pitch envelope (gb_eg_tick): released with the voice, from where they are
  v[GBV_EGD] != 0 ? gb_eg_tick(v + GBV_EGD, v[GBV_ST] >= GB_ST_REL);
  v[GBV_PEGD] != 0 ? gb_eg_tick(v + GBV_PEGD, v[GBV_ST] >= GB_ST_REL);
  ft = v[GBV_FT];
  ft > 0 ? (
    c = v[GBV_FCB] + v[GBV_EGE] * v[GBV_EGD] + lv2 * v[GBV_FLD];
    g = gb_lkg(c);
    ft <= 2 ? (                        // 1-pole: low, or high (the input less the low)
      a1 = g / (1 + g);
      x = (gb_yl - v[GBV_S1L]) * a1; y = x + v[GBV_S1L]; v[GBV_S1L] = y + x; gb_yl = ft == 1 ? y : gb_yl - y;
      v[GBV_NCH] == 1 ? gb_yr = gb_yl : (
        x = (gb_yr - v[GBV_S1R]) * a1; y = x + v[GBV_S1R]; v[GBV_S1R] = y + x; gb_yr = ft == 1 ? y : gb_yr - y;
      );
    ) : (
      kk = v[GBV_FK]; a1 = 1 / (1 + g * (g + kk)); a2 = g * a1; a3 = g * a2;
      md = ft == 3 || ft == 7 ? 0 : ft == 4 || ft == 8 ? 1 : ft == 5 ? 2 : 3;
      gb_yl = gb_svf(gb_yl, v + GBV_S1L, md, kk, a1, a2, a3);
      ft >= 7 ? gb_yl = gb_svf(gb_yl, v + GBV_T1L, md, kk, a1, a2, a3);
      v[GBV_NCH] == 1 ? gb_yr = gb_yl : (
        gb_yr = gb_svf(gb_yr, v + GBV_S1R, md, kk, a1, a2, a3);
        ft >= 7 ? gb_yr = gb_svf(gb_yr, v + GBV_T1R, md, kk, a1, a2, a3);
      );
    );
  );
  lv1 != 0 ? ( y = gb_lka(lv1 * v[GBV_ALD]); gb_yl *= y; gb_yr *= y; );
  // the pitch: the LFO's cents + the envelope's value x depth
  pc = lv0 * v[GBV_PLD] + (v[GBV_PEGD] != 0 ? v[GBV_PEGE] * v[GBV_PEGD] : 0);
  pm = pc != 0 ? gb_ratio(pc) : 1;
  pm;
);

// a voice's playback rate: its own semitones + pitch bend + TUNE + live controllers (cents) + glide still to go.
// The bend's range (2026-11-05): the region's own bend_up / bend_down when it has them, else the range RPN 0 set on the
// part, else the SETTINGS knob (gb_bend_rng semitones, both ways)
function gb_voice_inc(v) local(p, rb, up, dn, rg) (
  p = v[GBV_PART]; rb = GB_BNDR[p]; up = v[GBV_BUP]; dn = v[GBV_BDN];
  up == 0 && dn == 0 ? ( rg = GB_BRNG[p] >= 0 ? GB_BRNG[p] : gb_bend_rng * 100; up = rg; dn = -rg; );
  v[GBV_INC] = 2 ^ ((v[GBV_SEMI] + (rb >= 0 ? rb * up : -rb * dn) * 0.01 + gb_tune_st + v[GBV_MCENT] * 0.01 + v[GBV_GLS]) / 12) * v[GBV_RATIO];
);

// ── format 2: live controllers (types in gumbo_sfz.lua's header) ──
// a controller curve at x 0..1: sfizz's built-ins 0..6, else the file's own (GB_CCVMAP), else straight
function gb_curve(idx, x) local(t, f, i) (
  x = max(0, min(1, x));
  idx == 1 ? -1 + 2 * x : idx == 2 ? 1 - x : idx == 3 ? 1 - 2 * x : idx == 4 ? x * x : idx == 5 ? sqrt(x)
  : idx == 6 ? sqrt(1 - x)
  : idx >= 7 && idx <= 255 && GB_CCVMAP[idx | 0] > 0 ? (
    t = GB_CCV + (GB_CCVMAP[idx | 0] - 1) * 128; f = x * 127; i = f | 0;
    i >= 127 ? t[127] : t[i] + (t[i + 1] - t[i]) * (f - i);
  ) : x;
);
// a crossfade's gain at value t between lo and hi (in rises 0 -> 1, out falls 1 -> 0); power curve unless straight
function gb_xf(t, lo, hi, out, straight) local(p) (
  p = hi > lo ? max(0, min(1, (t - lo) / (hi - lo))) : t >= hi;
  out ? p = 1 - p;
  straight ? p : sqrt(p);
);
// the note-time part (velocity and key crossfades), as one factor for the voice's level at its start
function gb_mod_note(ri, n, vel) local(m, k, t, g) (
  g = 1; k = 0;
  loop((GB_REG + ri * GB_RS)[GBR_NMOD],
    m = GB_MOD + ri * GB_MODS + k * 4; t = m[0] % 100;
    t == 7 || t == 8 ? g *= gb_xf(vel, m[2], m[3], t == 8, m[0] >= 100)
    : t == 9 || t == 10 ? g *= gb_xf(n, m[2], m[3], t == 10, m[0] >= 100);
    k += 1;
  );
  g;
);
// the live part (controllers), for voice v: its target gains and pitch from the controllers' values now
function gb_voice_mod(v) local(ri, m, k, t, x, c, g, db, pan, cent) (
  gb_cc = GB_CCP + v[GBV_PART] * 128;   // its own part's controllers
  ri = v[GBV_REG]; g = 1; db = 0; pan = v[GBV_BPAN]; cent = 0; k = 0;
  loop((GB_REG + ri * GB_RS)[GBR_NMOD],
    m = GB_MOD + ri * GB_MODS + k * 4; t = m[0] % 100;
    t <= 6 ? (
      x = gb_cc[m[1]] / 127;
      t == 5 || t == 6 ? g *= gb_xf(gb_cc[m[1]], m[2], m[3], t == 6, m[0] >= 100)
      : ( c = gb_curve(m[3], x);
          t == 1 ? g *= max(0, m[2] * 0.01 * c) : t == 2 ? db += m[2] * c : t == 3 ? pan += m[2] * c : cent += m[2] * c; );
    );
    k += 1;
  );
  g *= v[GBV_BLIN] * 10 ^ (db / 20);
  pan = (max(-100, min(100, pan)) + 100) * 0.005 * $pi * 0.5;
  v[GBV_TGL] = g * 1.41421356 * cos(pan); v[GBV_TGR] = g * 1.41421356 * sin(pan);
  cent != v[GBV_MCENT] ? (
    v[GBV_MCENT] = cent;
    gb_voice_inc(v);
  );
);

// the amp envelope's controller-driven times (mod types 11..16, 2026-11-05): region ri's offsets from the current
// part's controllers now, into GB_EMS (delay, attack, hold, decay, sustain %, release) -- read when a note starts
function gb_env_mods(ri) local(k, m, t) (
  memset(GB_EMS, 0, 6); k = 0;
  loop((GB_REG + ri * GB_RS)[GBR_NMOD],
    m = GB_MOD + ri * GB_MODS + k * 4; t = m[0] % 100;
    t >= 11 && t <= 16 ? GB_EMS[t - 11] += gb_curve(m[3], gb_cc[m[1]] / 127) * m[2];
    k += 1;
  );
);
// the release time again at the let-go, from its controller as it stands then (a RELEASE knob turned while a chord
// is held applies to that chord); only a region with a release mod pays for it. @block only (exp)
function gb_release_time(v) local(ri, r, k, m, cc0, has, vv) (
  ri = v[GBV_REG]; r = GB_REG + ri * GB_RS; has = 0; k = 0;
  loop(r[GBR_NMOD], (GB_MOD + ri * GB_MODS + k * 4)[0] % 100 == 16 ? has = 1; k += 1; );
  has ? (
    cc0 = gb_cc; gb_cc = GB_CCP + v[GBV_PART] * 128;   // its own part's controllers (the caller's pointer kept)
    gb_env_mods(ri); gb_cc = cc0; vv = v[GBV_VEL] / 127;
    v[GBV_RCOEF] = gb_coef_sfz(max(max(r[GBR_REL] + r[GBR_VREL] * vv + GB_EMS[5], 0.001) * gb_relx, 0.001));
  );
);

function gb_all_off() local(i) (
  i = 0; loop(GB_MAXV + GB_FADES, GB_VOI[i * GB_VS + GBV_ON] = 0; i += 1; );
  gb_vhi = 0;
);

// a fresh instrument: controllers from the file, no notes, keyswitch range and default
// ── a bank (format 3, 2026-11-02): each MIDI channel plays its program (GB_CHPG: 0..127 melodic, 128 + p = drum kit
// p). A program change sets its channel's; channel 10 starts on the first kit. The face's PROGRAM pick (slider 89,
// gb_prog_apply) sets every channel. gb_sel(ch) -> the section and program a note on ch plays (gb_ssec, gb_sprog);
// a region with no program (section 0) plays always, so an ordinary instrument is unchanged.
// the part a MIDI channel plays in: its own in a bank, part 0 for an ordinary instrument (omni); gb_part_sel makes it
// the current one (gb_cc, gb_ptab); gb_part_gain: its volume x expression, as the output's level had them before
function gb_part_of(ch) ( gb_nprg > 0 ? max(0, min(15, ch | 0)) : 0; );
function gb_part_sel(s) ( gb_part = s; gb_cc = GB_CCP + s * 128; gb_ptab = GB_NTP + s * GB_NTS; );
function gb_part_gain(s) ( GB_CHG[s] = (GB_CV7[s] / 127) ^ 2 * (GB_CV11[s] / 127) ^ 2; );

function gb_sel(ch) (
  ch = max(0, min(15, ch | 0));
  gb_ssec = GB_CHSC[ch]; gb_sprog = GB_CHPG[ch];
);
function gb_prog_ok(r) (
  r[GBR_PSEC] == 0 || (r[GBR_PSEC] == gb_ssec && gb_sprog >= r[GBR_PLO] && gb_sprog <= r[GBR_PHI]);
);
// ── variation banks (2026-11-05): a program change picks (bank, program) as FluidSynth does by default ("gs" bank
// select; fluid_chan.c fluid_channel_set_bank_msb, fluid_synth.c fluid_synth_program_change, read 2026-11-05): CC0
// sets the bank, on the drum channel 128 + CC0; CC32 is ignored; the bank waits for the next program change. A
// (bank, program) the file lacks falls back to bank 0's program, then bank 0's program 1 -- on the drum channel to the
// kits' same program, then the first kit. The tables are the file's, so this runs only while the instrument is ready.
// the section MIDI bank b picks: the file's "// bank" lines, else bank 0 = the first melodic section, 128 = the kits
function gb_bank_sec(b) local(s) (
  b = b | 0; s = b >= 0 && b < 256 ? GB_BNK[b] : 0;
  s > 0 ? s : b == 0 ? gb_mel_sec : b == 128 ? gb_drum_sec : 0;
);
// does section s hold program p (the speed index, else the program list)
function gb_has(s, p) local(i, q, f) (
  s <= 0 || p < 0 || p > 127 ? 0
  : gb_pix_ok && s < GB_PIX_SECS ? GB_PIX[((s | 0) * 128 + (p | 0)) * 2] >= 0
  : ( f = 0; i = 0; loop(gb_nprg, q = GB_PRG + i * 5; q[0] == s && p >= q[1] && p <= q[2] ? f = 1; i += 1; ); f; );
);
function gb_chan_set(ch, s, p) ( GB_CHSC[ch] = s; GB_CHPG[ch] = p; );
// the section and program channel ch gets for MIDI bank b, program p, packed as section * 128 + program (no table
// written: the EQ memory asks it from @gfx too, gb_pick_ch0)
function gb_resolve_pack(ch, b, p) local(s, d) (
  p = max(0, min(127, p | 0));
  gb_nprg == 0 ? p : (
    s = gb_bank_sec(b);
    gb_has(s, p) ? s * 128 + p : (
      d = gb_bank_sec(ch == 9 && gb_drum_sec > 0 ? 128 : 0);
      d * 128 + (gb_has(d, p) ? p : gb_has(d, 0) ? 0 : p);
    );
  );
);
// channel ch to MIDI bank b, program p
function gb_resolve(ch, b, p) local(k) ( k = gb_resolve_pack(ch, b, p); gb_chan_set(ch, floor(k / 128), k % 128); );
// the program channel 1 takes for the face's pick v, bank b (as gb_prog_set sets it), packed as gb_resolve_pack does:
// the EQ memory's key (gb_eq) for a load the audio thread has not adopted yet
function gb_pick_ch0(v, b) (
  v = max(0, min(255, v | 0));
  v >= 128 && gb_drum_sec > 0 ? gb_drum_sec * 128 + v - 128 : gb_resolve_pack(0, b, v & 127);
);
// the bank a program change on ch asks for: its CC0, on the drum channel (channel 10, when the file has kits) + 128
function gb_midi_bank(ch) ( (ch == 9 && gb_drum_sec > 0 ? 128 : 0) + GB_CHB0[ch]; );
// v = the face's pick (0..127 melodic, 128 + p a kit), b = its bank (slider 90; 0 = the main programs): every channel;
// channel 10 keeps the first kit when the pick is melodic. gb_prog_set runs it; gb_prog_apply only while the
// instrument is ready and adopted (gb_on_ready, which runs before the adoption is marked, calls gb_prog_set)
function gb_prog_set(v, b) local(i) (
  v = max(0, min(255, v | 0));
  v >= 128 && gb_drum_sec > 0 ? ( i = 0; loop(16, gb_chan_set(i, gb_drum_sec, v - 128); i += 1; ); )
  : ( i = 0; loop(16, i == 9 && gb_drum_sec > 0 ? gb_resolve(9, 128, 0) : gb_resolve(i, b, v & 127); i += 1; ); );
);
function gb_prog_apply(v, b) ( gb_ready && gb_gen_seen == gb_load_gen ? gb_prog_set(v, b); );
// a program change on ch: now when the instrument is ready, else once the loading one is adopted (gb_on_ready)
function gb_prog_change(ch, p) (
  GB_CHMP[ch] = p;
  gb_ready && gb_gen_seen == gb_load_gen ? gb_resolve(ch, gb_midi_bank(ch), p) : GB_CHLD[ch] = 1;
);

function gb_on_ready() local(i, r, s) (
  gb_all_off();
  // every part: the file's controllers, no notes, no bend, no glide yet
  s = 0;
  loop(16,
    i = 0; loop(128, GB_CCP[s * 128 + i] = gb_cc_init[i]; i += 1; );
    GB_BND[s] = 0; GB_HELD[s] = 0; GB_GLAST[s] = -1; GB_CV7[s] = GB_CV11[s] = 127; gb_part_gain(s);
    GB_BNDR[s] = 0; GB_BRNG[s] = -1; GB_RPNM[s] = 127; GB_RPNL[s] = 127;   // no bend, no RPN range yet, no RPN selected
    s += 1;
  );
  memset(GB_NTP, 0, 16 * GB_NTS); memset(GB_NTA, 0, 128);
  gb_bend = 0; gb_bend_dirty = 1; gb_part_sel(0);
  gb_prog_set(gb_prog_pick, gb_bank_pick);   // a new instrument: every channel on the face's pick (kit on 10)
  // ... then the program changes that came while it loaded, on their channels' banks (they used to be lost here)
  i = 0; loop(16, GB_CHLD[i] ? ( GB_CHLD[i] = 0; gb_resolve(i, gb_midi_bank(i), GB_CHMP[i]); ); i += 1; );
  gb_sw_lo = 128; gb_sw_hi = -1; gb_sw_cur = -1; gb_kb_cur = -1;
  gb_last_reg = -1; gb_last_note = -1; gb_last_vel = 0;   // the display must not show the old instrument's note
  i = 0;
  loop(gb_nreg,
    r = GB_REG + i * GB_RS;
    r[GBR_SWLO] >= 0 ? gb_sw_lo = min(gb_sw_lo, r[GBR_SWLO]);
    r[GBR_SWHI] >= 0 ? gb_sw_hi = max(gb_sw_hi, r[GBR_SWHI]);
    gb_sw_cur < 0 && r[GBR_SWDEF] >= 0 ? gb_sw_cur = r[GBR_SWDEF];
    r[GBR_SEQCNT] = 0;
    i += 1;
  );
);

// velocity -> gain as sfizz does it (RegionStateful.cpp velocityCurve, 1.2.3): the curve (amp_velcurve_N points, else
// amp_velpow's power, else (v/127)^2) blended toward 1 by amp_veltrack; a negative amp_veltrack turns it upside down
function gb_velgain(r, v) local(vt, c, g) (
  c = r[GBR_VCPTR] > 0 ? r[GBR_VCPTR][v] : (v / 127) ^ (r[GBR_VPOW] > 0 ? r[GBR_VPOW] : 2);
  vt = max(-1, min(1, r[GBR_VTRACK] * 0.01));
  g = abs(vt) * (1 - c);
  vt < 0 ? g : 1 - g;
);

// may region r play now? (everything but key, velocity and trigger, which the callers test)
function gb_region_open(r, rnd) local(ok, g, c, sm) (
  ok = rnd >= r[GBR_LORAND] && rnd < r[GBR_HIRAND];
  ok ? ok = gb_cc[64] >= r[GBR_LOCC64] && gb_cc[64] <= r[GBR_HICC64];
  g = 0;
  while (ok && g < r[GBR_GCNT]) (
    c = gb_cc[r[GBR_GATES + g * 3]];
    ok = c >= r[GBR_GATES + g * 3 + 1] && c <= r[GBR_GATES + g * 3 + 2];
    g += 1;
  );
  ok && r[GBR_SWLAST] >= 0 ? ok = gb_sw_cur == r[GBR_SWLAST];
  sm = r[GBR_SMP];
  ok && sm != GB_SILENCE ? ok = sm >= 0 && GB_SMP[sm * GB_SS + GBS_STAT] == GB_SS_OK;
  ok;
);

// round robin: count this region's matches and say whether this one is its turn
function gb_seq_turn(r) (
  r[GBR_SEQLEN] <= 1 ? 1 : (
    r[GBR_SEQCNT] += 1; r[GBR_SEQCNT] > r[GBR_SEQLEN] ? r[GBR_SEQCNT] = 1;
    r[GBR_SEQCNT] == r[GBR_SEQPOS];
  );
);

function gb_release(v) (
  gb_release_time(v);
  v[GBV_DLY] > 0 ? v[GBV_ON] = 0 : ( v[GBV_RELD] = 1; v[GBV_ST] < GB_ST_REL ? v[GBV_ST] = GB_ST_REL; );
);
function gb_fade(v) ( v[GBV_DLY] > 0 ? v[GBV_ON] = 0 : v[GBV_ST] = GB_ST_FADE; );
// release v ofs samples into this block. A voice still waiting to start (its own offset or ampeg_delay) and released
// before it starts never sounds; one that starts first plays until its release sample (a short note inside one block
// used to vanish: the release killed it while it waited).
function gb_release_at(v, ofs) (
  ofs <= 0 ? gb_release(v)
  : v[GBV_DLY] > 0 && ofs <= v[GBV_DLY] ? v[GBV_ON] = 0
  : ( gb_release_time(v); v[GBV_RELIN] = ofs + 1; );   // (the coefficient now, in @block; the release starts in @sample)
);

// the oldest voice among the regular slots matching (group, note) -- note < 0 means any note; group < 0 means any
function gb_oldest(group, note) local(i, v, best, bage) (
  best = -1; bage = 1000000000000000; i = 0;
  loop(GB_MAXV,
    v = GB_VOI + i * GB_VS;
    v[GBV_ON] && v[GBV_ST] != GB_ST_FADE && (group < 0 || (v[GBV_GROUP] == group && v[GBV_PART] == gb_part))
      && (note < 0 || v[GBV_NOTE] == note)
      && v[GBV_AGE] < bage ? ( bage = v[GBV_AGE]; best = i; );
    i += 1;
  );
  best;
);
function gb_count(group, note) local(i, v, n) (
  n = 0; i = 0;
  loop(GB_MAXV,
    v = GB_VOI + i * GB_VS;
    v[GBV_ON] && v[GBV_ST] != GB_ST_FADE && v[GBV_GROUP] == group && v[GBV_PART] == gb_part
      && (note < 0 || v[GBV_NOTE] == note) ? n += 1;
    i += 1;
  );
  n;
);

// move a playing voice into a fade slot (so its slot can take a new note without a click)
function gb_steal_slot(s) local(f, k, fv, best, bage) (
  best = -1; bage = 1000000000000000; k = 0;
  loop(GB_FADES,
    fv = GB_VOI + (GB_MAXV + k) * GB_VS;
    !fv[GBV_ON] ? ( best = k; bage = -1; ) : fv[GBV_AGE] < bage && bage >= 0 ? ( bage = fv[GBV_AGE]; best = k; );
    k += 1;
  );
  f = GB_VOI + (GB_MAXV + best) * GB_VS;
  memcpy(f, GB_VOI + s * GB_VS, GB_VS);
  f[GBV_FCOEF] = gb_coef60(0.005); f[GBV_ST] = GB_ST_FADE;
  gb_vhi = max(gb_vhi, GB_MAXV + best + 1);
);

// start region ri for note n at velocity vel, ofs samples into the block, its level scaled by gsc
function gb_launch(ri, n, vel, ofs, gsc) local(r, sm, s, i, v, k, grp, frames, last, pos, db, lin, pan, mc, mi, vv, at, dc, ks, hs, ds) (
  r = GB_REG + ri * GB_RS; grp = r[GBR_GROUP];
  // a region of group G turns off every voice whose off_by is G
  grp != 0 ? (
    i = 0;
    loop(GB_MAXV + GB_FADES,
      v = GB_VOI + i * GB_VS;
      v[GBV_ON] && v[GBV_OFFBY] == grp && v[GBV_PART] == gb_part ? ( v[GBV_OFFMODE] == GB_OM_NORMAL ? gb_release(v) : gb_fade(v); );
      i += 1;
    );
  );
  sm = r[GBR_SMP];
  sm != GB_SILENCE ? (
    s = GB_SMP + sm * GB_SS; frames = s[GBS_FRAMES];
    last = frames - 1; r[GBR_END] >= 0 ? last = min(last, r[GBR_END]);
    pos = r[GBR_OFFSET]; r[GBR_OFFRAND] > 0 ? pos += rand(r[GBR_OFFRAND]) | 0;
    pos <= last && last >= 0 ? (
      // voice limits: per group, and per note within the group
      r[GBR_POLY] > 0 ? ( while (gb_count(grp, -1) >= r[GBR_POLY] && (k = gb_oldest(grp, -1)) >= 0) ( gb_fade(GB_VOI + k * GB_VS); ); );
      r[GBR_NPOLY] > 0 ? ( while (gb_count(grp, n) >= r[GBR_NPOLY] && (k = gb_oldest(grp, n)) >= 0) ( gb_fade(GB_VOI + k * GB_VS); ); );
      // a free regular slot, else steal the oldest into a fade slot
      k = -1; i = 0;
      while (k < 0 && i < gb_vmax) ( !GB_VOI[i * GB_VS + GBV_ON] ? k = i; i += 1; );   // SETTINGS: voices
      k < 0 ? ( k = gb_oldest(-1, -1); k >= 0 ? gb_steal_slot(k); );
      k >= 0 ? (
        v = GB_VOI + k * GB_VS;
        memset(v, 0, GB_VS);
        v[GBV_PART] = gb_part; v[GBV_CG] = GB_CHG[gb_part];   // its part (bend, controllers, level)
        v[GBV_REG] = ri; v[GBV_NOTE] = n; v[GBV_POS] = pos; v[GBV_LAST] = last;
        v[GBV_PTR] = s[GBS_PTR]; v[GBV_NCH] = s[GBS_NCH]; v[GBV_PKQ] = -1;
        v[GBV_SEMI] = (n - r[GBR_KEYC]) * r[GBR_KTRACK] * 0.01 + r[GBR_TUNE] * 0.01 + r[GBR_TRANSP];
        v[GBV_RATIO] = s[GBS_SR] / srate;
        v[GBV_GLS] = gb_launch_gl;     // glide: start from the last note's pitch (0 = no glide)
        v[GBV_BUP] = r[GBR_BUP]; v[GBV_BDN] = r[GBR_BDN];   // its bend range (0, 0 = the part's or the knob's)
        gb_voice_inc(v);
        db = r[GBR_VOLDB]; r[GBR_AMPRAND] > 0 ? db += rand(r[GBR_AMPRAND]);
        // the face's VELOCITY knob: 100 % = as played, 0 % = every note full (layer choice keeps the real velocity)
        lin = 10 ^ (db / 20) * gb_velgain(r, (127 - (127 - vel) * gb_vsens + 0.5) | 0) * gsc;
        // pan: constant power with the centre at unity (sfizz Panning.cpp + its +3 dB make-up): hard left = +3 dB left
        pan = (max(-100, min(100, r[GBR_PAN])) + 100) * 0.005 * $pi * 0.5;
        v[GBV_GL] = lin * 1.41421356 * cos(pan); v[GBV_GR] = lin * 1.41421356 * sin(pan);
        // format 2: velocity / key crossfades scale the start level; live controllers set the gains (and pitch)
        // from where the controllers are now, and from here on per block (gb_voices_block)
        r[GBR_NMOD] > 0 ? (
          lin *= gb_mod_note(ri, n, vel);
          v[GBV_BLIN] = lin; v[GBV_BPAN] = r[GBR_PAN];
          mc = 0; mi = 0;            // (not k / i: k is this voice's slot, used below)
          loop(r[GBR_NMOD], (GB_MOD + ri * GB_MODS + mi * 4)[0] % 100 <= 6 ? mc += 1; mi += 1; );
          v[GBV_MODS] = mc;
          mc > 0 ? ( gb_voice_mod(v); v[GBV_GL] = v[GBV_TGL]; v[GBV_GR] = v[GBV_TGR]; )
                : ( v[GBV_GL] = lin * 1.41421356 * cos(pan); v[GBV_GR] = lin * 1.41421356 * sin(pan); );
        );
        v[GBV_LMODE] = r[GBR_LMODE]; v[GBV_LS] = r[GBR_LSTART]; v[GBV_LE] = min(r[GBR_LEND], last);
        (v[GBV_LMODE] == GB_LM_CONT || v[GBV_LMODE] == GB_LM_SUST) && v[GBV_LE] <= v[GBV_LS] ? v[GBV_LMODE] = GB_LM_NOLOOP;
        // the controllers on the envelope's times (mod types 11..16; GB_EMS = delay, attack, hold, decay, sustain %,
        // release offsets as the part's controllers stand now; 2026-11-05)
        r[GBR_NMOD] > 0 ? gb_env_mods(ri) : memset(GB_EMS, 0, 6);
        v[GBV_VEL] = vel;
        v[GBV_DLY] = ofs + (max(0, r[GBR_DELAY] + GB_EMS[0]) * srate) | 0;
        // key-scaled hold and decay (2026-11-05, a SoundFont's keynumToVolEnvHold / Decay, as FluidSynth: the time x
        // 2^(k x (60 - key) / 1200), so a positive k rings the low keys longer; hold at most 18 s, decay 101 s)
        ks = 60 - n; vv = vel / 127;
        hs = r[GBR_KAH] != 0 ? 2 ^ (r[GBR_KAH] * ks / 1200) : 1; ds = r[GBR_KAD] != 0 ? 2 ^ (r[GBR_KAD] * ks / 1200) : 1;
        v[GBV_HOLDN] = (min(18, max(0, r[GBR_HOLD] + GB_EMS[2]) * hs) * srate) | 0;
        v[GBV_SUSL] = max(0, min(1, (r[GBR_SUS] + GB_EMS[4]) * 0.01));
        // the envelope times, each with its vel2 part (sfizz: seconds x velocity / 127 added; below 0 = instant)
        dc = min(101, (r[GBR_DEC] + r[GBR_VDEC] * vv + GB_EMS[3]) * ds);
        v[GBV_DCOEF] = dc > 0 ? gb_coef_sfz(dc) : 0;
        v[GBV_RCOEF] = gb_coef_sfz(max(max(r[GBR_REL] + r[GBR_VREL] * vv + GB_EMS[5], 0.001) * gb_relx, 0.001));   // the face's RELEASE knob scales it
        v[GBV_FCOEF] = gb_coef_sfz(max(r[GBR_OFFTIME], 0.001));
        // the face's ATTACK knob adds to the region's own attack (0 s = as recorded)
        at = r[GBR_ATT] + r[GBR_VATT] * vv + gb_att_add + GB_EMS[1];
        at > 0 ? ( v[GBV_ENV] = 0; v[GBV_AINC] = 1 / (at * srate); v[GBV_ST] = GB_ST_ATT; )
                       : ( v[GBV_ENV] = 1; v[GBV_ST] = v[GBV_HOLDN] > 0 ? GB_ST_HOLD : GB_ST_DEC; v[GBV_CNT] = v[GBV_HOLDN]; );
        v[GBV_GROUP] = grp; v[GBV_OFFBY] = r[GBR_OFFBY]; v[GBV_OFFMODE] = r[GBR_OFFMODE]; v[GBV_TRIG] = r[GBR_TRIG];
        r[GBR_SHAPE] ? gb_shape_launch(v, r, n, vel);   // the filter, its envelope, the LFOs
        gb_age += 1; v[GBV_AGE] = gb_age;
        // for the face's display (read-only there): the last attack note, its region and velocity
        r[GBR_TRIG] != GB_TR_RELEASE && r[GBR_TRIG] != GB_TR_RELKEY ? ( gb_last_reg = ri; gb_last_note = n; gb_last_vel = vel; gb_last_gen += 1; );
        v[GBV_ON] = 1;                 // last: the voice exists from here
        gb_vhi = max(gb_vhi, k + 1);
      );
    );
  );
);

// the regions a note on (gb_ssec, gb_sprog) may play lie in section 0's span and the program's own (gb_sfz
// gb_prog_index): their union, in file order, as one or two ranges gb_s1a..gb_s1b, gb_s2a..gb_s2b (empty: a > b).
// Every region in them is still tested in full, so the regions played and their order are the full search's.
function gb_span() local(e, a0, a1, b0, b1) (
  gb_s2a = 0; gb_s2b = -1;
  !gb_pix_ok ? ( gb_s1a = 0; gb_s1b = gb_nreg - 1; ) : (
    a0 = gb_pix0a; a1 = gb_pix0b; b0 = -1; b1 = -1;
    gb_ssec > 0 && gb_ssec < GB_PIX_SECS && gb_sprog >= 0 && gb_sprog < 128 ? (
      e = GB_PIX + ((gb_ssec | 0) * 128 + (gb_sprog | 0)) * 2; b0 = e[0]; b1 = e[1];
    );
    a0 < 0 ? ( a0 = b0; a1 = b1; b0 = -1; );
    a0 < 0 ? ( gb_s1a = 0; gb_s1b = -1; )
    : b0 < 0 ? ( gb_s1a = a0; gb_s1b = a1; )
    : b0 <= a1 + 1 && a0 <= b1 + 1 ? ( gb_s1a = min(a0, b0); gb_s1b = max(a1, b1); )
    : b0 < a0 ? ( gb_s1a = b0; gb_s1b = b1; gb_s2a = a0; gb_s2b = a1; )
    : ( gb_s1a = a0; gb_s1b = a1; gb_s2a = b0; gb_s2b = b1; );
  );
);

// regions a..b of trigger kind tr (attack-like, or release-like) that match note n at velocity vel
function gb_fire_in(a, b, n, vel, ofs, release, gsc, prevheld, rnd) local(i, r, tr, ok) (
  i = a;
  while (i <= b) (
    r = GB_REG + i * GB_RS; tr = r[GBR_TRIG];
    ok = release ? (tr == GB_TR_RELEASE || tr == GB_TR_RELKEY) && (release == 2 ? tr == GB_TR_RELEASE : 1)
                 : tr == GB_TR_ATTACK || (tr == GB_TR_FIRST && prevheld == 0) || (tr == GB_TR_LEGATO && prevheld > 0);
    ok && n >= r[GBR_LOKEY] && n <= r[GBR_HIKEY] && vel >= r[GBR_LOVEL] && vel <= r[GBR_HIVEL] && gb_prog_ok(r) && gb_region_open(r, rnd) ? (
      gb_seq_turn(r) ? gb_launch(i, n, vel, ofs, gsc);
    );
    i += 1;
  );
);
// every region that matches note n at velocity vel, on the current program (gb_sel)
function gb_fire(n, vel, ofs, release, gsc, prevheld) local(rnd, a2, b2) (
  rnd = rand(1);
  gb_span(); a2 = gb_s2a; b2 = gb_s2b;
  gb_fire_in(gb_s1a, gb_s1b, n, vel, ofs, release, gsc, prevheld, rnd);
  gb_fire_in(a2, b2, n, vel, ofs, release, gsc, prevheld, rnd);
);

// is n a keyswitch key (it switches; it is no held note for trigger=first / legato, glide or mono)
function gb_is_sw(n) ( gb_sw_hi >= 0 && n >= gb_sw_lo && n <= gb_sw_hi; );
// note n on, in the current part (gb_part_sel)
function gb_note_on(n, vel, ofs) local(prev, i, v, sw) (
  sw = gb_is_sw(n);
  prev = GB_HELD[gb_part];
  sw ? gb_sw_cur = n;
  // a keyswitch key only switches: no glide from it, no mono cut of the playing note
  !sw ? (
    // GLIDE: over a held note (legato) or in mono, the new note starts at the part's last note's pitch and slides
    gb_launch_gl = gb_glide > 0 && GB_GLAST[gb_part] >= 0 && (prev > 0 || gb_mono) ? GB_GLAST[gb_part] - n : 0;
    // MONO: one note at a time in the part -- its others release
    gb_mono ? (
      i = 0;
      loop(GB_MAXV, v = GB_VOI + i * GB_VS; v[GBV_ON] && v[GBV_PART] == gb_part && v[GBV_NOTE] != n && v[GBV_ST] < GB_ST_REL ? gb_release(v); i += 1; );
    );
    GB_GLAST[gb_part] = n;
  ) : gb_launch_gl = 0;
  // a second note-on of a held pitch is not a second held note (on, on, off, off)
  !gb_ptab[n] ? ( !sw ? GB_HELD[gb_part] += 1; GB_NTA[n] += 1; );
  gb_ptab[n] = 1; gb_ptab[128 + n] = vel; gb_ptab[256 + n] = gb_t + ofs; gb_ptab[384 + n] = 0;
  gb_ptab[512 + n] = gb_note_ch;     // its release sounds come from the same program
  gb_sel(gb_note_ch);
  gb_fire(n, vel, ofs, 0, 1, prev);
  gb_launch_gl = 0;
);

// release-trigger regions for note n; release == 1 at note-off (both kinds), 2 at pedal-up (trigger=release only)
function gb_frel_in(a, b, n, ofs, release, held_s, rnd) local(i, r, tr) (
  i = a;
  while (i <= b) (
    r = GB_REG + i * GB_RS; tr = r[GBR_TRIG];
    (release == 1 ? (tr == GB_TR_RELKEY || (tr == GB_TR_RELEASE && gb_cc[64] < 64)) : tr == GB_TR_RELEASE)
      && n >= r[GBR_LOKEY] && n <= r[GBR_HIKEY] && gb_ptab[128 + n] >= r[GBR_LOVEL] && gb_ptab[128 + n] <= r[GBR_HIVEL]
      && gb_prog_ok(r) && gb_region_open(r, rnd) ? (
      gb_seq_turn(r) ? gb_launch(i, n, gb_ptab[128 + n], ofs, 10 ^ (-r[GBR_RTDEC] * held_s / 20));
    );
    i += 1;
  );
);
function gb_fire_release(n, ofs, release) local(held_s, rnd, a2, b2) (
  held_s = max(0, (gb_t + ofs - gb_ptab[256 + n]) / srate);
  gb_sel(gb_ptab[512 + n]);
  rnd = rand(1);
  gb_span(); a2 = gb_s2a; b2 = gb_s2b;
  gb_frel_in(gb_s1a, gb_s1b, n, ofs, release, held_s, rnd);
  gb_frel_in(a2, b2, n, ofs, release, held_s, rnd);
);

// note n off, in the current part. Its release sounds only for a note that was on: a stray or repeated note-off
// releases what still plays but fires no release sample (outside audit, 2026-11-05)
function gb_note_off(n, ofs) local(i, v, pedal, was) (
  was = gb_ptab[n];
  was ? (
    gb_ptab[n] = 0; GB_NTA[n] = max(0, GB_NTA[n] - 1);
    !gb_is_sw(n) ? GB_HELD[gb_part] = max(0, GB_HELD[gb_part] - 1);
  );
  pedal = gb_cc[64] >= 64;
  i = 0;
  loop(GB_MAXV,
    v = GB_VOI + i * GB_VS;
    v[GBV_ON] && v[GBV_PART] == gb_part && v[GBV_NOTE] == n && !v[GBV_RELD] && v[GBV_LMODE] != GB_LM_ONESHOT
      && v[GBV_TRIG] != GB_TR_RELEASE && v[GBV_TRIG] != GB_TR_RELKEY ? ( pedal ? v[GBV_PEDAL] = 1 : gb_release_at(v, ofs); );
    i += 1;
  );
  was ? (
    gb_fire_release(n, ofs, 1);
    pedal ? gb_ptab[384 + n] = 1;
  );
);

function gb_cc_in(c, val, ofs) local(was, i, v) (
  was = gb_cc[c]; gb_cc[c] = val;
  c == 64 && was >= 64 && val < 64 ? (
    i = 0;
    loop(GB_MAXV,
      v = GB_VOI + i * GB_VS;
      v[GBV_ON] && v[GBV_PART] == gb_part && v[GBV_PEDAL] && !gb_ptab[v[GBV_NOTE]] ? ( v[GBV_PEDAL] = 0; gb_release_at(v, ofs); );
      i += 1;
    );
    i = 0; loop(128, gb_ptab[384 + i] && !gb_ptab[i] ? ( gb_ptab[384 + i] = 0; gb_fire_release(i, ofs, 2); ); i += 1; );
  );
  c == 7 ? GB_CV7[gb_part] = val; c == 11 ? GB_CV11[gb_part] = val;
  c == 7 || c == 11 ? gb_part_gain(gb_part);   // volume and expression: this part's voices glide there (gb_render)
  // RPN 0, the pitch-bend range (the GM way, 2026-11-05): CC101 / CC100 select it, then CC6 = semitones, CC38 = cents
  // (0 semitones = the file wants no bend, kept as 0); 127 / 127 (or any other RPN) ends it. The part's voices
  // re-pitch at once (gb_bend_dirty); a region with its own bend_up / bend_down keeps its own
  c == 101 ? GB_RPNM[gb_part] = val; c == 100 ? GB_RPNL[gb_part] = val;
  (c == 6 || c == 38) && GB_RPNM[gb_part] == 0 && GB_RPNL[gb_part] == 0 ? (
    was = max(0, GB_BRNG[gb_part]);    // (-1 = none yet)
    GB_BRNG[gb_part] = c == 6 ? val * 100 + was % 100 : floor(was / 100) * 100 + min(99, val);
    gb_bend_dirty = 1;
  );
  // all sound off cuts, all notes off releases -- this part's voices only; both forget the part's held notes and
  // pending pedal releases, or a later note would count them as still held (trigger=first / legato, the pedal)
  c == 120 ? ( i = 0; loop(GB_MAXV + GB_FADES, v = GB_VOI + i * GB_VS; v[GBV_ON] && v[GBV_PART] == gb_part ? v[GBV_ON] = 0; i += 1; ); );
  c == 123 ? ( i = 0; loop(GB_MAXV, v = GB_VOI + i * GB_VS; v[GBV_ON] && v[GBV_PART] == gb_part ? gb_release(v); i += 1; ); );
  c == 120 || c == 123 ? (
    i = 0; loop(128, gb_ptab[i] ? GB_NTA[i] = max(0, GB_NTA[i] - 1); i += 1; );
    memset(gb_ptab, 0, 128); memset(gb_ptab + 384, 0, 128); GB_HELD[gb_part] = 0;
  );
);

// a pitch-bend value 0..16383 (8192 = centre) -> the part's raw bend -1..1 (GB_BNDR; each voice applies its range,
// gb_voice_inc) and, over the SETTINGS page's range, semitones for the face's wheel (part 0's is mirrored in gb_bend)
function gb_bend_in(v14) (
  GB_BNDR[gb_part] = (v14 - 8192) / 8192;
  GB_BND[gb_part] = GB_BNDR[gb_part] * gb_bend_rng;
  gb_part == 0 ? gb_bend = GB_BND[0];
  gb_bend_dirty = 1;
);

// @block: MIDI (omni), then per-block voice upkeep. vol_db = the host's volume control.
// midirecv writes its four arguments, so they are plain globals (gb_mofs, gb_m1..3), not locals
// one MIDI message (the offline tests feed this too)
function gb_midi_msg(m1, m2, m3, ofs) local(st) (
  st = m1 & $xF0;
  gb_note_ch = m1 & $x0F;
  // bank select and program change are kept while a load runs too (gb_prog_change: applied once it is adopted)
  st == $xB0 && m2 == 0 ? GB_CHB0[gb_note_ch] = m3 & 127;
  st == $xC0 ? gb_prog_change(gb_note_ch, m2 & 127);
  gb_ready && gb_gen_seen == gb_load_gen ? (
    gb_part_sel(gb_part_of(gb_note_ch));
    st == $x90 && m3 > 0 ? gb_note_on(m2, m3, ofs)
    : st == $x80 || st == $x90 ? gb_note_off(m2, ofs)
    : st == $xB0 ? gb_cc_in(m2, m3, ofs)
    : st == $xE0 ? gb_bend_in(m3 * 128 + m2);
  );
  gb_note_ch = 0;                    // the face's keys and pads play channel 1's program, in part 0
  gb_part_sel(0);
);
// a finished load is adopted once (gb_load_gen counts loads, so even a load that started and finished between two
// blocks is seen); a load in progress resets the voices. Run BEFORE the block's MIDI (outside audit, 2026-11-05: a
// note-on in the first block after a load used to be dropped) and again by gb_voices_block.
function gb_adopt() (
  !gb_ready ? ( gb_vhi > 0 ? gb_all_off(); )
  : gb_gen_seen != gb_load_gen ? ( gb_on_ready(); gb_gen_seen = gb_load_gen; );
);
function gb_midi_block() (
  gb_adopt();
  while (midirecv(gb_mofs, gb_m1, gb_m2, gb_m3)) ( gb_midi_msg(gb_m1, gb_m2, gb_m3, gb_mofs); );
);

function gb_voices_block(vol_db) local(i, v, hi, s) (
  gb_adopt();
  // pitch bend and the face's TUNE move every sounding voice (both are semitones on top of the voice's own)
  gb_bend_dirty || gb_tune_st != gb_tune_last ? (
    gb_bend_dirty = 0; gb_tune_last = gb_tune_st;
    i = 0;
    loop(gb_vhi, v = GB_VOI + i * GB_VS; v[GBV_ON] ? gb_voice_inc(v); i += 1; );
  );
  // GLIDE: each sliding voice moves toward its pitch, about 99 % of the way in the glide time
  gb_gl_k = gb_glide > 0 ? exp(-4.6 * samplesblock / (gb_glide * srate)) : 0;
  i = 0;
  loop(gb_vhi,
    v = GB_VOI + i * GB_VS;
    v[GBV_ON] && v[GBV_GLS] != 0 ? ( v[GBV_GLS] *= gb_gl_k; abs(v[GBV_GLS]) < 0.002 ? v[GBV_GLS] = 0; gb_voice_inc(v); );
    i += 1;
  );
  // PAN: constant power, unity at the centre (the render glides to it)
  gb_pl = 1.41421356 * cos((max(-100, min(100, gb_pan)) + 100) * 0.0025 * $pi);
  gb_pr = 1.41421356 * sin((max(-100, min(100, gb_pan)) + 100) * 0.0025 * $pi);
  // format 2: voices with live controllers follow them (target gains and pitch; the render glides the gains)
  gb_ready && gb_gen_seen == gb_load_gen ? (
    i = 0; loop(gb_vhi, v = GB_VOI + i * GB_VS; v[GBV_ON] && v[GBV_MODS] > 0 ? gb_voice_mod(v); i += 1; );
    // the filter's controller and the LFO depths (the mod wheel's vibrato)
    i = 0; loop(gb_vhi, v = GB_VOI + i * GB_VS; v[GBV_ON] && v[GBV_SHP] ? gb_shape_block(v); i += 1; );
  );
  gb_part_sel(0);                    // (gb_voice_mod / gb_shape_block pointed gb_cc at each voice's part)
  // the per-sample lookups follow the sample rate (built in @init too; ext_noinit keeps @init from every change)
  srate != gb_tab_sr ? ( gb_tables_build(); gb_tab_sr = srate; );
  // the face's CONTROLS page: a knob turned there arrives as that controller, as if from MIDI
  gb_ready && gb_gen_seen == gb_load_gen && gb_ui_cc_seq != gb_ui_cc_done ? (
    gb_ui_cc_done = gb_ui_cc_seq;
    // in a bank, every part (as the face's program pick sets every channel)
    s = 0; loop(gb_nprg > 0 ? 16 : 1, gb_part_sel(s); gb_cc_in(max(0, min(127, gb_ui_cc_n | 0)), max(0, min(127, gb_ui_cc_v | 0)), 0); s += 1; );
    gb_part_sel(0);
  );
  // the face's pitch-bend wheel
  gb_ui_bend_seq != gb_ui_bend_done ? (
    gb_ui_bend_done = gb_ui_bend_seq;
    s = 0; loop(gb_nprg > 0 ? 16 : 1, gb_part_sel(s); gb_bend_in(max(0, min(16383, gb_ui_bend_v | 0))); s += 1; );
    gb_part_sel(0);
  );
  // the face's keyboard (a mouse note): @gfx writes gb_kb_note (-1 = none), played here on the audio thread
  gb_ready && gb_gen_seen == gb_load_gen && gb_kb_note != gb_kb_cur ? (
    gb_kb_cur >= 0 ? gb_note_off(gb_kb_cur, 0);
    gb_kb_cur = gb_kb_note;
    gb_kb_cur >= 0 ? gb_note_on(gb_kb_cur, max(1, min(127, gb_kb_vel | 0)), 0);
  );
  hi = 0; i = 0; loop(gb_vhi, GB_VOI[i * GB_VS + GBV_ON] ? hi = i + 1; i += 1; ); gb_vhi = hi;
  gb_gtarget = 10 ^ (vol_db / 20);   // (CC7 / CC11 are each part's now: GB_CHG, per voice in gb_render)
  // (TONE is a band of Quezy's engine now: gb_eq.jsfx-inc, after this output stage)
  gb_t += samplesblock;
);

// @sample: sum every voice into spl0 / spl1
// DRIVE: EON Saturation's sine curve (rk_sat), the knob 0..1 bending it (f up to pi/2) and pushing into it (up to x4),
// levelled after it (1 / (1 + drive)), mixed in from 0 so the knob's start is silent. Run on one stereo sample: before
// the EQ in gb_render's output stage, or after it from @sample (gb_drv_post, the face's BEFORE EQ / AFTER EQ switch).
// A switch glides (gbx_pos_s, about 7 ms): for a moment both places carry part of it, so a flip mid-note does not click
// (outside audit, 2026-11-01). amt = this place's share. gbx_drv_s (the knob, smoothed) moves in gb_render.
// gbx_drv_pk: the input's recent peak, for the face's curve dot (read there only).
function gb_drive_run(l, r, amt) local(f, inv, g, k, wet) (
  gbx_dl = l; gbx_dr = r;
  gbx_drv_s > 0.0005 ? (
    f = gbx_drv_s * RK_SAT_HP; inv = rk_sat_norm(f); g = 1 + 3 * gbx_drv_s; k = 1 / (1 + gbx_drv_s);
    wet = min(1, gbx_drv_s * 20) * amt;
    gbx_dl = l + (rk_sat_shape(l * g, f, inv) * k - l) * wet;
    gbx_dr = r + (rk_sat_shape(r * g, f, inv) * k - r) * wet;
  );
  gbx_drv_pk = max(gbx_drv_pk * 0.9997, max(abs(l), abs(r)));
);

function gb_render() local(i, v, st, e, p, ip, f, ptr, last, lp, looping, i0, i2, i3, le, ll, y0, y1, y2, y3, yl, yr, ol, or_, b, dl, dr, pm, pk, cg, tg)
(
  ol = 0; or_ = 0;
  gb_ready && gb_gen_seen == gb_load_gen ? (
    i = 0; pk = gb_pack;               // read once: a load sets it only while gb_ready is 0

    loop(gb_vhi,
      v = GB_VOI + i * GB_VS;
      v[GBV_ON] ? (
        v[GBV_RELIN] > 0 ? ( v[GBV_RELIN] -= 1; v[GBV_RELIN] <= 0 ? ( v[GBV_RELD] = 1; v[GBV_ST] < GB_ST_REL ? v[GBV_ST] = GB_ST_REL; ); );
        v[GBV_DLY] > 0 ? v[GBV_DLY] -= 1 : (
          st = v[GBV_ST]; e = v[GBV_ENV];
          st == GB_ST_ATT ? ( e += v[GBV_AINC]; e >= 1 ? ( e = 1; v[GBV_HOLDN] > 0 ? ( st = GB_ST_HOLD; v[GBV_CNT] = v[GBV_HOLDN]; ) : st = GB_ST_DEC; ); )
          : st == GB_ST_HOLD ? ( v[GBV_CNT] -= 1; v[GBV_CNT] <= 0 ? st = GB_ST_DEC; )
          : st == GB_ST_DEC ? ( e *= v[GBV_DCOEF]; e <= v[GBV_SUSL] + 0.001 ? ( e = v[GBV_SUSL]; st = GB_ST_SUS; ); )
          : st == GB_ST_REL ? e *= v[GBV_RCOEF]
          : st == GB_ST_FADE ? e *= v[GBV_FCOEF];
          p = v[GBV_POS]; ip = p | 0; f = p - ip; ptr = v[GBV_PTR]; last = v[GBV_LAST];
          lp = v[GBV_LMODE]; looping = lp == GB_LM_CONT || (lp == GB_LM_SUST && !v[GBV_RELD]);
          i0 = ip > 0 ? ip - 1 : 0; i2 = ip + 1; i3 = ip + 2;
          // (wrapped by whole loops: a tiny loop played high moves more than one loop per sample)
          looping ? ( le = v[GBV_LE]; ll = le - v[GBV_LS] + 1;
                      i2 > le ? i2 -= ll * (1 + floor((i2 - le - 1) / ll)); i3 > le ? i3 -= ll * (1 + floor((i3 - le - 1) / ll)); )
                  : ( i2 > last ? i2 = last; i3 > last ? i3 = last; );
          pk && ip > 0 && i2 == ip + 1 && i3 == ip + 2 ? (
            // a packed instrument (gb_load), the usual case (four frames in a row): read from the voice's cache of
            // unpacked cells, refilled from the first cell needed when the window leaves it
            dl = v[GBV_NCH] == 1 ? i0 : 2 * i0;                                  // the window's first point
            dr = floor((dl + 0.5) * 0.3333333333333333);                          // its cell
            b = v[GBV_PKQ];
            b < 0 || dr < b || floor((dl + (v[GBV_NCH] == 1 ? 3.5 : 7.5)) * 0.3333333333333333) > b + GBV_PKN - 1 ? (
              gb_pk_cells(v + GBV_PKC, ptr + dr, GBV_PKN); v[GBV_PKQ] = dr; b = dr;
            );
            b = v + GBV_PKC + 3 * (dr - b) + dl - 3 * dr;                       // point dl
            v[GBV_NCH] == 1 ? (
              y0 = b[0]; y1 = b[1]; y2 = b[2]; y3 = b[3];
              yl = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
              yr = yl;
            ) : (
              y0 = b[0]; y1 = b[2]; y2 = b[4]; y3 = b[6];
              yl = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
              y0 = b[1]; y1 = b[3]; y2 = b[5]; y3 = b[7];
              yr = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
            );
          ) : pk ? (
            // packed, at a loop's wrap or the sample's start or end: point by point through gb_pk
            v[GBV_NCH] == 1 ? (
              y0 = gb_pk(ptr, i0); y1 = gb_pk(ptr, ip); y2 = gb_pk(ptr, i2); y3 = gb_pk(ptr, i3);
              yl = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
              yr = yl;
            ) : (
              y0 = gb_pk(ptr, 2 * i0); y1 = gb_pk(ptr, 2 * ip); y2 = gb_pk(ptr, 2 * i2); y3 = gb_pk(ptr, 2 * i3);
              yl = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
              y0 = gb_pk(ptr, 2 * i0 + 1); y1 = gb_pk(ptr, 2 * ip + 1); y2 = gb_pk(ptr, 2 * i2 + 1); y3 = gb_pk(ptr, 2 * i3 + 1);
              yr = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
            );
          ) : v[GBV_NCH] == 1 ? (
            y0 = ptr[i0]; y1 = ptr[ip]; y2 = ptr[i2]; y3 = ptr[i3];
            yl = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
            yr = yl;
          ) : (
            y0 = ptr[2 * i0]; y1 = ptr[2 * ip]; y2 = ptr[2 * i2]; y3 = ptr[2 * i3];
            yl = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
            b = ptr + 1;
            y0 = b[2 * i0]; y1 = b[2 * ip]; y2 = b[2 * i2]; y3 = b[2 * i3];
            yr = y1 + 0.5 * f * (y2 - y0 + f * (2 * y0 - 5 * y1 + 4 * y2 - y3 + f * (3 * (y1 - y2) + y3 - y0)));
          );
          v[GBV_MODS] > 0 ? ( v[GBV_GL] += (v[GBV_TGL] - v[GBV_GL]) * GB_MOD_GLIDE; v[GBV_GR] += (v[GBV_TGR] - v[GBV_GR]) * GB_MOD_GLIDE; );
          // the filter, its envelope and the LFOs (only a region that has them)
          v[GBV_SHP] == 1 ? ( gb_yl = yl; gb_yr = yr; pm = gb_shape_tick(v); yl = gb_yl; yr = gb_yr; ) : pm = 1;
          // its part's volume x expression, glided as the output's level glides (about 10 ms)
          cg = v[GBV_CG]; tg = GB_CHG[v[GBV_PART]];
          cg != tg ? ( cg += (tg - cg) * 0.002; abs(tg - cg) < 0.000001 ? cg = tg; v[GBV_CG] = cg; );
          ol += yl * e * v[GBV_GL] * cg; or_ += yr * e * v[GBV_GR] * cg;
          p += v[GBV_INC] * pm;
          looping && p >= le + 1 ? p -= ll * (1 + floor((p - le - 1) / ll));
          v[GBV_POS] = p; v[GBV_ENV] = e; v[GBV_ST] = st;
          (!looping && p > last) || ((st == GB_ST_REL || st == GB_ST_FADE) && e < GB_QUIET_T)
            || (st == GB_ST_SUS && v[GBV_SUSL] < GB_QUIET_T) ? v[GBV_ON] = 0;
        );
      );
      i += 1;
    );
  );
  // the output stage: DRIVE (before the EQ; after it, @sample runs it), WIDTH (mid/side), level, PAN (TONE and the EQ
  // follow: gb_eq)
  gbx_drv_s += (gb_drive - gbx_drv_s) * 0.002;
  gbx_pos_s += (gb_drv_post - gbx_pos_s) * 0.003;
  gbx_pos_s < 0.9999 ? ( gb_drive_run(ol, or_, 1 - gbx_pos_s); ol = gbx_dl; or_ = gbx_dr; );
  y0 = (ol + or_) * 0.5; y1 = (ol - or_) * 0.5 * gbx_w_s; ol = y0 + y1; or_ = y0 - y1;
  gbx_w_s += (gb_width - gbx_w_s) * 0.002;
  gb_gs += (gb_gtarget - gb_gs) * 0.002;
  gb_pl_s += (gb_pl - gb_pl_s) * 0.002; gb_pr_s += (gb_pr - gb_pr_s) * 0.002;
  spl0 = ol * gb_gs * gb_pl_s; spl1 = or_ * gb_gs * gb_pr_s;
);

// ── the MIDI editor's lane names (the owner, 2026-11-05: "can it rename the midi editor lanes for the drum kits") ──
// REAPER 7.83+'s set_midi_note_name (measured 2026-10-26, .dev_tests/nn_probe.jsfx: a track's own note names win over
// these, a track name of "" hides them, an open editor reads them when it opens; older REAPERs get the stub below).
// Named after what the face shows: the kit channel 1 plays -> its keys, on every channel; a melodic program while the
// file has kits -> channel 10's kit, on channel 10 only (a GM song); an ordinary kit (no programs) -> its
// "// label_key" names; a melodic instrument -> none. A kit's names are its own "// key_name" lines (GB_KN), else the
// file-wide union (GB_KLB). Rebuilt in @block when the load or those two channels' programs change; @block only.
<?
!jsfx_has_set_midi_note_name ?
  printf("function set_midi_note_name(a,b,c,d) ( 0 ); \n");
?>
gb_nn_gen = -1; gb_nn_a = -1; gb_nn_b = -1;
function gb_nn_str(off, len) local(k) (
  #gb_nn = ""; k = 0; loop(len, sprintf(#gb_nnc, "%c", GB_LCH[off + k]); strcat(#gb_nn, #gb_nnc); k += 1; );
);
// kit (sec, prog)'s names on channel ch (-1 = every channel): its key_name lines, else the union; how many were named
function gb_nn_kit(sec, prog, ch) local(i, e, n) (
  n = 0; i = 0;
  loop(gb_nkn,
    e = GB_KN + i * 5;
    e[0] == sec && e[1] == prog ? ( gb_nn_str(e[3], e[4]); set_midi_note_name(0, e[2], ch, #gb_nn); n += 1; );
    i += 1;
  );
  n == 0 ? (
    i = 0;
    loop(128, GB_KLB[i * 2 + 1] > 0 ? ( gb_nn_str(GB_KLB[i * 2], GB_KLB[i * 2 + 1]); set_midi_note_name(0, i, ch, #gb_nn); n += 1; ); i += 1; );
  );
  n;
);
function gb_note_names() local(a, b) (
  gb_ready && gb_gen_seen == gb_load_gen ? (
    a = GB_CHSC[0] * 128 + GB_CHPG[0]; b = GB_CHSC[9] * 128 + GB_CHPG[9];
    gb_nn_gen != gb_load_gen || gb_nn_a != a || gb_nn_b != b ? (
      gb_nn_gen = gb_load_gen; gb_nn_a = a; gb_nn_b = b;
      set_midi_note_name(-1, 0, 0, "");
      gb_nprg == 0 ? ( gb_nkey > 0 ? gb_nn_kit(-1, -1, -1); )
      : gb_drum_sec > 0 && GB_CHSC[0] == gb_drum_sec ? gb_nn_kit(gb_drum_sec, GB_CHPG[0], -1)
      : gb_drum_sec > 0 && GB_CHSC[9] == gb_drum_sec ? gb_nn_kit(gb_drum_sec, GB_CHPG[9], 9);
    );
  );
);
