desc: ReaKit piano keyboard widget
// ══════════════════════════════════════════════════════════════════════
// rk_piano.jsfx-inc — a piano keyboard that draws into a plain rectangle.
//
// Written clean-room for ReaKit. The proportions (black keys at 0.60 of the
// white-key breadth and 0.62 of its length, offset to the key boundary, drawn
// in a second pass over the whites) follow the same convention as Swing's
// swing_mapping_draw_vpiano, which is the reference for how these should sit —
// but none of that function's Swing state is used here.
//
// Three keyboards already exist in this codebase and none of them was reusable:
// spectrum.draw_piano() spaces keys logarithmically because it is a frequency
// axis, Swing's is bound to pad/kit globals, and Steppa's is welded into its
// grid layout. This one takes a rect and a note range and nothing else.
//
// REQUIREMENTS (host plugin must provide, per frame, before calling):
//   - mx, my       — mouse position
//   - lmb_down     — left-button PRESS edge (not the held state)
//
// PUBLIC API:
//   rk_piano_is_black(note)                        -> 1 if note is a black key
//   rk_piano_white_count(lo, hi)                   -> white keys in [lo,hi]
//   rk_piano_hit(x, y, w, h, lo, hi, vert)         -> note under mouse, or -1
//   rk_piano_draw(x, y, w, h, lo, hi, vert, sel, hov, r, g, b)
//   rk_piano_draw_ex(x, y, w, h, lo, hi, vert, sel, hov, r, g, b, st)
//       the same, plus a per-note state table st (128 cells, -1 = none) of flags:
//       RKP_RANGE (1) the instrument plays it: tinted with rk_piano_tint_*; keys without it are dimmed when any key
//       has it; RKP_KS (2) a keyswitch key (pink); RKP_KSON (4) the active keyswitch (bright pink);
//       RKP_HELD (8) sounding now: lit WHOLE in r,g,b (a white key under its black neighbours too)
//   rk_piano_colours(tr, tg, tb, kr, kg, kb)   the range tint and the keyswitch colour (defaults: none / pink)
//
// `vert` 0 = horizontal (low note at left), 1 = vertical (low note at BOTTOM,
// standard piano-roll convention). `sel` is a note to tint with r,g,b, or -1.
// `hov` is the note to light as hovered, or -1 — pass rk_piano_hit()'s result.
// ══════════════════════════════════════════════════════════════════════

@init

RKP_RANGE = 1; RKP_KS = 2; RKP_KSON = 4; RKP_HELD = 8;
rk_piano_tint_r = rk_piano_tint_g = rk_piano_tint_b = -1;   // -1 = no range tint
rk_piano_ks_r = 0.91; rk_piano_ks_g = 0.28; rk_piano_ks_b = 0.60;
function rk_piano_colours(tr, tg, tb, kr, kg, kb) (
  rk_piano_tint_r = tr; rk_piano_tint_g = tg; rk_piano_tint_b = tb;
  rk_piano_ks_r = kr; rk_piano_ks_g = kg; rk_piano_ks_b = kb;
);
// a colour per key (Gumbo's drum families on a kit's keys; the owner, 2026-11-05: "Family colors"): a table of 128 x 3
// (r, g, b; r < 0 = none), or -1 for none. A white key takes 0.45 of its colour over its ivory, a black key 0.30 over its
// ebony; held, hovered, keyswitch and out-of-range keys keep their own looks.
rk_piano_kcol = -1; rk_piano_kcol_mix = 0.45;   // the mix: how much of its colour a white key takes (a black key two thirds of that)
function rk_piano_key_colours(tbl) ( rk_piano_kcol = tbl; );

// Pitch classes 1,3,6,8,10 are the black keys (C=0).
function rk_piano_is_black(note) local(pc) (
  pc = note - floor(note / 12) * 12;
  pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
);

function rk_piano_white_count(lo, hi) local(n, c) (
  c = 0; n = lo;
  while(n <= hi) ( rk_piano_is_black(n) ? 0 : c += 1; n += 1; );
  max(c, 1);
);

// White keys before `note` within the range — a black key's position is
// expressed against the white-key boundary it straddles.
function rk_piano_whites_before(lo, note) local(n, c) (
  c = 0; n = lo;
  while(n < note) ( rk_piano_is_black(n) ? 0 : c += 1; n += 1; );
  c;
);

// Returns the note under (mx,my), or -1. Black keys are tested FIRST because
// they are drawn on top and overlap the whites they sit between.
function rk_piano_hit(x, y, w, h, lo, hi, vert)
local(wc, wsz, bb, bl, n, wi, a, b, hit) (
  hit = -1;
  wc  = rk_piano_white_count(lo, hi);
  wsz = (vert ? h : w) / wc;          // white key breadth along the keyboard
  bb  = (vert ? w : h) * 0.60;        // black key depth across it
  bl  = wsz * 0.62;                   // black key breadth along it
  // black keys
  n = lo;
  while(n <= hi && hit < 0) (
    rk_piano_is_black(n) ? (
      wi = rk_piano_whites_before(lo, n);
      vert ? (
        a = y + h - wi * wsz - bl * 0.5;
        mx >= x && mx < x + bb && my >= a && my < a + bl ? hit = n;
      ) : (
        a = x + wi * wsz - bl * 0.5;
        mx >= a && mx < a + bl && my >= y && my < y + bb ? hit = n;
      );
    );
    n += 1;
  );
  // white keys
  hit < 0 ? (
    wi = 0; n = lo;
    while(n <= hi && hit < 0) (
      rk_piano_is_black(n) ? 0 : (
        vert ? (
          a = y + h - (wi + 1) * wsz;
          mx >= x && mx < x + w && my >= a && my < a + wsz ? hit = n;
        ) : (
          a = x + wi * wsz;
          mx >= a && mx < a + wsz && my >= y && my < y + h ? hit = n;
        );
        wi += 1;
      );
      n += 1;
    );
  );
  hit;
);

function rk_piano_draw_ex(x, y, w, h, lo, hi, vert, sel, hov, r, g, b, st)
local(wc, wsz, bb, bl, n, wi, a, lit, pc, f, anyr, tr, tg, tb) (
  wc  = rk_piano_white_count(lo, hi);
  wsz = (vert ? h : w) / wc;
  bb  = (vert ? w : h) * 0.60;
  bl  = wsz * 0.62;
  // with a state table: does any key carry the range? then keys outside it are dimmed
  anyr = 0;
  st >= 0 ? ( n = lo; while (n <= hi && !anyr) ( st[n] & RKP_RANGE ? anyr = 1; n += 1; ); );
  tr = rk_piano_tint_r >= 0;

  // ── white keys (a held white key is filled whole: its black neighbours are drawn over it afterwards) ──
  wi = 0; n = lo;
  while(n <= hi) (
    rk_piano_is_black(n) ? 0 : (
      a = vert ? (y + h - (wi + 1) * wsz) : (x + wi * wsz);
      f = st >= 0 ? st[n] : 0;
      lit = (n == sel) || (f & RKP_HELD);
      lit ? gfx_set(r, g, b, 1)
      : f & RKP_KSON ? gfx_set(rk_piano_ks_r, rk_piano_ks_g, rk_piano_ks_b, 1)
      : f & RKP_KS ? gfx_set(0.82 + (rk_piano_ks_r - 0.82) * 0.45, 0.82 + (rk_piano_ks_g - 0.82) * 0.45, 0.82 + (rk_piano_ks_b - 0.82) * 0.45, 1)
      : rk_piano_kcol >= 0 && rk_piano_kcol[n * 3] >= 0 ? (
          tg = n == hov ? 0.92 : 0.84;
          gfx_set(tg + (rk_piano_kcol[n * 3] - tg) * rk_piano_kcol_mix, tg + (rk_piano_kcol[n * 3 + 1] - tg) * rk_piano_kcol_mix, tg + (rk_piano_kcol[n * 3 + 2] - tg) * rk_piano_kcol_mix, 1);
        )
      : anyr && !(f & RKP_RANGE) ? (n == hov ? gfx_set(0.62, 0.62, 0.66, 1) : gfx_set(0.52, 0.52, 0.56, 1))
      : (f & RKP_RANGE) && tr ? (
          tg = n == hov ? 0.92 : 0.84;
          gfx_set(tg + (rk_piano_tint_r - tg) * 0.22, tg + (rk_piano_tint_g - tg) * 0.22, tg + (rk_piano_tint_b - tg) * 0.22, 1);
        )
      : (n == hov ? gfx_set(0.90, 0.90, 0.94, 1) : gfx_set(0.82, 0.82, 0.85, 1));
      vert ? gfx_rect(x, a, w, wsz) : gfx_rect(a, y, wsz, h);
      // separator on the low side of each white key
      gfx_set(0.22, 0.22, 0.27, 1);
      vert ? gfx_rect(x, a, w, 1) : gfx_rect(a, y, 1, h);
      // octave marker on every C, when there is room for it
      pc = n - floor(n / 12) * 12;
      pc == 0 && wsz >= 7 ? (
        gfx_set(0.35, 0.35, 0.40, 1);
        vert ? gfx_rect(x + w - 5, a + wsz * 0.5, 3, 1) : gfx_rect(a + wsz * 0.5, y + h - 5, 1, 3);
      );
      wi += 1;
    );
    n += 1;
  );

  // ── black keys, second pass so they sit above the whites ──
  n = lo;
  while(n <= hi) (
    rk_piano_is_black(n) ? (
      wi = rk_piano_whites_before(lo, n);
      a  = vert ? (y + h - wi * wsz - bl * 0.5) : (x + wi * wsz - bl * 0.5);
      f = st >= 0 ? st[n] : 0;
      lit = (n == sel) || (f & RKP_HELD);
      lit ? gfx_set(r * 0.75, g * 0.75, b * 0.75, 1)
      : f & RKP_KSON ? gfx_set(rk_piano_ks_r * 0.80, rk_piano_ks_g * 0.80, rk_piano_ks_b * 0.80, 1)
      : f & RKP_KS ? gfx_set(rk_piano_ks_r * 0.50, rk_piano_ks_g * 0.50, rk_piano_ks_b * 0.50, 1)
      : rk_piano_kcol >= 0 && rk_piano_kcol[n * 3] >= 0 ? gfx_set(0.10 + rk_piano_kcol[n * 3] * rk_piano_kcol_mix * 0.67, 0.10 + rk_piano_kcol[n * 3 + 1] * rk_piano_kcol_mix * 0.67, 0.12 + rk_piano_kcol[n * 3 + 2] * rk_piano_kcol_mix * 0.67, 1)
      : anyr && !(f & RKP_RANGE) ? (n == hov ? gfx_set(0.36, 0.36, 0.40, 1) : gfx_set(0.28, 0.28, 0.31, 1))
      : (f & RKP_RANGE) && tr ? gfx_set(0.10 + rk_piano_tint_r * 0.10, 0.10 + rk_piano_tint_g * 0.10, 0.12 + rk_piano_tint_b * 0.10, 1)
      : (n == hov ? gfx_set(0.26, 0.26, 0.31, 1) : gfx_set(0.10, 0.10, 0.13, 1));
      vert ? gfx_rect(x, a, bb, bl) : gfx_rect(a, y, bl, bb);
      // edge shading so a black key reads as raised against its neighbours
      gfx_set(0, 0, 0, 0.8);
      vert ? ( gfx_rect(x, a, bb, 1); gfx_rect(x, a + bl - 1, bb, 1); gfx_rect(x + bb - 1, a, 1, bl); )
           : ( gfx_rect(a, y, 1, bb); gfx_rect(a + bl - 1, y, 1, bb); gfx_rect(a, y + bb - 1, bl, 1); );
    );
    n += 1;
  );

  // ── frame ──
  gfx_set(0.28, 0.28, 0.34, 1);
  gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h);
);

// the plain keyboard: one tinted note, one hovered (no state table)
function rk_piano_draw(x, y, w, h, lo, hi, vert, sel, hov, r, g, b) (
  rk_piano_draw_ex(x, y, w, h, lo, hi, vert, sel, hov, r, g, b, -1);
);
