// gb_sfz.jsfx-inc -- Gumbo: read one flat instrument file (".gumbo.txt", made by the converter
// EON/Eon_JSFX/Scripts/Gumbo/gumbo_sfz.lua, FORMAT_VERSION 1) into the region and sample tables.
//
// The file is plain text opened in TEXT mode (a .txt opens in text mode; a .sfz does not -- spec §0c), one region per
// line, every field in the converter's fixed order (a field may be left out: the converter omits end=-2), numbers
// only, then optional amp_velcurve_N and loccN/hiccN tokens. A "<control> set_ccN=V" line gives starting CC values.
// Lines are parsed character by character: no match() and no per-token string compares (4,096 regions x 42 fields).
//
// Memory (cells; the host sets maxmem=134217728):
//   GB_REG   region table, GB_RS fields each, GB_MAXREG regions
//   GB_SMP   unique sample files, GB_SS fields each (pointer, frames, channels, rate, path chars, status)
//   GB_PCH   path characters of every sample file, as numbers
//   GB_VCT   velocity curves, 128 cells per region that has one
//   GB_FN    the field-name table (length, first char, last char per field)
// Threads: the parse runs in @gfx (a drop) or @serialize (a project open), never in @block/@sample; the host keeps
// gb_ready = 0 for the whole load so the audio side reads none of these tables meanwhile.

@init
// (2026-11-03: the region table moved up and grew -- a full GM SoundFont has 6,000-7,000 regions, and the old
// 4,096 x 64 at 200000 silently lost the rest; each region also carries its filter, filter envelope and LFOs now.
// 200000 .. 470000 holds gb_voice's lookup tables, 1620000 .. 1686000 was free: gb_voice's part tables now sit at
// 1620000 .. 1634216, the speed index and the bank tables at 1640000 .. 1656764, gb_voice's channel tables at
// 1656800 .. 1656876.)
// (2026-11-05: 32,768 regions -- a GM bank with its variation banks; MuseScore General has ~20,000)
GB_REG = 2000000; GB_RS = 128; GB_MAXREG = 32768;         // -> 6194304, under GB_MOD (128 since 2026-11-05: the pitch envelope, key scaling, bend range at 108..124)
GB_SMP = 470000;  GB_SS = 8;   GB_MAXSMP = 4096;          // -> 502768
GB_PCH = 510000;  GB_PCH_CAP = 890000;                    // -> 1400000 (was 1,000,000: the names' store took the top)
GB_VCT = 1520000; GB_VCT_MAX = 512;                       // 512 x 128 -> 1585536
GB_FN  = 1700000;                                         // field names, 3 x 48
gb_cc_init = 1612000;                                     // 128 starting CC values from the file's <control> line

// region fields, in the converter's FIELDS order (gumbo_sfz.lua M.FIELDS) -- file field f lands in cell f + 1
GBR_SMP = 0;
GBR_LOKEY = 1; GBR_HIKEY = 2; GBR_KEYC = 3; GBR_KTRACK = 4; GBR_LOVEL = 5; GBR_HIVEL = 6; GBR_TUNE = 7;
GBR_TRANSP = 8; GBR_VOLDB = 9; GBR_PAN = 10; GBR_VTRACK = 11; GBR_AMPRAND = 12; GBR_DELAY = 13; GBR_ATT = 14;
GBR_HOLD = 15; GBR_DEC = 16; GBR_SUS = 17; GBR_REL = 18; GBR_LMODE = 19; GBR_LSTART = 20; GBR_LEND = 21;
GBR_OFFSET = 22; GBR_OFFRAND = 23; GBR_END = 24; GBR_TRIG = 25; GBR_RTDEC = 26; GBR_SEQLEN = 27; GBR_SEQPOS = 28;
GBR_LORAND = 29; GBR_HIRAND = 30; GBR_GROUP = 31; GBR_OFFBY = 32; GBR_OFFMODE = 33; GBR_OFFTIME = 34; GBR_POLY = 35;
GBR_NPOLY = 36; GBR_LOCC64 = 37; GBR_HICC64 = 38; GBR_SWLAST = 39; GBR_SWLO = 40; GBR_SWHI = 41; GBR_SWDEF = 42;
GB_NFIELDS = 42;
GBR_GCNT = 43;  GBR_GATES = 44;      // up to GB_MAXGATES gates: (cc, lo, hi) at 44..55
GB_MAXGATES = 4;
GBR_VCPTR = 56;                      // 0 = no curve, else a 128-cell table in GB_VCT
GBR_SEQCNT = 57;                     // round-robin counter (runtime)
GBR_NMOD = 58;                       // format 2: live controller mods on this region (0..GB_MAXMOD)
GBR_PSEC = 59; GBR_PLO = 60; GBR_PHI = 61;   // format 3 (a bank): section, program range; section 0 = plays always
// the tone filter, its envelope and the LFOs (2026-11-03; tokens fil= feg= lfo=, written only when the SFZ has them;
// an older Gumbo skips the tokens and plays the region unfiltered). Rules: sfizz's (Research
// .docs/research/Gumbo_Tone_Filter_Research_2026-11-03.md).
GBR_FTYPE = 62;                      // 0 none; 1 lpf_1p 2 hpf_1p 3 lpf_2p 4 hpf_2p 5 bpf_2p 6 brf_2p 7 lpf_4p 8 hpf_4p
GBR_FCUT = 63; GBR_FRES = 64;        // cutoff Hz, resonance dB (Q = 10^(dB/20); may be below 0)
GBR_FKT = 65; GBR_FKC = 66; GBR_FVT = 67; GBR_FRND = 68;   // keytrack cents/key, keycenter, veltrack cents, random cents
GBR_FCC = 69; GBR_FCCD = 70;         // one controller on the cutoff: cc (-1 none), cents at 127
GBR_EGD = 71;                        // filter envelope depth, cents (0 = no envelope)
GBR_EGDLY = 72; GBR_EGATT = 73; GBR_EGHOLD = 74; GBR_EGDEC = 75; GBR_EGSUS = 76; GBR_EGREL = 77;  // s, s, s, s, 0..1, s
GBR_EGVD = 78;                       // fileg_vel2depth, cents at velocity 127
GBR_LFO = 79; GBR_LFOS = 7;          // 3 LFOs x 7 cells (79..99): 0 pitch, 1 amp, 2 filter
GBL_ON = 0; GBL_WAVE = 1; GBL_FREQ = 2; GBL_DEPTH = 3; GBL_DELAY = 4; GBL_FADE = 5; GBL_CCD = 6;
//   wave 0 sine (sfizz's v1 default) 1 triangle (SF2); depth cents / dB / cents; delay, fade s; CCD = extra depth at
//   full mod wheel (CC1; the SoundFont default modulator's vibrato)
GBR_SHAPE = 100;                     // 1 = the region has any of the above (the voice runs them)
// velocity on the envelope times and the loudness curve (2026-11-04; token vel=POW,ATT,DEC,REL, and feg= grew by
// VEL2ATTACK,VEL2DECAY,VEL2RELEASE): what the SoundFont importer bakes from a file's own modulators
GBR_VPOW = 101;                      // amp_velpow: gain = (v/127)^POW (0 = the curve, else sfizz's square); Gumbo's own opcode
GBR_VATT = 102; GBR_VDEC = 103; GBR_VREL = 104;   // ampeg_vel2attack / decay / release: s added at velocity 127 (sfizz)
GBR_EGVA = 105; GBR_EGVDC = 106; GBR_EGVR = 107;  // fileg_vel2attack / decay / release
// the pitch envelope (2026-11-05, formats round 2 item A): token peg= with feg's eleven fields (pitcheg_*, the depth
// in cents; a SoundFont's modEnvToPitch), the cells in a row in the order depth, delay, attack, hold, decay, sustain,
// release, vel2depth, vel2attack, vel2decay, vel2release (gb_voice's GB_EGP names them; GB_EGF the filter's above)
GBR_PEGD = 108; GBR_PEGDLY = 109; GBR_PEGATT = 110; GBR_PEGHOLD = 111; GBR_PEGDEC = 112; GBR_PEGSUS = 113; GBR_PEGREL = 114;
GBR_PEGVD = 115; GBR_PEGVA = 116; GBR_PEGVDC = 117; GBR_PEGVR = 118;
// key-scaled envelope times (2026-11-05, item B; token keg=AHOLD,ADECAY,FHOLD,FDECAY): Gumbo's own opcodes
// ampeg_hold_keytrack / ampeg_decay_keytrack / fileg_hold_keytrack / fileg_decay_keytrack, timecents per key -- a
// SoundFont's generators 39 / 40 / 31 / 32: the time x 2^(k x (60 - key) / 1200), a positive k longer on the low keys
GBR_KAH = 119; GBR_KAD = 120; GBR_KFH = 121; GBR_KFD = 122;
// the bend range (2026-11-05, item C; token bend=UP,DOWN, cents, written only when the SFZ sets bend_up or bend_down):
// 0 and 0 = none of its own (the part's RPN 0 range, else the SETTINGS knob: gb_voice gb_voice_inc)
GBR_BUP = 123; GBR_BDN = 124;
// format 2 tables (gumbo_sfz.lua M.FORMAT_VERSION 2), in the free space between gb_cc_init and GB_FN:
//   GB_MOD    per region GB_MAXMOD mods of 4 cells: type, cc, a, b (types in gumbo_sfz.lua's header)
//   GB_CCV    custom curves for live controllers, 128 cells each; GB_CCVMAP[curve index 0..255] = slot + 1
//   GB_LBL    the library's controller names: cc, char offset, length;  GB_SWL the keyswitch names: note, offset, length
//   GB_KLB    each key's name (a drum kit's sounds: "// label_key NOTE name"), by note: char offset, length
//   GB_LCH    the names' characters
GB_MAXMOD = 8; GB_MODS = 32;                              // (8 since 2026-11-05: the envelope-time controllers of a library need the room)
GB_MOD = 6200000;                                         // GB_MAXREG x 32 -> 7248576, under GB_AUD (gb_load)
GB_CCV = 1686000; GB_CCV_MAX = 16;                        // 16 x 128 -> 1688048
GB_CCVMAP = 1688100;                                      // 256 -> 1688356
GB_LBL = 1688400; GB_LBL_MAX = 32;                        // 32 x 3 -> 1688496
GB_SWL = 1688500; GB_SWL_MAX = 64;                        // 64 x 3 -> 1688692
// (2026-11-05: the names' store moved from 1688700 (cap 8,000) to the top of the paths' space, so a GM set's kits can
// each name their own keys: 37 kits x ~60 names)
GB_LCH = 1400000; GB_LCH_CAP = 60000;                     // -> 1460000
// a bank's kits' own key names (2026-11-05): "// key_name S P NOTE name" -> GB_KN entries of 5: section, program,
// note, char offset, length. The face names the playing kit's pads from these ("// label_key" is the file-wide union,
// kept for older Gumbos and ordinary kits)
GB_KN = 1460000; GB_KN_MAX = 4096;                        // 4096 x 5 -> 1480480, under GB_VCT
GB_KLB = 1697000;                                         // 128 x 2: each key's name (char offset, length; 0 = none) -> 1697256
// format 3 (a bank, 2026-11-02): its programs "// program S LO HI name" (section, lo, hi, name offset, length in
// GB_LCH) and the section channel 10 plays ("// drums S" -> gb_drum_sec); GB_CHPG = each MIDI channel's program
// (gb_voice: 0..127 = a melodic program, 128 + p = drum kit p)
GB_CSVT = 1697270;                                        // 4: gb_csv4's scratch for a prog= token
GB_CHPG = 1697280;                                        // 16 channels
// (2026-11-05: 512 programs, the variation banks -- MuseScore General 309 -- in the gap after gb_eq's GB_EQM_SL
// (1749157 since the EQ memory grew to 128 programs), before the face's GBF_IDX_BASE 1764000; 1697300 .. 1698580 is free since)
GB_PRG = 1750000; GB_PRG_MAX = 512;                       // 512 x 5 -> 1752560
// variation banks (2026-11-05): "// bank S N" -> GB_BNK[N] = S (MIDI bank N picks section S; 0 = no section), and
// GB_SECB[S] = the first bank number naming S (-1 = none: the first melodic section is bank 0, the drums 128)
GB_BNK = 1656400;                                         // 256 -> 1656656 (after gb_prog_index's GB_PIX)
GB_SECB = 1656700; GB_SECB_N = 64;                        // -> 1656764
// word values
GB_LM_NOLOOP = 0; GB_LM_ONESHOT = 1; GB_LM_CONT = 2; GB_LM_SUST = 3;
GB_TR_ATTACK = 0; GB_TR_RELEASE = 1; GB_TR_RELKEY = 2; GB_TR_FIRST = 3; GB_TR_LEGATO = 4;
GB_OM_FAST = 0; GB_OM_NORMAL = 1; GB_OM_TIME = 2;
// sample fields
GBS_PTR = 0; GBS_FRAMES = 1; GBS_NCH = 2; GBS_SR = 3; GBS_PATH = 4; GBS_PLEN = 5; GBS_STAT = 6; GBS_HASH = 7;
GB_SS_NEW = 0; GB_SS_OK = 1; GB_SS_MISSING = 2; GB_SS_FORMAT = 3; GB_SS_NOROOM = 4;
GB_SILENCE = -1;                     // region sample index for *silence (a voice with no sound: it only chokes)

// field-name table: length, first and last character of each of the 42 field names (in file order), and the whole
// name from GB_FNC (16 characters a field, -> 1700872, under the face's GBF_KM_BASE 1720000)
GB_FNC = GB_FN + 200;
function gb_fn_set(f, nm) local(n, i) (
  n = strlen(nm);
  GB_FN[f * 3] = n; GB_FN[f * 3 + 1] = str_getchar(nm, 0); GB_FN[f * 3 + 2] = str_getchar(nm, n - 1);
  i = 0; loop(min(n, 16), GB_FNC[f * 16 + i] = str_getchar(nm, i); i += 1; );
);
gb_fn_set(0, "lokey"); gb_fn_set(1, "hikey"); gb_fn_set(2, "pitch_keycenter"); gb_fn_set(3, "pitch_keytrack");
gb_fn_set(4, "lovel"); gb_fn_set(5, "hivel"); gb_fn_set(6, "tune"); gb_fn_set(7, "transpose"); gb_fn_set(8, "volume");
gb_fn_set(9, "pan"); gb_fn_set(10, "amp_veltrack"); gb_fn_set(11, "amp_random"); gb_fn_set(12, "ampeg_delay");
gb_fn_set(13, "ampeg_attack"); gb_fn_set(14, "ampeg_hold"); gb_fn_set(15, "ampeg_decay"); gb_fn_set(16, "ampeg_sustain");
gb_fn_set(17, "ampeg_release"); gb_fn_set(18, "loop_mode"); gb_fn_set(19, "loop_start"); gb_fn_set(20, "loop_end");
gb_fn_set(21, "offset"); gb_fn_set(22, "offset_random"); gb_fn_set(23, "end"); gb_fn_set(24, "trigger");
gb_fn_set(25, "rt_decay"); gb_fn_set(26, "seq_length"); gb_fn_set(27, "seq_position"); gb_fn_set(28, "lorand");
gb_fn_set(29, "hirand"); gb_fn_set(30, "group"); gb_fn_set(31, "off_by"); gb_fn_set(32, "off_mode");
gb_fn_set(33, "off_time"); gb_fn_set(34, "polyphony"); gb_fn_set(35, "note_polyphony"); gb_fn_set(36, "locc64");
gb_fn_set(37, "hicc64"); gb_fn_set(38, "sw_last"); gb_fn_set(39, "sw_lokey"); gb_fn_set(40, "sw_hikey");
gb_fn_set(41, "sw_default");

// defaults per field (the converter writes every field, but a hand-made file may leave some out)
function gb_region_defaults(r) (
  memset(r, 0, GB_RS);
  r[GBR_HIKEY] = 127; r[GBR_KEYC] = 60; r[GBR_KTRACK] = 100; r[GBR_LOVEL] = 1; r[GBR_HIVEL] = 127;
  r[GBR_VTRACK] = 100; r[GBR_SUS] = 100; r[GBR_REL] = 0.001; r[GBR_END] = -2; r[GBR_SEQLEN] = 1; r[GBR_SEQPOS] = 1;
  r[GBR_HIRAND] = 1; r[GBR_OFFTIME] = 0.006; r[GBR_HICC64] = 127;
  r[GBR_SWLAST] = -1; r[GBR_SWLO] = -1; r[GBR_SWHI] = -1; r[GBR_SWDEF] = -1;
);

// a decimal number in #gb_ln from character a up to (not including) b: [-]digits[.digits]; nan-safe default
function gb_num(a, b, dflt) local(i, c, neg, v, frac, sc, any) (
  i = a; neg = 0; v = 0; frac = 0; sc = 0.1; any = 0;
  i < b && str_getchar(#gb_ln, i) == '-' ? ( neg = 1; i += 1; );
  i < b && str_getchar(#gb_ln, i) == '+' ? i += 1;
  while (i < b) (
    c = str_getchar(#gb_ln, i);
    c >= '0' && c <= '9' ? (
      any = 1;
      frac ? ( v += (c - '0') * sc; sc *= 0.1; ) : v = v * 10 + (c - '0');
    ) : c == '.' ? frac = 1 : ( any = -1; i = b; );   // a stray character: the whole value is bad
    i += 1;
  );
  any == 1 ? ( neg ? -v : v ) : ( gb_bad_values += 1; dflt );
);

// is the name at [a, a+n) field f? Length, first and last character first (most names differ there), then every
// character (outside audit, 2026-11-05: sw_lokey and sw_hikey share all three, so a hand-made file could swap them)
function gb_name_is(f, a, n) local(ok, i) (
  ok = GB_FN[f * 3] == n && GB_FN[f * 3 + 1] == str_getchar(#gb_ln, a) && GB_FN[f * 3 + 2] == str_getchar(#gb_ln, a + n - 1);
  i = 1; while (ok && i < n - 1) ( ok = GB_FNC[f * 16 + i] == str_getchar(#gb_ln, a + i); i += 1; );
  ok;
);

// a word value -> its code (first letters are enough for the converter's lowercase words)
function gb_word(f, a, b) local(c0, n) (
  c0 = str_getchar(#gb_ln, a); n = b - a;
  f == 18 ? (            // loop_mode: no_loop one_shot loop_continuous loop_sustain
    c0 == 'n' ? GB_LM_NOLOOP : c0 == 'o' ? GB_LM_ONESHOT : str_getchar(#gb_ln, a + 5) == 's' ? GB_LM_SUST : GB_LM_CONT;
  ) : f == 24 ? (        // trigger: attack release release_key first legato
    c0 == 'r' ? ( n > 7 ? GB_TR_RELKEY : GB_TR_RELEASE ) : c0 == 'f' ? GB_TR_FIRST : c0 == 'l' ? GB_TR_LEGATO : GB_TR_ATTACK;
  ) : (                  // off_mode: fast normal time
    c0 == 'n' ? GB_OM_NORMAL : c0 == 't' ? GB_OM_TIME : GB_OM_FAST;
  );
);

// find or add the sample file whose path is #gb_ln[a, b); returns its index, or -1 when the tables are full
function gb_sample_index(a, b) local(n, h, i, k, s, j, same, p) (
  n = b - a; h = n;
  i = a; loop(n, h = (h * 31 + str_getchar(#gb_ln, i)) % 1000003; i += 1; );
  k = -1; s = 0;
  while (k < 0 && s < gb_nsmp) (
    p = GB_SMP + s * GB_SS;
    p[GBS_HASH] == h && p[GBS_PLEN] == n ? (
      same = 1; j = 0;
      while (same && j < n) ( GB_PCH[p[GBS_PATH] + j] != str_getchar(#gb_ln, a + j) ? same = 0; j += 1; );
      same ? k = s;
    );
    s += 1;
  );
  k < 0 && gb_nsmp < GB_MAXSMP && gb_pch_top + n <= GB_PCH_CAP ? (
    k = gb_nsmp; p = GB_SMP + k * GB_SS;
    memset(p, 0, GB_SS);
    p[GBS_PATH] = gb_pch_top; p[GBS_PLEN] = n; p[GBS_HASH] = h; p[GBS_STAT] = GB_SS_NEW;
    j = 0; loop(n, GB_PCH[gb_pch_top + j] = str_getchar(#gb_ln, a + j); j += 1; );
    gb_pch_top += n; gb_nsmp += 1;
  );
  k;
);

// format 2: up to four comma-separated numbers in [a, b) -> out[0..3] (a missing one stays 0)
function gb_csv4(a, b, out) local(k, p, q) (
  out[0] = out[1] = out[2] = out[3] = 0;
  k = 0; p = a;
  while (k < 4 && p < b) (
    q = p; while (q < b && str_getchar(#gb_ln, q) != ',') ( q += 1; );
    out[k] = gb_num(p, q, 0); k += 1; p = q + 1;
  );
);

// up to n comma-separated numbers in [a, b) -> GB_CSVN[0..n-1] (a missing one stays dflt); returns how many were given
GB_CSVN = 1698900;                   // 16 cells (after the face's GBF_PGMAP, under GB_FN)
function gb_csv_n(a, b, n, dflt) local(k, p, q) (
  k = 0; loop(n, GB_CSVN[k] = dflt; k += 1; );
  k = 0; p = a;
  while (k < n && p < b) (
    q = p; while (q < b && str_getchar(#gb_ln, q) != ',') ( q += 1; );
    GB_CSVN[k] = gb_num(p, q, dflt); k += 1; p = q + 1;
  );
  k;
);
// fil=TYPE,CUTOFF,RES,KEYTRACK,KEYCENTER,VELTRACK,RANDOM,CC,CCDEPTH  feg=DELAY,ATTACK,HOLD,DECAY,SUSTAIN%,RELEASE,DEPTH,
// VEL2DEPTH[,VEL2ATTACK,VEL2DECAY,VEL2RELEASE]  lfo=SLOT,WAVE,FREQ,DEPTH,DELAY,FADE,CC1DEPTH  vel=POW,ATT,DEC,REL
// peg= as feg= (the pitch envelope, 2026-11-05; depths in cents)  keg=AHOLD,ADECAY,FHOLD,FDECAY (timecents a key)
// bend=UP,DOWN (cents; read in gb_parse_region beside prog=)
// -> region r (the converter writes them; see GBR_FTYPE). A keytrack below 0 is Gumbo's (sfizz clamps it): the
// SoundFont importer needs it. Attack / decay / release may go below 0 when a vel2 part adds to them (clamped at launch).
function gb_parse_shape(r, c, a, b) local(k, l) (
  c == 'i' ? (                         // fil
    gb_csv_n(a, b, 9, 0);
    // (cutoff, veltrack and the envelope depths beyond sfizz's ranges: the SoundFont importer writes the cutoff and
    // depth AT VELOCITY 0 plus a velocity slope, which can sit far outside them; the voice clamps the sum per note)
    r[GBR_FTYPE] = max(0, min(8, GB_CSVN[0] | 0)); r[GBR_FCUT] = max(0.001, GB_CSVN[1]);
    r[GBR_FRES] = max(-60, min(40, GB_CSVN[2])); r[GBR_FKT] = max(-1200, min(1200, GB_CSVN[3]));
    r[GBR_FKC] = max(0, min(127, GB_CSVN[4])); r[GBR_FVT] = max(-30000, min(30000, GB_CSVN[5]));
    r[GBR_FRND] = max(0, min(12000, GB_CSVN[6])); r[GBR_FCC] = GB_CSVN[7] >= 1 && GB_CSVN[7] <= 127 ? GB_CSVN[7] | 0 : -1;
    r[GBR_FCCD] = max(-12000, min(12000, GB_CSVN[8]));
    r[GBR_FTYPE] > 0 ? r[GBR_SHAPE] = 1;
  ) : c == 'e' ? (                     // feg
    gb_csv_n(a, b, 11, 0);
    r[GBR_EGDLY] = max(0, GB_CSVN[0]); r[GBR_EGATT] = max(-100, min(100, GB_CSVN[1])); r[GBR_EGHOLD] = max(0, GB_CSVN[2]);
    r[GBR_EGDEC] = max(-100, min(100, GB_CSVN[3])); r[GBR_EGSUS] = max(0, min(100, GB_CSVN[4])) / 100; r[GBR_EGREL] = max(-100, min(100, GB_CSVN[5]));
    r[GBR_EGD] = max(-30000, min(30000, GB_CSVN[6])); r[GBR_EGVD] = max(-30000, min(30000, GB_CSVN[7]));
    r[GBR_EGVA] = max(-100, min(100, GB_CSVN[8])); r[GBR_EGVDC] = max(-100, min(100, GB_CSVN[9])); r[GBR_EGVR] = max(-100, min(100, GB_CSVN[10]));
    r[GBR_EGD] != 0 || r[GBR_EGVD] != 0 ? r[GBR_SHAPE] = 1;
  ) : c == 'p' ? (                     // peg (2026-11-05): the pitch envelope, feg's eleven fields, the depths in cents
    gb_csv_n(a, b, 11, 0);
    r[GBR_PEGDLY] = max(0, GB_CSVN[0]); r[GBR_PEGATT] = max(-100, min(100, GB_CSVN[1])); r[GBR_PEGHOLD] = max(0, GB_CSVN[2]);
    r[GBR_PEGDEC] = max(-100, min(100, GB_CSVN[3])); r[GBR_PEGSUS] = max(0, min(100, GB_CSVN[4])) / 100; r[GBR_PEGREL] = max(-100, min(100, GB_CSVN[5]));
    r[GBR_PEGD] = max(-30000, min(30000, GB_CSVN[6])); r[GBR_PEGVD] = max(-30000, min(30000, GB_CSVN[7]));
    r[GBR_PEGVA] = max(-100, min(100, GB_CSVN[8])); r[GBR_PEGVDC] = max(-100, min(100, GB_CSVN[9])); r[GBR_PEGVR] = max(-100, min(100, GB_CSVN[10]));
    r[GBR_PEGD] != 0 || r[GBR_PEGVD] != 0 ? r[GBR_SHAPE] = 1;
  ) : c == 'k' ? (                     // keg (2026-11-05): key scaling of the hold and decay times, timecents a key
    gb_csv_n(a, b, 4, 0);
    r[GBR_KAH] = max(-1200, min(1200, GB_CSVN[0])); r[GBR_KAD] = max(-1200, min(1200, GB_CSVN[1]));
    r[GBR_KFH] = max(-1200, min(1200, GB_CSVN[2])); r[GBR_KFD] = max(-1200, min(1200, GB_CSVN[3]));
  ) : c == 'v' ? (                     // vel
    gb_csv_n(a, b, 4, 0);
    r[GBR_VPOW] = max(0, min(20, GB_CSVN[0]));
    r[GBR_VATT] = max(-100, min(100, GB_CSVN[1])); r[GBR_VDEC] = max(-100, min(100, GB_CSVN[2])); r[GBR_VREL] = max(-100, min(100, GB_CSVN[3]));
  ) : (                                // lfo
    gb_csv_n(a, b, 7, 0);
    k = GB_CSVN[0] | 0;
    k >= 0 && k <= 2 ? (
      l = r + GBR_LFO + k * GBR_LFOS;
      l[GBL_WAVE] = GB_CSVN[1] >= 1 ? 1 : 0; l[GBL_FREQ] = max(0, min(100, GB_CSVN[2]));
      l[GBL_DEPTH] = max(-12000, min(12000, GB_CSVN[3])); l[GBL_DELAY] = max(0, GB_CSVN[4]); l[GBL_FADE] = max(0, GB_CSVN[5]);
      l[GBL_CCD] = max(-12000, min(12000, GB_CSVN[6]));
      l[GBL_ON] = l[GBL_FREQ] > 0 && (l[GBL_DEPTH] != 0 || l[GBL_CCD] != 0);
      l[GBL_ON] ? r[GBR_SHAPE] = 1;
    );
  );
);

// one "<region> sample=..." line
function gb_parse_region(len) local(r, p, s0, s1, f, a, eq, b, n, c, v, g, cc, lo, hi, vn, vt, k, i, last, lastv, ff)
(
  gb_nreg < GB_MAXREG ? (
    r = GB_REG + gb_nreg * GB_RS;
    gb_region_defaults(r);
    // the sample value runs to " lokey=" (the converter writes lokey first, always)
    s0 = 16; p = s0; s1 = -1;
    while (s1 < 0 && p + 7 <= len) (
      str_getchar(#gb_ln, p) == ' ' && str_getchar(#gb_ln, p + 1) == 'l' && str_getchar(#gb_ln, p + 2) == 'o'
        && str_getchar(#gb_ln, p + 3) == 'k' && str_getchar(#gb_ln, p + 6) == '=' ? s1 = p;
      p += 1;
    );
    s1 < 0 ? ( gb_bad_lines += 1; ) : (
      // *silence keeps its region (it chokes), with no sample
      s1 - s0 == 8 && str_getchar(#gb_ln, s0) == '*' && str_getchar(#gb_ln, s0 + 1) == 's' ? r[GBR_SMP] = GB_SILENCE
      : ( k = gb_sample_index(s0, s1); r[GBR_SMP] = k; k < 0 ? gb_table_full = 1; );
      // the tokens: name=value separated by single spaces
      p = s1 + 1; f = 0; last = -1;
      while (p < len) (
        a = p; eq = -1;
        while (p < len && str_getchar(#gb_ln, p) != ' ') ( eq < 0 && str_getchar(#gb_ln, p) == '=' ? eq = p; p += 1; );
        b = p;               // [a, b) = one token
        p += 1;
        eq > a ? (
          n = eq - a;
          // fixed field? walk forward from the expected one (a left-out field is skipped)
          ff = f; while (ff < GB_NFIELDS && !gb_name_is(ff, a, n)) ( ff += 1; );
          ff < GB_NFIELDS ? (
            ff == 18 || ff == 24 || ff == 32 ? v = gb_word(ff, eq + 1, b) : v = gb_num(eq + 1, b, r[ff + 1]);
            r[ff + 1] = v; f = ff + 1;
          ) : (
            c = str_getchar(#gb_ln, a);
            c == 'a' && n > 13 ? (                 // amp_velcurve_N
              vn = gb_num(a + 13, eq, -1) | 0; vt = gb_num(eq + 1, b, -1);
              vn >= 0 && vn <= 127 && vt >= 0 ? (
                r[GBR_VCPTR] == 0 && gb_nvc < GB_VCT_MAX ? (
                  r[GBR_VCPTR] = GB_VCT + gb_nvc * 128; gb_nvc += 1;
                  memset(r[GBR_VCPTR], -1, 128);   // -1 = not given yet; filled in below
                );
                r[GBR_VCPTR] > 0 ? r[GBR_VCPTR][vn] = min(1, vt);
              );
            ) : (c == 'l' || c == 'h') && n > 4 && str_getchar(#gb_ln, a + 2) == 'c' ? (   // loccN / hiccN
              cc = gb_num(a + 4, eq, -1) | 0; v = gb_num(eq + 1, b, c == 'l' ? 0 : 127);
              cc >= 0 && cc <= 127 ? (
                g = 0; k = -1;
                while (k < 0 && g < r[GBR_GCNT]) ( r[GBR_GATES + g * 3] == cc ? k = g; g += 1; );
                k < 0 && r[GBR_GCNT] < GB_MAXGATES ? (
                  k = r[GBR_GCNT]; r[GBR_GCNT] += 1;
                  r[GBR_GATES + k * 3] = cc; r[GBR_GATES + k * 3 + 1] = 0; r[GBR_GATES + k * 3 + 2] = 127;
                );
                k >= 0 ? ( r[GBR_GATES + k * 3 + (c == 'l' ? 1 : 2)] = v; ) : gb_gates_dropped += 1;
              );
            ) : c == 'm' && n == 3 && str_getchar(#gb_ln, a + 1) == 'o' && str_getchar(#gb_ln, a + 2) == 'd' ? (   // mod=T,CC,A,B
              r[GBR_NMOD] < GB_MAXMOD ? (
                g = GB_MOD + gb_nreg * GB_MODS + r[GBR_NMOD] * 4;
                gb_csv4(eq + 1, b, g);
                g[1] = max(0, min(127, g[1] | 0));
                r[GBR_NMOD] += 1;
              ) : gb_mods_dropped += 1;
            ) : c == 'b' && n == 4 && str_getchar(#gb_ln, a + 1) == 'e' && str_getchar(#gb_ln, a + 3) == 'd' ? (   // bend=UP,DOWN (cents)
              gb_csv_n(eq + 1, b, 2, 0);
              r[GBR_BUP] = max(-12000, min(12000, GB_CSVN[0])); r[GBR_BDN] = max(-12000, min(12000, GB_CSVN[1]));
            ) : c == 'p' && n == 4 && str_getchar(#gb_ln, a + 3) == 'g' ? (   // prog=S,LO,HI (format 3)
              gb_csv4(eq + 1, b, GB_CSVT);
              r[GBR_PSEC] = max(0, GB_CSVT[0] | 0);
              r[GBR_PLO] = max(0, min(127, GB_CSVT[1] | 0)); r[GBR_PHI] = max(0, min(127, GB_CSVT[2] | 0));
            ) : n == 3 && ((c == 'f' && str_getchar(#gb_ln, a + 1) == 'i' && str_getchar(#gb_ln, a + 2) == 'l')
                        || (c == 'f' && str_getchar(#gb_ln, a + 1) == 'e' && str_getchar(#gb_ln, a + 2) == 'g')
                        || (c == 'l' && str_getchar(#gb_ln, a + 1) == 'f' && str_getchar(#gb_ln, a + 2) == 'o')
                        || (c == 'v' && str_getchar(#gb_ln, a + 1) == 'e' && str_getchar(#gb_ln, a + 2) == 'l')
                        || (c == 'p' && str_getchar(#gb_ln, a + 1) == 'e' && str_getchar(#gb_ln, a + 2) == 'g')
                        || (c == 'k' && str_getchar(#gb_ln, a + 1) == 'e' && str_getchar(#gb_ln, a + 2) == 'g')) ? (
              gb_parse_shape(r, c == 'l' || c == 'v' || c == 'p' || c == 'k' ? c : str_getchar(#gb_ln, a + 1), eq + 1, b);   // fil= feg= lfo= vel= peg= keg=
            ) : gb_unknown_tokens += 1;
          );
        );
      );
      // velocity curve: fill the gaps linearly (amp_velcurve_0 = 0 and _127 = 1 unless given)
      r[GBR_VCPTR] > 0 ? (
        vt = r[GBR_VCPTR];
        vt[0] < 0 ? vt[0] = 0;
        vt[127] < 0 ? vt[127] = 1;
        last = 0; lastv = vt[0]; i = 1;
        loop(127,
          vt[i] >= 0 ? (
            k = last + 1; loop(i - last - 1, vt[k] = lastv + (vt[i] - lastv) * (k - last) / (i - last); k += 1; );
            last = i; lastv = vt[i];
          );
          i += 1;
        );
      );
      r[GBR_SEQCNT] = 0;
      gb_nreg += 1;
    );
  ) : gb_table_full = 1;
);

// "<control> set_ccN=V ..." -> starting CC values (gb_cc_init[N])
function gb_parse_control(len) local(p, a, eq, b, cc) (
  p = 10;
  while (p < len) (
    a = p; eq = -1;
    while (p < len && str_getchar(#gb_ln, p) != ' ') ( eq < 0 && str_getchar(#gb_ln, p) == '=' ? eq = p; p += 1; );
    b = p; p += 1;
    eq > a + 6 && str_getchar(#gb_ln, a) == 's' && str_getchar(#gb_ln, a + 4) == 'c' ? (
      cc = gb_num(a + 6, eq, -1) | 0;
      cc >= 0 && cc <= 127 ? gb_cc_init[cc] = max(0, min(127, gb_num(eq + 1, b, 0)));
    );
  );
);

// format 2: a name line "// label_cc N text" / "// sw_label N text" (p = where N starts) -> its table
function gb_parse_name(p, len, tbl, cnt, mx) local(q, n, i) (
  q = p; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
  n = gb_num(p, q, -1) | 0;
  q += 1;
  cnt < mx && n >= 0 && n <= 127 && q < len && gb_lch_top + (len - q) <= GB_LCH_CAP ? (
    tbl[cnt * 3] = n; tbl[cnt * 3 + 1] = gb_lch_top; tbl[cnt * 3 + 2] = min(len - q, 40);
    i = 0; loop(tbl[cnt * 3 + 2], GB_LCH[gb_lch_top + i] = str_getchar(#gb_ln, q + i); i += 1; );
    gb_lch_top += tbl[cnt * 3 + 2];
    cnt + 1;
  ) : cnt;
);
// format 2: "// label_key NOTE name" -> that key's name (GB_KLB, by note; the first name a key gets stays)
function gb_parse_key_name(len) local(p, q, n, i, k) (
  p = 13; q = p; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
  n = gb_num(p, q, -1) | 0;
  q += 1; k = min(len - q, 24);
  n >= 0 && n <= 127 && k > 0 && GB_KLB[n * 2 + 1] == 0 && gb_lch_top + k <= GB_LCH_CAP ? (
    GB_KLB[n * 2] = gb_lch_top; GB_KLB[n * 2 + 1] = k;
    i = 0; loop(k, GB_LCH[gb_lch_top + i] = str_getchar(#gb_ln, q + i); i += 1; );
    gb_lch_top += k; gb_nkey += 1;
  );
);
// a bank's kit's own key names: "// key_name S P NOTE name" -> a GB_KN entry (the name cut to 24 characters)
function gb_parse_key_entry(len) local(p, q, e, k, i) (
  gb_nkn < GB_KN_MAX ? (
    e = GB_KN + gb_nkn * 5; p = 12; k = 0;
    while (k < 3 && p < len) (
      q = p; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
      e[k] = gb_num(p, q, -1) | 0; k += 1; p = q + 1;
    );
    k = max(0, min(min(len - p, 24), GB_LCH_CAP - gb_lch_top));
    e[0] > 0 && e[1] >= 0 && e[1] <= 127 && e[2] >= 0 && e[2] <= 127 && k > 0 ? (
      e[3] = gb_lch_top; e[4] = k;
      i = 0; loop(k, GB_LCH[gb_lch_top + i] = str_getchar(#gb_ln, p + i); i += 1; );
      gb_lch_top += k; gb_nkn += 1;
    );
  );
);
// format 3: "// program S LO HI name" -> GB_PRG (the face's program list; the name cut to 64 characters, and to what
// GB_LCH has left, so a long bank's last names come short rather than missing)
function gb_parse_program(len) local(p, q, e, k, i) (
  gb_nprg < GB_PRG_MAX ? (
    e = GB_PRG + gb_nprg * 5; p = 11; k = 0;
    while (k < 3 && p < len) (
      q = p; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
      e[k] = gb_num(p, q, 0) | 0; k += 1; p = q + 1;
    );
    k = max(0, min(min(len - p, 64), GB_LCH_CAP - gb_lch_top));
    k > 0 ? (
      e[3] = gb_lch_top; e[4] = k;
      i = 0; loop(k, GB_LCH[gb_lch_top + i] = str_getchar(#gb_ln, p + i); i += 1; );
      gb_lch_top += k;
    ) : ( e[3] = 0; e[4] = 0; );
    e[1] = max(0, min(127, e[1])); e[2] = max(e[1], min(127, e[2]));
    gb_nprg += 1;
    // the melodic section: the first program not in the drum section ("// drums" comes before the programs)
    gb_mel_sec == 0 && e[0] != gb_drum_sec ? gb_mel_sec = e[0];
  );
);
// variation banks: "// bank S N" -> MIDI bank N (0..255: the drum channel's are 128 + CC0) picks section S
function gb_parse_bank(len) local(p, q, s, b) (
  p = 8; q = p; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
  s = gb_num(p, q, 0) | 0; b = gb_num(q + 1, len, -1) | 0;
  s > 0 && b >= 0 && b < 256 ? (
    GB_BNK[b] = s;
    s < GB_SECB_N && GB_SECB[s] < 0 ? GB_SECB[s] = b;
  );
);
// program entry i's name into #gb_ls; returns its length
function gb_prog_name(i) local(e, p, k) (
  #gb_ls = "";
  i >= 0 && i < gb_nprg ? (
    e = GB_PRG + i * 5; p = GB_LCH + e[3];
    k = 0; loop(e[4], sprintf(#gb_lsc, "%c", p[k]); strcat(#gb_ls, #gb_lsc); k += 1; );
  );
  strlen(#gb_ls);
);
// format 2: "// curve I v0 .. v127" -> a custom curve slot for live controllers
function gb_parse_curve(len) local(p, q, idx, k, t) (
  p = 9; q = p; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
  idx = gb_num(p, q, -1) | 0;
  idx >= 0 && idx <= 255 && gb_nccv < GB_CCV_MAX ? (
    t = GB_CCV + gb_nccv * 128; k = 0; p = q + 1;
    while (k < 128 && p < len) (
      q = p; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
      t[k] = gb_num(p, q, 0); k += 1; p = q + 1;
    );
    while (k < 128) ( t[k] = t[max(0, k - 1)]; k += 1; );
    gb_nccv += 1; GB_CCVMAP[idx] = gb_nccv;
  );
);
// format 2, for the face: the library's controller names and keyswitch names (-> #gb_ls)
function gb_name_str(tbl, i) local(p, k) (
  #gb_ls = ""; p = GB_LCH + tbl[i * 3 + 1];
  k = 0; loop(tbl[i * 3 + 2], sprintf(#gb_lsc, "%c", p[k]); strcat(#gb_ls, #gb_lsc); k += 1; );
  #gb_ls;
);
// a key's name into #gb_ls (empty when it has none); returns its length
function gb_key_name(n) local(p, k) (
  #gb_ls = "";
  n >= 0 && n <= 127 && GB_KLB[n * 2 + 1] > 0 ? (
    p = GB_LCH + GB_KLB[n * 2];
    k = 0; loop(GB_KLB[n * 2 + 1], sprintf(#gb_lsc, "%c", p[k]); strcat(#gb_ls, #gb_lsc); k += 1; );
  );
  strlen(#gb_ls);
);

// the converter's "// regions N of M; sample files K; RAM when loaded X MB" -> gb_hdr_mb = X (the unpacked size: 8
// bytes a sample point; gb_load packs an instrument that would not fit, 2026-11-04)
function gb_parse_ram(len) local(i, at, q) (
  i = 11; at = -1;
  while (at < 0 && i + 7 < len) (
    str_getchar(#gb_ln, i) == 'l' && str_getchar(#gb_ln, i + 1) == 'o' && str_getchar(#gb_ln, i + 2) == 'a'
      && str_getchar(#gb_ln, i + 3) == 'd' && str_getchar(#gb_ln, i + 4) == 'e' && str_getchar(#gb_ln, i + 5) == 'd'
      && str_getchar(#gb_ln, i + 6) == ' ' ? at = i + 7;
    i += 1;
  );
  at >= 0 ? (
    q = at; while (q < len && str_getchar(#gb_ln, q) != ' ') ( q += 1; );
    gb_hdr_mb = max(0, gb_num(at, q, 0));
  );
);

// one line of the file (already in #gb_ln)
function gb_parse_line() local(len) (
  len = strlen(#gb_ln);
  // file_string keeps the line's own line break: strip LF and CR (a file edited by hand on Windows has both)
  len > 0 && str_getchar(#gb_ln, len - 1) == 10 ? len -= 1;
  len > 0 && str_getchar(#gb_ln, len - 1) == 13 ? len -= 1;
  len >= 16 && strncmp(#gb_ln, "<region> sample=", 16) == 0 ? gb_parse_region(len)
  : len >= 9 && strncmp(#gb_ln, "<control>", 9) == 0 ? gb_parse_control(len)
  : len >= 14 && strncmp(#gb_ln, "// gumbo-flat ", 14) == 0 ? gb_fmt_ver = gb_num(14, len, 0)
  : len >= 13 && strncmp(#gb_ln, "// label_cc ", 12) == 0 ? gb_nlbl = gb_parse_name(12, len, GB_LBL, gb_nlbl, GB_LBL_MAX)
  : len >= 13 && strncmp(#gb_ln, "// sw_label ", 12) == 0 ? gb_nswl = gb_parse_name(12, len, GB_SWL, gb_nswl, GB_SWL_MAX)
  : len >= 14 && strncmp(#gb_ln, "// label_key ", 13) == 0 ? gb_parse_key_name(len)
  : len >= 19 && strncmp(#gb_ln, "// key_name ", 12) == 0 ? gb_parse_key_entry(len)
  : len >= 10 && strncmp(#gb_ln, "// curve ", 9) == 0 ? gb_parse_curve(len)
  : len >= 10 && strncmp(#gb_ln, "// drums ", 9) == 0 ? gb_drum_sec = max(0, gb_num(9, len, 0) | 0)
  : len >= 13 && strncmp(#gb_ln, "// program ", 11) == 0 ? gb_parse_program(len)
  : len >= 11 && strncmp(#gb_ln, "// bank ", 8) == 0 ? gb_parse_bank(len)
  : len >= 20 && strncmp(#gb_ln, "// regions ", 11) == 0 ? gb_parse_ram(len);
);

// clear everything a new load fills
function gb_tables_reset() local(i) (
  gb_nreg = 0; gb_nsmp = 0; gb_pch_top = 0; gb_nvc = 0; gb_fmt_ver = 0;
  gb_bad_values = 0; gb_bad_lines = 0; gb_unknown_tokens = 0; gb_gates_dropped = 0; gb_table_full = 0;
  gb_mods_dropped = 0; gb_nccv = 0; gb_nlbl = 0; gb_nswl = 0; gb_lch_top = 0; gb_nkey = 0; gb_nkn = 0;
  gb_nprg = 0; gb_drum_sec = 0; gb_mel_sec = 0; gb_hdr_mb = 0;
  gb_pix_ok = 0;                     // no speed index until the parse has finished (gb_prog_index)
  memset(GB_BNK, 0, 256); memset(GB_SECB, -1, GB_SECB_N);
  memset(GB_CCVMAP, 0, 256); memset(GB_KLB, 0, 256);
  i = 0; loop(128, gb_cc_init[i] = 0; i += 1; );
);

// the speed index (2026-11-05): each (section, program)'s first and last region, and section 0's (plays always), so a
// note searches only those spans (gb_voice gb_span) instead of every region -- the General MIDI bank's 11,004 cost
// ~1.9 ms a note offline. Built once when the parse ends (the loader's thread, gb_ready = 0). The spans may hold other
// programs' regions (an SFZ bank need not be in program order): the voice side still tests every region it reads. A
// section number past GB_PIX_SECS turns the index off: every note searches every region, as before.
GB_PIX = 1640000; GB_PIX_SECS = 64;                       // 64 x 128 x 2 -> 1656384 (free: 1634216 .. 1686000)
function gb_prog_index() local(i, r, s, p, e) (
  memset(GB_PIX, -1, GB_PIX_SECS * 256);
  gb_pix0a = -1; gb_pix0b = -1; gb_pix_ok = 1;
  i = 0;
  loop(gb_nreg,
    r = GB_REG + i * GB_RS; s = r[GBR_PSEC];
    s == 0 ? (
      gb_pix0a < 0 ? gb_pix0a = i;
      gb_pix0b = i;
    ) : s >= GB_PIX_SECS ? (
      gb_pix_ok = 0;
    ) : (
      p = r[GBR_PLO];
      while (p <= r[GBR_PHI]) (
        e = GB_PIX + (s * 128 + p) * 2;
        e[0] < 0 ? e[0] = i;
        e[1] = i;
        p += 1;
      );
    );
    i += 1;
  );
);
