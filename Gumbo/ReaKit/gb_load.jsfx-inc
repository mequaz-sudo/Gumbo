// gb_load.jsfx-inc -- Gumbo: load one instrument (a ".gumbo.txt" + its WAV/FLAC samples) as a resumable job.
//
// gb_job_start(path) then gb_job_step(cells, lines) until it returns 1. Two callers:
//   * @gfx (a dropped file): small budgets per frame, so the window stays responsive. A file read can stall for a
//     moment (a cold file: 240-470 ms once, Research §0c), so loads never run in @block.
//   * @serialize (a project opening): huge budgets, one call, so the instrument is in memory before any play or
//     render (measured: a 2.6M-cell sample loads inside @serialize, Research R7).
// Each piece of work is bounded under EEL2's 2^20 loop cap (wiki §1.7): lines per step, cells per file_mem call.
// Audio memory: every sample file once, interleaved as it is on disk (mono stays mono), from GB_AUD up to GB_AUD_END.
// PACKED (2026-11-04, the owner wanted the Meta Piano, 2.25 GB unpacked, to play): when the file's header says the
// instrument will not fit at one cell a sample point (gb_hdr_mb), every point is stored as 16 bits and three share a
// cell (a cell is a 64-bit float: 48 bits of integers are exact), so ~3x the sound fits. Points go in in the same
// interleaved order; point k sits in cell k/3, lane k%3: cell = u0 + u1 * 2^16 + u2 * 2^32, u = point * 32768 + 32768.
// A 16-bit file packs exactly (its points are whole numbers of 1/32768); a deeper one is rounded to 16 bits with
// TPDF dither. Only an instrument that would not fit is packed, so every other one loads and plays as before.
// Readers: gb_render (gb_voice: each voice keeps 8 cells unpacked, gb_pk_cells; gb_pk at a loop's wrap or a sample's
// ends) and the face's waveform (gb_pk) when gb_pack is 1.
// While a job runs gb_ready is 0 and the audio side plays nothing; gb_ready = 1 is written last.
// Threads: @gfx and @serialize are separate sections with separate function locals (wiki §1.14), but they share
// these globals; the host never runs both at once on purpose (a @serialize load first stops a @gfx job).

@init
GB_AUD = 7770000;                    // above the region table and its mods (gb_sfz: GB_REG .. 7768576; was 6250000 before 2026-11-05, 7250000 before 2026-11-06's region EQ)
GB_AUD_END = 133000000;              // under maxmem = 134217728, proven backed (Research R3); 133 M since 2026-11-06:
                                     // SPACE's reverb lines take the top (gb_space GSP_BASE .. GSP_END), about 8 MB
GB_CHUNK = 524288;                   // cells per file_mem call (half the loop cap; file_mem itself has no cap)
GB_PK_SCR = GB_AUD_END - GB_CHUNK;   // packed loads: each piece is read here as floats, then packed below it
gb_pack = 0;                         // 1 = the loaded instrument is packed (set before gb_ready, per load)
GB_J_IDLE = 0; GB_J_PARSE = 1; GB_J_SAMPLES = 2; GB_J_DONE = 3; GB_J_FAILED = -1;
GB_E_NONE = 0; GB_E_OPEN = 1; GB_E_NOTTEXT = 2; GB_E_FORMAT = 3; GB_E_EMPTY = 4;
gb_job = GB_J_IDLE;
gb_load_lock = 0;                    // one loader driver at a time (gb_lock_try / gb_lock_wait / gb_unlock)
gb_ser_pend = 0; gb_ser_late = 0;    // @serialize's instrument handed to @gfx (#gb_ser_pth), and that load running

// the folder part of #gb_jpath (with its trailing slash) -> #gb_dir
function gb_dirname() local(n, i, cut, c) (
  n = strlen(#gb_jpath); cut = -1; i = 0;
  loop(n, c = str_getchar(#gb_jpath, i); (c == '/' || c == 92) ? cut = i; i += 1; );
  cut >= 0 ? strncpy(#gb_dir, #gb_jpath, cut + 1) : strcpy(#gb_dir, "");
);

// the full path of sample k -> #gb_sp (absolute paths as they are, relative ones under #gb_dir)
function gb_sample_path(k) local(p, n, i, c0, c1, abs_) (
  p = GB_SMP + k * GB_SS; n = p[GBS_PLEN];
  c0 = GB_PCH[p[GBS_PATH]]; c1 = n > 1 ? GB_PCH[p[GBS_PATH] + 1] : 0;
  abs_ = c1 == ':' || c0 == '/' || c0 == 92;
  abs_ ? strcpy(#gb_sp, "") : strcpy(#gb_sp, #gb_dir);
  i = 0; loop(n, sprintf(#gb_ch, "%c", GB_PCH[p[GBS_PATH] + i]); strcat(#gb_sp, #gb_ch); i += 1; );
);

// ── packing (see the header) ──
// n points at src (floats -1..1) -> ceil(n / 3) cells at dst; a last short cell's empty lanes hold silence (32768).
// gb_jex = the open file is exact 16-bit so far: each piece is checked first (a deeper file shows a fraction within
// its first sounding points, so the check stops early); exact points are rounded only, deeper ones get dither (one
// rand a point, differenced: high-passed triangular). The loops are written out flat: the load of a 2 GB instrument
// spends nearly all its time here (measured 2026-11-04: Meta Piano, 3.5 s of reading against ~30 s of packing with
// a function call a point).
function gb_pk_put(dst, src, n) local(i, m, y, r, a, b, c) (
  i = 0;
  while (gb_jex && i < n) ( y = src[i] * 32768; y - floor(y) > 0.0001 ? gb_jex = 0; i += 1; );
  m = floor(n / 3); i = 0;
  gb_jex ? (
    loop(m,
      a = max(0, min(65535, floor(src[0] * 32768 + 32768.5)));
      b = max(0, min(65535, floor(src[1] * 32768 + 32768.5)));
      c = max(0, min(65535, floor(src[2] * 32768 + 32768.5)));
      dst[i] = a + b * 65536 + c * 4294967296; src += 3; i += 1;
    );
  ) : (
    loop(m,
      r = rand(1); a = max(0, min(65535, floor(src[0] * 32768 + r - gb_jrp + 32768.5))); gb_jrp = r;
      r = rand(1); b = max(0, min(65535, floor(src[1] * 32768 + r - gb_jrp + 32768.5))); gb_jrp = r;
      r = rand(1); c = max(0, min(65535, floor(src[2] * 32768 + r - gb_jrp + 32768.5))); gb_jrp = r;
      dst[i] = a + b * 65536 + c * 4294967296; src += 3; i += 1;
    );
  );
  n > 3 * m ? (                       // the file's last, short cell
    a = max(0, min(65535, floor(src[0] * 32768 + 32768.5)));
    b = n > 3 * m + 1 ? max(0, min(65535, floor(src[1] * 32768 + 32768.5))) : 32768;
    dst[i] = a + b * 65536 + 32768 * 4294967296;
  );
);
// point k of a packed sample at p, as -1..1 (cell k / 3, lane k % 3; all arithmetic exact under 2^53)
function gb_pk(p, k) local(q, l, s, h, g) (
  q = floor((k + 0.5) / 3); l = k - 3 * q;
  s = p[q]; h = floor(s * 0.0000152587890625);         // s / 2^16 = u1 + u2 * 2^16
  l < 0.5 ? (s - h * 65536 - 32768) * 0.000030517578125
  : ( g = floor(h * 0.0000152587890625);              // u2
      l < 1.5 ? (h - g * 65536 - 32768) * 0.000030517578125 : (g - 32768) * 0.000030517578125; );
);

// n cells of a packed sample from cell p on, unpacked into t (3 points a cell, in order): the voices' cache (gb_voice)
function gb_pk_cells(t, p, n) local(s, h, g) (
  loop(n,
    s = p[0]; h = floor(s * 0.0000152587890625); g = floor(h * 0.0000152587890625);
    t[0] = (s - h * 65536 - 32768) * 0.000030517578125;
    t[1] = (h - g * 65536 - 32768) * 0.000030517578125;
    t[2] = (g - 32768) * 0.000030517578125;
    t += 3; p += 1;
  );
);

function gb_job_start(path) (
  gb_job > GB_J_IDLE && gb_jh_open ? ( file_close(gb_jh); gb_jh_open = 0; );
  gb_ready = 0; gb_pack = 0;
  gb_ser_late = 0;                   // (a load @serialize handed over is replaced by this one: Gumbo_ReaKit.jsfx)
  gb_load_gen += 1;                  // the audio side adopts each load once (gb_voices_block)
  strcpy(#gb_jpath, path);
  gb_dirname();
  gb_tables_reset();
  gb_aud_top = GB_AUD; gb_js = 0; gb_jpos = 0; gb_err = GB_E_NONE;
  gb_smp_missing = 0; gb_smp_badfmt = 0; gb_smp_noroom = 0; gb_loaded_cells = 0;
  gb_jh = file_open(#gb_jpath);
  gb_jh < 0 ? ( gb_err = GB_E_OPEN; gb_job = GB_J_FAILED; ) : (
    gb_jh_open = 1;
    file_text(gb_jh) ? gb_job = GB_J_PARSE : (
      file_close(gb_jh); gb_jh_open = 0; gb_err = GB_E_NOTTEXT; gb_job = GB_J_FAILED;
    );
  );
);

// one budgeted piece of work; returns 1 when the job has finished (done or failed)
function gb_job_step(cells, lines) local(k, p, nch, sr, items, n, left) (
  gb_job == GB_J_PARSE ? (
    k = 0;
    // file_avail first: in text mode it is 1 until the end, and a read past the end repeats the last line
    while (k < lines && gb_job == GB_J_PARSE) (
      file_avail(gb_jh) > 0 ? ( file_string(gb_jh, #gb_ln); gb_parse_line(); k += 1; ) : (
        file_close(gb_jh); gb_jh_open = 0;
        gb_nreg == 0 ? ( gb_err = GB_E_EMPTY; gb_job = GB_J_FAILED; )
        : gb_fmt_ver != 1 && gb_fmt_ver != 2 && gb_fmt_ver != 3 ? ( gb_err = GB_E_FORMAT; gb_job = GB_J_FAILED; )   // 2 = live controllers, 3 = a bank
        : ( gb_js = 0; gb_jpos = 0; gb_job = GB_J_SAMPLES;
            gb_prog_index();             // each program's regions, so a note searches only those (gb_sfz)
            // too big for one cell a point (the header's MB = cells x 8 / 2^20, rounded to 0.1: a 1 % margin): pack it
            gb_pack = gb_hdr_mb * 131072 > (GB_AUD_END - GB_AUD) * 0.99 ? 1 : 0; );
      );
    );
  ) : gb_job == GB_J_SAMPLES ? (
    // packing costs about 5x the read (measured: Meta Piano 3.5 s read, ~16 s packed), so a packed load takes a
    // quarter of the budget: @gfx's step (1,048,576) then stays near the plain one's time instead of stalling the
    // window ~70 ms a frame; @serialize loops to the end either way
    left = gb_pack ? cells * 0.25 : cells;
    while (left > 0 && gb_job == GB_J_SAMPLES) (
      gb_js >= gb_nsmp ? ( gb_job = GB_J_DONE; gb_ready = 1; ) : (
        p = GB_SMP + gb_js * GB_SS;
        !gb_jh_open ? (
          // open the next sample
          gb_sample_path(gb_js);
          gb_jh = file_open(#gb_sp);
          gb_jh < 0 ? ( p[GBS_STAT] = GB_SS_MISSING; gb_smp_missing += 1; gb_js += 1; ) : (
            nch = 0; sr = 0; file_riff(gb_jh, nch, sr);
            items = file_avail(gb_jh);
            nch < 1 || nch > 2 || items <= 0 ? (
              file_close(gb_jh); p[GBS_STAT] = GB_SS_FORMAT; gb_smp_badfmt += 1; gb_js += 1;
            ) : (gb_pack ? gb_aud_top + ceil(items / 3) > GB_PK_SCR : gb_aud_top + items > GB_AUD_END) ? (
              file_close(gb_jh); p[GBS_STAT] = GB_SS_NOROOM; gb_smp_noroom += 1; gb_js += 1;
            ) : (
              gb_jh_open = 1; gb_jpos = 0; gb_jex = 1; gb_jrp = 0;
              p[GBS_PTR] = gb_aud_top; p[GBS_NCH] = nch; p[GBS_SR] = sr > 0 ? sr : srate;
              p[GBS_FRAMES] = (items / nch) | 0;
              gb_jitems = p[GBS_FRAMES] * nch;
            );
          );
        ) : (
          // read the next piece of the open sample (packed: whole cells of 3 points, but for the file's last piece)
          n = min(min(GB_CHUNK, left), gb_jitems - gb_jpos);
          gb_pack && gb_jpos + n < gb_jitems ? n -= n % 3;
          n > 0 ? (
            gb_pack ? ( file_mem(gb_jh, GB_PK_SCR, n); gb_pk_put(p[GBS_PTR] + gb_jpos / 3, GB_PK_SCR, n); )
                    : file_mem(gb_jh, p[GBS_PTR] + gb_jpos, n);
            gb_jpos += n; left -= n;
          ) : left = 0;                 // (a budget under 3 points: the rest next step)
          gb_jpos >= gb_jitems ? (
            file_close(gb_jh); gb_jh_open = 0;
            n = gb_pack ? ceil(gb_jitems / 3) : gb_jitems;
            p[GBS_STAT] = GB_SS_OK; gb_aud_top += n; gb_loaded_cells += n; gb_js += 1;
          );
        );
      );
    );
  );
  gb_job == GB_J_DONE || gb_job == GB_J_FAILED;
);

// stop a running job (a @serialize load takes over); leaves the instrument not ready
function gb_job_abort() (
  gb_jh_open ? ( file_close(gb_jh); gb_jh_open = 0; );
  gb_job = GB_J_IDLE; gb_ready = 0;
);

// no instrument at all: an empty saved state (undo back to an empty Gumbo, a preset without one) must silence and
// forget the loaded one, not keep it playing under an empty name
function gb_unload() (
  gb_job_abort();
  gb_tables_reset();
  gb_js = 0; gb_err = GB_E_NONE; gb_loaded_cells = 0; gb_smp_missing = 0; gb_smp_badfmt = 0; gb_smp_noroom = 0;
);

// The loader is driven from two threads: @gfx (a drop, the browser, the steps) and @serialize (a project, an undo, a
// preset), which run concurrently (wiki 4.1). One at a time: @gfx only tries (and comes back next pass), @serialize
// waits for @gfx's current piece (one step, a few ms) and never longer than about a second. atomic_setifequal returns
// the OLD value (wiki 4.1). gb_lock_wait returns 1 = taken, 0 = still held after the wait: the caller then leaves the
// loader alone (outside audit, 2026-11-05: it used to take the lock anyway, and the first owner's gb_unlock then
// opened it under the second; @serialize hands its instrument to @gfx instead, gb_ser_pend).
function gb_lock_try() ( atomic_setifequal(gb_load_lock, 0, 1) == 0; );
function gb_lock_wait() local(g, h) (
  g = 0;
  // (the count is tested FIRST: a last try that took the lock must not then report it as not taken)
  while (g < 2000 && atomic_setifequal(gb_load_lock, 0, 1) != 0) ( h = 0; loop(100000, h += 1; ); g += 1; );
  g < 2000;
);
function gb_unlock() ( atomic_set(gb_load_lock, 0); );
